{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/eval-attempt/v1",
  "title": "One line of an experiment's append-only attempt ledger (evaluation component design v0.2, sections 3 and 9)",
  "description": "`registered` is written and synced before the first provider action; `finalized` follows once, naming the immutable result's hash. A registered attempt with no finalized line is visible as runner_lost.",
  "type": "object",
  "required": ["schema", "event", "experiment", "preregistration_sha256", "run_id", "at"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "aew/eval-attempt/v1"},
    "event": {"enum": ["registered", "finalized"]},
    "experiment": {"type": "string"},
    "preregistration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string"},
    "at": {"type": "string"},
    "case": {"type": "string"},
    "arm": {"type": "string"},
    "assignment": {
      "type": "object", "required": ["cell", "order_index"], "additionalProperties": false,
      "properties": {"cell": {"type": "string"}, "order_index": {"type": "integer", "minimum": 0}}
    },
    "requested_profile": {"type": "object"},
    "retry_of": {"type": ["string", "null"]},
    "release": {
      "description": "A released cell's binding (ADR-0018 D3), written before its bundle leaves the evaluator: the arm host, the hypervisor snapshot it was reset to (null for a host with none, such as the local stand-in), and the content hashes of the preflight it passed and of the release bundle's manifest.",
      "type": "object", "required": ["host", "snapshot_uuid", "preflight_sha256", "bundle_sha256"],
      "additionalProperties": false,
      "properties": {
        "host": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "snapshot_uuid": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
        "preflight_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validity": {"enum": ["valid", "invalid_measurement", "runner_lost", "environment_blocked"]}
  },
  "allOf": [
    {"if": {"properties": {"event": {"const": "registered"}}},
     "then": {"required": ["case", "arm", "assignment", "requested_profile", "retry_of"]}},
    {"if": {"properties": {"event": {"const": "finalized"}}},
     "then": {"required": ["result_sha256", "validity"]}}
  ]
}
