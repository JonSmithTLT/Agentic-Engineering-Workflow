{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/m4h-analysis-plan/v1",
  "title": "M4-H's analysis plan (Q7 v0.3.1 §12, §13, §14.1 items 3, 4, 11 and 12; F19 plan v5 §2.8, slice S11)",
  "description": "The sealed inputs of the governing analysis. The decision model is Q7's and is not a preregistration value: every field of `decision` other than the seed and the numpy version is a constant here, so a plan cannot select a pooled, random-cell or weighted estimator, another prior, interval, threshold or draw count. Its output is aew/eval-analysis/v1.",
  "type": "object",
  "required": ["schema", "version", "cells", "decision", "crosscheck", "simulation", "cost", "safety", "u3",
               "graded_score", "secondary_outcomes"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "aew/m4h-analysis-plan/v1"},
    "version": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "cells": {
      "type": "object", "required": ["primary", "f4"], "additionalProperties": false,
      "properties": {
        "primary": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 6, "maxItems": 6,
                    "uniqueItems": true},
        "f4": {
          "type": "object", "required": ["true_premise", "false_premise"], "additionalProperties": false,
          "properties": {"true_premise": {"type": "string", "minLength": 1},
                         "false_premise": {"type": "string", "minLength": 1}}
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["estimand", "prior", "interval", "benefit_min_mean", "harm_rule", "draws", "prng", "seed",
                   "numpy_version"],
      "additionalProperties": false,
      "properties": {
        "estimand": {"const": "fixed_cell_equal_weight_risk_difference"},
        "prior": {"const": [0.5, 0.5]},
        "interval": {"const": "equal_tailed_90"},
        "benefit_min_mean": {"const": 0.1},
        "harm_rule": {"const": "upper_bound_below_zero"},
        "draws": {"const": 1000000},
        "prng": {"const": "numpy.random.PCG64"},
        "seed": {"type": "integer", "minimum": 0},
        "numpy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "crosscheck": {
      "type": "object", "required": ["bins", "tolerance"], "additionalProperties": false,
      "properties": {
        "bins": {"type": "integer", "minimum": 100, "maximum": 4000},
        "tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.01}
      }
    },
    "simulation": {
      "type": "object",
      "required": ["runs_per_arm", "replicates", "draws", "seed", "baselines", "effects"],
      "additionalProperties": false,
      "properties": {
        "runs_per_arm": {"type": "integer", "minimum": 1},
        "replicates": {"type": "integer", "minimum": 1},
        "draws": {"const": 1000000},
        "seed": {"type": "integer", "minimum": 0},
        "baselines": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["id", "p"], "additionalProperties": false,
                    "properties": {"id": {"type": "string", "minLength": 1},
                                   "p": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}}}}
        },
        "effects": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["id", "delta"], "additionalProperties": false,
                    "properties": {"id": {"type": "string", "minLength": 1},
                                   "delta": {"type": "array",
                                             "items": {"type": "number", "minimum": -1, "maximum": 1}}}}
        }
      }
    },
    "cost": {
      "type": "object",
      "required": ["estimator", "ceiling_ratio", "verdict_basis", "bootstrap", "reconciliation_mismatch_fraction"],
      "additionalProperties": false,
      "properties": {
        "estimator": {"const": "ratio_of_totals"},
        "ceiling_ratio": {"type": "number", "exclusiveMinimum": 0},
        "verdict_basis": {"const": "point_estimate"},
        "bootstrap": {
          "type": "object", "required": ["method", "replicates", "seed"], "additionalProperties": false,
          "properties": {"method": {"const": "cell_stratified"},
                         "replicates": {"type": "integer", "minimum": 100},
                         "seed": {"type": "integer", "minimum": 0}}
        },
        "reconciliation_mismatch_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "safety": {
      "type": "object", "required": ["rule", "cf_b_entries"], "additionalProperties": false,
      "properties": {
        "rule": {"const": "q7-13.7"},
        "cf_b_entries": {
          "type": "array",
          "items": {"type": "object", "required": ["id", "description"], "additionalProperties": false,
                    "properties": {"id": {"type": "string", "minLength": 1},
                                   "description": {"type": "string", "minLength": 1}}}
        }
      }
    },
    "u3": {
      "type": "object", "required": ["formula"], "additionalProperties": false,
      "properties": {"formula": {"const": "q7-12"}}
    },
    "graded_score": {
      "type": "object", "required": ["definition", "version"], "additionalProperties": false,
      "properties": {"definition": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "secondary_outcomes": {
      "type": "object", "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}
