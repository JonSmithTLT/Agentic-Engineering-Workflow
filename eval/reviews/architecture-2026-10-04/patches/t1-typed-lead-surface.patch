new file mode 100644
index 0000000..d03f65c
--- /dev/null
+++ b/tests/helpers/mcp_probe_agent.py
@@ -0,0 +1,125 @@
+"""A scripted, model-free MCP *client* standing in for the Lead's harness (the T1 prototype's tests).
+
+It runs as the harness command of ``aew lead session`` (so it has exactly the environment a real harness gives
+the Lead's model: the broker's coordinates, no credential), spawns ``aew lead mcp`` the way OpenCode would spawn a
+local MCP server, performs the MCP handshake, lists the tools, and runs a script of ``tools/call`` steps. Every
+response is appended to a transcript (the stand-in for the harness's persisted conversation, which custody scans
+read).
+
+Script: a JSON list of ``{"tool": name, "arguments": {...}}`` steps. A string argument ``"$revision"`` is replaced
+by the ``revision`` of the previous result; ``"$result.<path>"`` by a field of the previous structured result.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+NO_WINDOW = 0x08000000 if sys.platform == "win32" else 0
+
+
+def aew_argv() -> list[str]:
+    exe = shutil.which("aew")
+    return [exe] if exe else [sys.executable, "-m", "aew"]
+
+
+class Client:
+    def __init__(self, proc: subprocess.Popen[str]) -> None:
+        self.proc = proc
+        self.next_id = 1
+
+    def request(self, method: str, params: dict[str, Any] | None = None) -> dict[str, Any]:
+        rid, self.next_id = self.next_id, self.next_id + 1
+        message: dict[str, Any] = {"jsonrpc": "2.0", "id": rid, "method": method}
+        if params is not None:
+            message["params"] = params
+        assert self.proc.stdin is not None and self.proc.stdout is not None
+        self.proc.stdin.write(json.dumps(message) + "\n")
+        self.proc.stdin.flush()
+        line = self.proc.stdout.readline()
+        if not line:
+            raise SystemExit(f"the MCP server closed before answering {method}")
+        reply = json.loads(line)
+        if reply.get("id") != rid:
+            raise SystemExit(f"reply id {reply.get('id')} for request {rid}")
+        return reply
+
+    def notify(self, method: str, params: dict[str, Any] | None = None) -> None:
+        assert self.proc.stdin is not None
+        self.proc.stdin.write(json.dumps({"jsonrpc": "2.0", "method": method, "params": params or {}}) + "\n")
+        self.proc.stdin.flush()
+
+
+def resolve(value: Any, previous: dict[str, Any] | None) -> Any:
+    if isinstance(value, str) and value == "$revision":
+        return (previous or {}).get("revision")
+    if isinstance(value, str) and value == "$revision_text":
+        return str((previous or {}).get("revision"))
+    if isinstance(value, str) and value.startswith("$result."):
+        node: Any = (previous or {}).get("result")
+        for part in value[len("$result."):].split("."):
+            node = node[int(part)] if isinstance(node, list) else (node or {}).get(part)
+        return node
+    if isinstance(value, list):
+        return [resolve(v, previous) for v in value]
+    if isinstance(value, dict):
+        return {k: resolve(v, previous) for k, v in value.items()}
+    return value
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--script", required=True)
+    ap.add_argument("--transcript", required=True)
+    ap.add_argument("--cwd", default=os.getcwd())
+    args = ap.parse_args()
+    steps = json.loads(Path(args.script).read_text(encoding="utf-8"))
+    transcript = Path(args.transcript)
+    kwargs: dict[str, Any] = {"creationflags": NO_WINDOW} if sys.platform == "win32" else {}
+    proc = subprocess.Popen([*aew_argv(), "-C", args.cwd, "lead", "mcp"], stdin=subprocess.PIPE,
+                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, encoding="utf-8",
+                            cwd=args.cwd, env=dict(os.environ), **kwargs)
+    client = Client(proc)
+    out: list[dict[str, Any]] = []
+
+    def record(i: int, kind: str, result: Any) -> None:
+        out.append({"i": i, "kind": kind, "result": result})
+        transcript.write_text("\n".join(json.dumps(e, default=str) for e in out) + "\n", encoding="utf-8")
+
+    try:
+        init = client.request("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
+                                             "clientInfo": {"name": "aew-mcp-probe", "version": "0"}})
+        record(0, "initialize", init)
+        client.notify("notifications/initialized")
+        record(1, "tools/list", client.request("tools/list"))
+        previous: dict[str, Any] | None = None
+        for i, step in enumerate(steps, start=2):
+            arguments = resolve(step.get("arguments") or {}, previous)
+            reply = client.request("tools/call", {"name": step["tool"], "arguments": arguments})
+            record(i, f"tools/call {step['tool']}", reply)
+            result = (reply.get("result") or {}).get("structuredContent")
+            if isinstance(result, dict):
+                previous = result
+        record(len(steps) + 2, "env", {"has_lead_token": "AEW_LEAD_TOKEN" in os.environ,
+                                      "names": sorted(k for k in os.environ if k.startswith("AEW_"))})
+    finally:
+        if proc.stdin is not None:
+            proc.stdin.close()
+        try:
+            proc.wait(timeout=30)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+        err = proc.stderr.read() if proc.stderr is not None else ""
+        if err:
+            record(len(out), "server-stderr", err[-2000:])
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
