+++ b/tests/integration/test_lead_mcp.py
@@ -0,0 +1,113 @@
+"""The MCP transport of the Lead surface, end to end (T1 prototype): a scripted MCP client stands in for the Lead's
+harness inside ``aew lead session``, spawns ``aew lead mcp`` as OpenCode would, and drives AEW through it. The
+custody properties of the Lead bridge hold unchanged: no credential reaches the harness, its child, or its
+transcript; the broker's refusals apply to the ``cli`` tool."""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+from aewflow import sample_project
+from conftest import run_aew
+from fake_harness import HarnessLab, contains_credential, credential_hits, finished
+from invariants import assert_control_invariants
+
+PROBE = Path(__file__).resolve().parents[1] / "helpers" / "mcp_probe_agent.py"
+
+
+@pytest.fixture
+def lab(tmp_path):
+    lab = HarnessLab.create(sample_project(tmp_path), tmp_path)
+    yield lab
+    lab.cleanup()
+    assert not credential_hits(tmp_path), "a credential string was left in a file"
+
+
+def session(lab, name: str, steps: list[dict]) -> tuple[object, dict[int, dict]]:
+    script, transcript = lab.tmp / f"{name}.json", lab.tmp / f"{name}.transcript.jsonl"
+    script.write_text(json.dumps(steps), encoding="utf-8")
+    argv = ["lead", "session", "--", sys.executable, str(PROBE), "--script", str(script), "--transcript",
+            str(transcript), "--cwd", str(lab.root)]
+    res = run_aew("-C", str(lab.root), *argv, env={**lab.env, "AEW_LEAD_TOKEN": lab.project.token}, timeout=600)
+    lines = transcript.read_text(encoding="utf-8").splitlines() if transcript.exists() else []
+    return res, {e["i"]: e for e in map(json.loads, lines)}
+
+
+def structured(entry: dict) -> dict:
+    return entry["result"]["result"]["structuredContent"]
+
+
+DRAFT = {
+    "expect_rev": "$revision", "title": "Add subtract()", "risk_class": 1, "scope": ["calc/**", "tests/**"],
+    "goal": ["calc.core.subtract(5, 3) == 2 through the public module"],
+    "contract": ["changes stay within calc/ and tests/; vendored code untouched"],
+    "plan": {"body": "1. Add subtract(a, b) to calc/core.py.\n2. Add a focused test.\n",
+             "affected": ["calc/core.py"], "assurance": "none"},
+}
+
+
+def test_the_lead_harness_drives_aew_through_mcp_and_never_holds_the_credential(lab):
+    lab.script("default", [{"do": "aew", "args": ["whoami"]}])  # the implementer run: starts, acts once, ends
+    res, steps = session(lab, "mcp-a", [
+        {"tool": "status", "arguments": {}},
+        {"tool": "ticket_draft", "arguments": DRAFT},
+        {"tool": "cli", "arguments": {"argv": ["plan", "accept", "$result.work_id", "--revision", "1",
+                                               "--expect-rev", "$revision_text"]}},
+        {"tool": "explain", "arguments": {"work_id": "$result.work_id"}},
+        {"tool": "ticket_start", "arguments": {"expect_rev": "$revision", "work_id": "T-0001"}},
+        {"tool": "harness_wait", "arguments": {"runs": ["$result.run"], "timeout_s": 120}},
+        {"tool": "status", "arguments": {"work_id": "T-0001"}},
+    ])
+    assert res.returncode == 0, res.stderr
+    assert res.json["exit"] == 0 and res.json["seat"] == "held by your AEW_LEAD_TOKEN"
+    assert steps[0]["result"]["result"]["serverInfo"]["name"] == "aew"
+    listed = {t["name"] for t in steps[1]["result"]["result"]["tools"]}
+    assert {"status", "resume", "explain", "ticket_draft", "ticket_start", "harness_wait", "cli"} <= listed
+    assert "ticket_prepare" not in listed
+    status, draft, accept, explain, start, wait, final = (structured(steps[i]) for i in range(2, 9))
+    assert status["ok"] and status["projection"]["subject"] == "project"
+    assert draft["ok"] and [s["primitive"] for s in draft["completed_steps"]] == ["work.create", "plan.propose"]
+    assert draft["result"]["work_id"] == "T-0001" and draft["revision"] == status["revision"] + 2
+    assert accept["ok"] and accept["tool"] == "cli" and accept["revision"] == draft["revision"] + 1
+    assert explain["ok"] and explain["result"]["allowed"] is True and explain["result"]["entrypoint"] == "work.assign"
+    # the projection before the start already named the stage, auto-runnable, from the same predicate
+    ready = [a for a in accept["projection"]["mechanical_actions"] if a["action"] == "ticket_start"]
+    assert ready and ready[0]["auto_runnable"] is True and ready[0]["arguments"]["work_id"] == "T-0001"
+    assert start["ok"], start
+    assert [s["primitive"] for s in start["completed_steps"]] == ["work.assign", "dispatch.launch", "work.transition"]
+    assert start["completed_steps"][1]["revision"] is None  # the launch commits nothing of its own
+    assert start["result"]["run"] and start["projection"]["state"] == "RUNNING"
+    assert "invocation_token" not in json.dumps(start)
+    assert wait["ok"] and finished(wait["result"]["status"]) and not wait["result"]["timed_out"]
+    assert final["ok"] and final["result"]["work_unit"]["state"] == "RUNNING"
+    env = steps[max(steps)]["result"] if steps[max(steps)]["kind"] == "env" else steps[9]["result"]
+    assert env["has_lead_token"] is False and "AEW_LEAD_TOKEN" not in env["names"]
+    for blob in (res.stdout, json.dumps(steps)):
+        assert not contains_credential(blob)
+    assert_control_invariants(lab.project)
+
+
+def test_the_cli_tool_keeps_the_brokers_refusals(lab):
+    res, steps = session(lab, "mcp-b", [
+        {"tool": "status", "arguments": {}},
+        {"tool": "cli", "arguments": {"argv": ["lead", "release", "--expect-rev", "$revision_text"]}},
+        {"tool": "cli", "arguments": {"argv": ["work", "create", "ticket", "--title", "x", "--class", "1",
+                                               "--token", "not-a-credential",
+                                               "--expect-rev", "$revision_text"]}},
+        {"tool": "cli", "arguments": {"argv": ["status"]}},
+        {"tool": "cli", "arguments": {"argv": ["invoke", "create", "T-0001", "--role", "reviewer",
+                                               "--expect-rev", "$revision_text"]}},
+    ])
+    assert res.returncode == 0, res.stderr
+    release, token, read_only, dispatch = (structured(steps[i]) for i in range(3, 7))
+    assert not release["ok"] and release["stopped"]["error"]["code"] == "PERMISSION_DENIED"
+    assert "operator" in release["stopped"]["error"]["message"]
+    assert not token["ok"] and token["stopped"]["error"]["code"] == "USAGE"
+    assert not read_only["ok"] and read_only["stopped"]["error"]["code"] == "PERMISSION_DENIED"
+    assert not dispatch["ok"] and dispatch["stopped"]["error"]["code"] == "PERMISSION_DENIED"
+    assert "--launch" in dispatch["stopped"]["error"]["message"]
+    assert lab.project.rev() == structured(steps[2])["revision"]  # nothing committed
+    assert not contains_credential(json.dumps(steps))
