new file mode 100644
index 0000000..eb1ed2c
--- /dev/null
+++ b/src/aew/surface/projection.py
@@ -0,0 +1,142 @@
+"""``ActionProjection`` (F15 v0.4 §15): what can happen next, typed, for one work unit or the project.
+
+Every ``StageResult`` carries one, so a Lead needs no status read between steps (audit L1, X2). It separates:
+
+* ``mechanical_actions``: mechanical or policy-resolved tools open now, ``auto_runnable`` only when the queryable
+  guard substrate (``DispatchDecision``, M4-A) allows them at this revision;
+* ``decisions_required``: judgments only the Lead can make, each naming the tool that records it once made and
+  carrying **no default** (publish, accept evidence, classify a failure, rework or escalate, reconcile);
+* ``blockers``: the engine's own blocking conditions and dependency blocks, with their reason codes;
+* ``hints``: the engine's prose next actions for the subject (``status``/``resume``), for a reader, never parsed.
+
+Prototype limits (thread T1): the derivation reads the unit's state and the runs' local telemetry and asks the
+dispatch predicate where one exists. Transition and ingest guards have no query form yet, so an action over them is
+reported with ``auto_runnable: false``; M4-E's guard migration (v0.4 §13) turns those into real answers. Anomalies
+(v0.4 §19) are not derived.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from aew.engine.primitives import MECHANICAL, POLICY_RESOLVED
+from aew.errors import AEWError
+
+# Run statuses, as the harness contract spells them (local telemetry, never authority).
+RUNNING = ("starting", "running")
+ENDED_WITH_EVIDENCE = "ended_with_evidence"
+
+
+def _action(name: str, arguments: dict[str, Any], operation_class: str, *, auto_runnable: bool = False,
+            reason_codes: list[str] | None = None, available: bool = True,
+            cli: list[str] | None = None) -> dict[str, Any]:
+    return {"action": name, "arguments": arguments, "operation_class": operation_class,
+            "auto_runnable": auto_runnable, "reason_codes": reason_codes or [], "available": available, "cli": cli}
+
+
+def _decision(name: str, subject: str, *, evidence: list[str] | None = None, tool: str | None = None,
+              arguments: dict[str, Any] | None = None, available: bool = True,
+              cli: list[str] | None = None) -> dict[str, Any]:
+    return {"decision": name, "subject": subject, "evidence": evidence or [], "tool": tool, "arguments": arguments,
+            "default": "NONE", "available": available, "cli": cli}
+
+
+def projection(engine: Any, work_id: str | None = None) -> dict[str, Any]:
+    """The projection for ``work_id``, or for the project. Never raises: a failure to derive is reported in it."""
+    state = engine.store.read()
+    out: dict[str, Any] = {
+        "revision": state["revision"], "generation": (state.get("lead") or {}).get("generation"),
+        "subject": work_id or "project", "state": None, "mechanical_actions": [], "decisions_required": [],
+        "blockers": [], "anomalies": [], "hints": [], "runs": [],
+    }
+    try:
+        report = engine.status()
+        runs = engine.harness_resume(state)
+        if work_id is None:
+            out["hints"] = list(report.get("next_actions") or [])
+            out["runs"] = runs
+            for c in report.get("contradictions") or []:
+                out["blockers"].append({"code": "CONTRADICTION", "message": str(c)})
+            return out
+        unit = engine.status(work_id)["work_unit"]
+        out["state"] = unit.get("state")
+        prefix = f"{work_id}: "
+        out["hints"] = [a[len(prefix):] for a in report.get("next_actions") or [] if a.startswith(prefix)]
+        out["runs"] = [r for r in runs if r.get("work_unit") == work_id]
+        _derive_unit(engine, state, work_id, unit, out)
+    except AEWError as exc:
+        out["error"] = exc.to_dict()
+    return out
+
+
+def _derive_unit(engine: Any, state: dict[str, Any], wid: str, unit: dict[str, Any], out: dict[str, Any]) -> None:
+    rev = state["revision"]
+    st = unit.get("state")
+    live = [r for r in out["runs"] if r.get("status") in RUNNING]
+    ended = [r for r in out["runs"] if r.get("status") == ENDED_WITH_EVIDENCE]
+    evidence = sorted({e for r in ended for e in r.get("evidence") or []})
+    if live:
+        out["mechanical_actions"].append(_action(
+            "harness_wait", {"runs": [r["run"] for r in live]}, MECHANICAL, auto_runnable=True))
+    for b in unit.get("blocked_by") or []:
+        kind = str(b.get("kind") or "blocked")
+        out["blockers"].append({"code": kind.upper(), "message": kind.replace("_", " "),
+                                "details": {k: v for k, v in b.items() if k != "kind"}})
+    if unit.get("kind") != "ticket":
+        return
+    mutating = bool(unit.get("mutating"))
+    if st in ("READY", "BLOCKED") and mutating:
+        _dispatch_action(engine, wid, "ticket_start", {"expect_rev": rev, "work_id": wid}, out)
+    elif st in ("READY", "BLOCKED"):
+        _dispatch_action(engine, wid, "cli", {"argv": ["work", "dispatch", wid, "--launch", "--expect-rev", str(rev)]},
+                         out, available=True)
+    elif st == "RUNNING" and mutating and ended and not live:
+        out["mechanical_actions"].append(_action(
+            "ticket_request_review", {"expect_rev": rev, "work_id": wid}, POLICY_RESOLVED,
+            reason_codes=["TRANSITION_GUARD_AT_EXECUTION"]))
+    elif st == "REVIEW_PENDING" and ended:
+        for e in evidence:
+            out["decisions_required"].append(_decision(
+                "ACCEPT_REVIEW_EVIDENCE", wid, evidence=[e], tool="ticket_request_verification",
+                arguments={"expect_rev": rev, "work_id": wid, "review_evidence": e}))
+    elif st == "REVIEW_FAILED":
+        out["decisions_required"].append(_decision(
+            "REWORK_OR_ESCALATE", wid, tool="cli",
+            cli=["work", "transition", wid, "--to", "RUNNING", "--reason", "<why>", "--expect-rev", str(rev)]))
+    elif st == "VERIFY_PENDING" and ended:
+        for e in evidence:
+            out["decisions_required"].append(_decision(
+                "ACCEPT_VERIFICATION", wid, evidence=[e], tool="ticket_prepare",
+                arguments={"expect_rev": rev, "work_id": wid, "verification_evidence": e}, available=False,
+                cli=["verify", "ingest", wid, "--evidence", e, "--expect-rev", str(rev)]))
+    elif st == "VERIFICATION_FAILED":
+        out["decisions_required"].append(_decision(
+            "CLASSIFY_FAILURE", wid, tool="cli",
+            cli=["verify", "classify", wid, "--as", "<implementation|plan|inconclusive>", "--reason", "<why>",
+                 "--expect-rev", str(rev)]))
+    elif st == "COMMIT_READY":
+        integration = unit.get("integration") or {}
+        if integration.get("status") == "prepared" and not live:
+            out["decisions_required"].append(_decision(
+                "PUBLISH", wid, evidence=evidence, tool="cli",
+                cli=["integrate", "publish", wid, "--expect-rev", str(rev)]))
+    elif st == "INTERRUPTED":
+        out["decisions_required"].append(_decision(
+            "RECONCILE", wid, tool="cli",
+            cli=["work", "reconcile", wid, "--to", "<phase>", "--expect-rev", str(rev)]))
+
+
+def _dispatch_action(engine: Any, wid: str, name: str, arguments: dict[str, Any], out: dict[str, Any], *,
+                     available: bool = True) -> None:
+    """A dispatching action, answered by the dispatch predicate: allowed means auto-runnable, else its blockers."""
+    try:
+        decision = engine.dispatch_explain(wid)
+    except AEWError as exc:
+        out["blockers"].append({"code": exc.code, "message": exc.message, "details": dict(exc.details)})
+        return
+    out["mechanical_actions"].append(_action(
+        name, arguments, POLICY_RESOLVED, auto_runnable=bool(decision.get("allowed")),
+        reason_codes=list(decision.get("reason_codes") or []), available=available))
+    for b in decision.get("blocking_conditions") or []:
+        out["blockers"].append({"code": b["code"], "message": b["message"], **({"details": b["details"]}
+                                                                              if b.get("details") else {})})
