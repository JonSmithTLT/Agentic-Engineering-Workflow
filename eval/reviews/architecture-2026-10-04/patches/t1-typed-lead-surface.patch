--- /dev/null
+++ b/src/aew/surface/mcp.py
@@ -0,0 +1,205 @@
+"""The MCP transport of the Lead surface: ``aew lead mcp`` (architecture review T1; WC §15.6 "an optional MCP
+adapter may expose the same engine"; invariant 21).
+
+A model's harness spawns this process (OpenCode: an ``mcp`` entry of type ``local`` in the Lead projection) and
+speaks MCP over its stdin and stdout: newline-delimited JSON-RPC 2.0, the ``initialize`` handshake, ``tools/list``
+and ``tools/call``. The process **holds no credential**. Inside a Lead session it has only the Lead broker's
+coordinates in its environment, like the ``aew`` CLI client, and forwards every call as ``lead.tool {name,
+arguments}`` to the broker, which runs the tool with the credential it holds (``aew.harness.lead_broker``). Custody
+is therefore exactly ADR-0009's: the model can exercise the Lead's operations without possessing, printing or
+inheriting the Lead credential, and the broker's refusals (credential-emitting commands, other projects, a
+superseded seat) apply unchanged.
+
+Outside a session, with ``AEW_LEAD_TOKEN`` in the operator's own environment, the server runs tools directly: the
+operator's terminal already holds that credential (ADR-0005), and an MCP client there (an IDE, another agent) gets
+the same surface. A harness-launched server never has that variable: ``aew opencode`` removes it.
+
+The protocol layer is deliberately small and dependency-free: AEW pins what it speaks, and a probe can check a
+harness against it. Nothing here is authority; the engine refuses or commits.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import sys
+from collections.abc import Callable
+from typing import Any, TextIO
+
+from aew import __version__, errors
+from aew.schemas import schema_defs
+from aew.surface import contract
+
+PROTOCOL_VERSIONS = ("2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05")  # newest first; a known one is echoed
+Call = Callable[[str, dict[str, Any]], dict[str, Any]]  # (tool name, arguments) -> StageResult
+
+PARSE_ERROR, INVALID_REQUEST, METHOD_NOT_FOUND, INVALID_PARAMS, INTERNAL_ERROR = -32700, -32600, -32601, -32602, -32603
+
+
+def output_schema() -> dict[str, Any]:
+    """The StageResult schema, self-contained, for ``tools/list``."""
+    defs = schema_defs("surface")
+    return {**defs["stage_result"], "$defs": defs}
+
+
+def tools_list() -> dict[str, Any]:
+    return {"tools": [contract.mcp_tool(t) for t in contract.exposed()]}  # no per-tool outputSchema: context cost
+
+
+def call_result(result: dict[str, Any]) -> dict[str, Any]:
+    """A ``tools/call`` result: the StageResult as structured content and as text (for clients without structured
+    support). ``isError`` follows the result's ``ok``: a refusal is a tool outcome the model must read, not a
+    protocol failure."""
+    return {"content": [{"type": "text", "text": json.dumps(result, indent=1, sort_keys=False, default=str)}],
+            "structuredContent": result, "isError": not result.get("ok", False)}
+
+
+class Server:
+    """One MCP session over a pair of text streams."""
+
+    def __init__(self, call: Call, *, stdin: TextIO | None = None, stdout: TextIO | None = None,
+                 log: TextIO | None = None) -> None:
+        self.call = call
+        self.stdin = stdin or sys.stdin
+        self.stdout = stdout or sys.stdout
+        self.log = log or sys.stderr
+        self.initialized = False
+        self.client: dict[str, Any] = {}
+
+    # ---- framing
+
+    def _write(self, message: dict[str, Any]) -> None:
+        self.stdout.write(json.dumps(message, separators=(",", ":"), default=str) + "\n")
+        self.stdout.flush()
+
+    def _reply(self, request_id: Any, result: Any) -> None:
+        self._write({"jsonrpc": "2.0", "id": request_id, "result": result})
+
+    def _error(self, request_id: Any, code: int, message: str, data: Any = None) -> None:
+        err: dict[str, Any] = {"code": code, "message": message}
+        if data is not None:
+            err["data"] = data
+        self._write({"jsonrpc": "2.0", "id": request_id, "error": err})
+
+    def serve_forever(self) -> int:
+        """Serve until stdin closes. Returns the process exit code."""
+        for line in self.stdin:
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                message = json.loads(line)
+            except ValueError:
+                self._error(None, PARSE_ERROR, "a message is one JSON object per line")
+                continue
+            if isinstance(message, list):  # a batch: handled one by one, replies in order
+                for item in message:
+                    self.handle(item)
+            else:
+                self.handle(message)
+        return 0
+
+    # ---- dispatch
+
+    def handle(self, message: Any) -> None:
+        if not isinstance(message, dict) or message.get("jsonrpc") != "2.0":
+            self._error(message.get("id") if isinstance(message, dict) else None, INVALID_REQUEST,
+                        "not a JSON-RPC 2.0 message")
+            return
+        method, request_id = message.get("method"), message.get("id")
+        params = message.get("params") if message.get("params") is not None else {}
+        if method is None:  # a response to something we never sent
+            return
+        if not isinstance(params, dict):
+            if request_id is not None:
+                self._error(request_id, INVALID_PARAMS, "params must be an object")
+            return
+        if method.startswith("notifications/"):
+            if method == "notifications/initialized":
+                self.initialized = True
+            return  # notifications get no reply
+        try:
+            result = self.dispatch(method, params)
+        except errors.AEWError as exc:  # a transport-level refusal (not a tool outcome, which is a result)
+            self._error(request_id, INVALID_PARAMS, exc.message, exc.to_dict())
+            return
+        except KeyError as exc:
+            self._error(request_id, METHOD_NOT_FOUND, f"method not found: {exc.args[0]}")
+            return
+        except Exception as exc:  # never let one request end the session
+            self.log.write(f"aew lead mcp: {type(exc).__name__}: {exc}\n")
+            self._error(request_id, INTERNAL_ERROR, f"{type(exc).__name__}: {exc}")
+            return
+        if request_id is not None:
+            self._reply(request_id, result)
+
+    def dispatch(self, method: str, params: dict[str, Any]) -> Any:
+        if method == "initialize":
+            self.client = params.get("clientInfo") or {}
+            asked = params.get("protocolVersion")
+            version = asked if asked in PROTOCOL_VERSIONS else PROTOCOL_VERSIONS[0]
+            return {"protocolVersion": version, "capabilities": {"tools": {"listChanged": False}},
+                    "serverInfo": {"name": contract.SERVER_NAME, "title": "AEW Lead surface", "version": __version__},
+                    "instructions": INSTRUCTIONS}
+        if method == "ping":
+            return {}
+        if method == "tools/list":
+            return tools_list()
+        if method == "tools/call":
+            name = params.get("name")
+            arguments = params.get("arguments") or {}
+            if not isinstance(name, str) or not isinstance(arguments, dict):
+                raise errors.UsageError("tools/call takes {name: string, arguments: object}")
+            if name not in contract.TOOLS or contract.TOOLS[name].status != contract.BUILT:
+                raise errors.UsageError(f"unknown tool {name!r}", offered=[t.name for t in contract.exposed()])
+            return call_result(self.call(name, arguments))
+        if method in ("resources/list", "resources/templates/list", "prompts/list"):
+            return {method.split("/")[0]: []} if method != "resources/templates/list" else {"resourceTemplates": []}
+        raise KeyError(method)
+
+
+INSTRUCTIONS = (
+    "AEW holds the workflow; this server is the Lead's typed interface to it. Every result carries `revision` (pass "
+    "it as `expect_rev` to your next mutation), `completed_steps`, `stopped` (where and why a bundle stopped) and "
+    "`projection`: the mechanical actions open now, the decisions only you can make (no defaults), blockers and "
+    "hints. Prefer a stage tool; use `cli` for anything else. You never hold a credential here."
+)
+
+
+# ---------------------------------------------------------------------------------------------- entry point
+
+def forwarding_call() -> Call:
+    """A ``call`` that forwards to the Lead broker of the session this process runs in (no credential here)."""
+    from aew.harness import bridge, lead_broker
+
+    def call(name: str, arguments: dict[str, Any]) -> dict[str, Any]:
+        return bridge.call("lead.tool", {"name": name, "arguments": json.dumps(arguments)},
+                           env_names=lead_broker.ENV_NAMES)
+
+    return call
+
+
+def direct_call(engine: Any, token: str) -> Call:
+    """A ``call`` that runs tools here with a credential this process legitimately holds (the operator's shell)."""
+    from aew.engine import dispatch
+    from aew.surface import run
+
+    def call(name: str, arguments: dict[str, Any]) -> dict[str, Any]:
+        with dispatch.channel("lead_mcp"):
+            return run.run_tool(engine, token, name, arguments)
+
+    return call
+
+
+def serve(engine_factory: Callable[[], Any]) -> int:
+    """``aew lead mcp``: pick the custody mode from the environment and serve stdio until the client closes it."""
+    from aew.harness import lead_broker
+
+    if os.environ.get(lead_broker.ENV_ENDPOINT):
+        call = forwarding_call()
+    elif os.environ.get("AEW_LEAD_TOKEN"):
+        call = direct_call(engine_factory(), os.environ["AEW_LEAD_TOKEN"])
+    else:
+        raise errors.UsageError("aew lead mcp serves a Lead session (started by `aew lead session` or `aew opencode`), "
+                                "or an operator's own shell with AEW_LEAD_TOKEN set; neither is the case here")
+    return Server(call).serve_forever()
