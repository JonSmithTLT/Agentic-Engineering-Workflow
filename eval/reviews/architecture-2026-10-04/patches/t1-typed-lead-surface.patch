diff --git a/tests/unit/test_surface.py b/tests/unit/test_surface.py
new file mode 100644
index 0000000..c6c861c
--- /dev/null
+++ b/tests/unit/test_surface.py
@@ -0,0 +1,271 @@
+"""The typed Lead surface (T1 prototype): the catalog's structure, the runner's stop rules, the StageResult contract
+and the MCP framing, without a harness."""
+
+from __future__ import annotations
+
+import io
+import json
+from typing import Any
+
+import yaml
+from aewflow import sample_project
+from jsonschema import Draft202012Validator
+
+from aew.engine.api import Engine
+from aew.engine.dispatch import ENTRYPOINTS
+from aew.engine.primitives import JUDGMENT_BEARING, MECHANICAL, POLICY_RESOLVED
+from aew.schemas import validate
+from aew.surface import contract, mcp, run
+
+# ---------------------------------------------------------------------------------------------- the catalog
+
+
+def _object_schemas(schema: Any):
+    if isinstance(schema, dict):
+        if schema.get("type") == "object" or "properties" in schema:
+            yield schema
+        for v in schema.values():
+            yield from _object_schemas(v)
+    elif isinstance(schema, list):
+        for v in schema:
+            yield from _object_schemas(v)
+
+
+def test_every_tool_schema_is_valid_and_closed():
+    for t in contract.TOOLS.values():
+        Draft202012Validator.check_schema(t.input_schema)
+        for obj in _object_schemas(t.input_schema):
+            assert obj.get("additionalProperties") is False, f"{t.name}: an open object schema"
+        assert t.description and len(t.description) < 400, t.name  # context cost: short, specific descriptions
+
+
+def test_dispatching_tools_name_registered_entrypoints_and_no_other_tool_does():
+    for t in contract.TOOLS.values():
+        reached = set(t.expands_to) & set(ENTRYPOINTS)
+        assert bool(reached) == t.dispatches, (t.name, reached)
+        if t.dispatches:
+            assert "dispatch.launch" in t.expands_to, f"{t.name}: a dispatching stage always launches (custody)"
+
+
+def test_judgment_bearing_tools_name_the_judgments_their_arguments_carry():
+    for t in contract.TOOLS.values():
+        if t.operation_class == JUDGMENT_BEARING:
+            assert t.required_judgments, t.name
+        else:
+            assert t.operation_class in (MECHANICAL, POLICY_RESOLVED) and not t.required_judgments, t.name
+
+
+def test_designed_tools_are_in_the_contract_but_never_listed_and_refused_if_called(tmp_path):
+    listed = {x["name"] for x in mcp.tools_list()["tools"]}
+    assert listed == {t.name for t in contract.exposed()}
+    assert "ticket_prepare" in contract.TOOLS and "ticket_prepare" not in listed
+    p = sample_project(tmp_path)
+    try:
+        run.run_tool(Engine.discover(p.root), p.token, "ticket_prepare", {})
+    except Exception as exc:  # noqa: BLE001 (the refusal's code is the assertion)
+        assert getattr(exc, "code", None) == "USAGE" and "not built" in str(exc)
+    else:
+        raise AssertionError("a designed tool ran")
+
+
+def test_every_exposed_tool_has_a_runner_and_vice_versa():
+    assert set(run.RUNNERS) == {t.name for t in contract.exposed()}
+
+
+def test_the_tool_list_fits_a_context_budget():
+    text = json.dumps(mcp.tools_list(), separators=(",", ":"))
+    assert len(text) < 12_000, f"tools/list is {len(text)} bytes: the Lead's whole surface must stay small (G2, F13)"
+    assert len(mcp.tools_list()["tools"]) <= 16
+
+
+# ---------------------------------------------------------------------------------------------- the runner
+
+
+def test_queries_return_a_valid_result_and_commit_nothing(tmp_path):
+    p = sample_project(tmp_path)
+    engine, rev = Engine.discover(p.root), p.rev()
+    for name, args in (("status", {}), ("resume", {}), ("harness_status", {})):
+        out = run.run_tool(engine, p.token, name, args)
+        validate("surface", out, source=name)
+        assert out["ok"] and out["revision"] == rev and out["completed_steps"] == [] and out["stopped"] is None
+        assert out["projection"]["subject"] == "project" and out["projection"]["revision"] == rev
+    assert p.rev() == rev
+
+
+def test_a_refused_query_is_a_tool_outcome_not_an_exception(tmp_path):
+    p = sample_project(tmp_path)
+    out = run.run_tool(Engine.discover(p.root), p.token, "work_show", {"work_id": "T-9999"})
+    validate("surface", out, source="work_show")
+    assert not out["ok"] and out["stopped"]["boundary"] == "not_found"
+    assert out["stopped"]["error"]["code"] == "NOT_FOUND"
+
+
+def test_arguments_outside_the_schema_are_a_usage_outcome(tmp_path):
+    p = sample_project(tmp_path)
+    out = run.run_tool(Engine.discover(p.root), p.token, "status", {"bogus": 1})
+    assert not out["ok"] and out["stopped"]["boundary"] == "usage"
+    assert "bogus" in json.dumps(out["stopped"]["error"])
+
+
+DRAFT = {
+    "title": "Add subtract()", "risk_class": 1, "scope": ["calc/**", "tests/**"],
+    "goal": ["calc.core.subtract(5, 3) == 2 through the public module"],
+    "contract": ["changes stay within calc/ and tests/; vendored code untouched"],
+    "plan": {"body": "1. Add subtract(a, b) to calc/core.py.\n2. Add a focused test.\n",
+             "affected": ["calc/core.py"], "assurance": "none"},
+}
+
+
+def _unit_record(p, wid: str) -> dict[str, Any]:
+    text = (p.root / ".aew" / "work" / wid / "ticket.md").read_text(encoding="utf-8")
+    front = yaml.safe_load(text.split("---")[1])
+    for volatile in ("created_at", "id"):
+        front.pop(volatile, None)
+    return front
+
+
+def test_ticket_draft_equals_the_primitive_sequence(tmp_path):
+    """v0.4 §20: a stage produces the same durable result as its documented primitive sequence."""
+    a, b = sample_project(tmp_path / "a"), sample_project(tmp_path / "b")
+    out = run.run_tool(Engine.discover(a.root), a.token, "ticket_draft", {"expect_rev": a.rev(), **DRAFT})
+    validate("surface", out, source="ticket_draft")
+    assert out["ok"] and [s["primitive"] for s in out["completed_steps"]] == ["work.create", "plan.propose"]
+    assert out["revision"] == a.rev() and out["completed_steps"][-1]["revision"] == a.rev()
+    wid = out["result"]["work_id"]
+    assert out["projection"]["subject"] == wid and out["projection"]["state"] == "BLOCKED"
+    assert any(b["code"] == "PLAN_NOT_ACCEPTED" for b in out["projection"]["blockers"])
+    # the primitive path
+    args = ["work", "create", "ticket", "--title", DRAFT["title"], "--class", "1", "--goal", DRAFT["goal"][0],
+            "--contract", DRAFT["contract"][0]]
+    for s in DRAFT["scope"]:
+        args += ["--scope", s]
+    wid_b = b.lead(*args)["id"]
+    plan = tmp_path / "plan.md"
+    plan.write_text(DRAFT["plan"]["body"], encoding="utf-8")
+    b.lead("plan", "propose", "--assurance", "none", wid_b, "--file", str(plan), "--affected", "calc/core.py")
+    assert wid == wid_b
+    assert _unit_record(a, wid) == _unit_record(b, wid_b)
+    plan_a = a.ok("status", wid, "--json")["work_unit"]["plans"]
+    plan_b = b.ok("status", wid_b, "--json")["work_unit"]["plans"]
+    assert len(plan_a) == len(plan_b) == 1
+    volatile = ("at", "sha256", "proposed_at")
+    assert {k: v for k, v in plan_a[0].items() if k not in volatile} == {
+        k: v for k, v in plan_b[0].items() if k not in volatile}
+    if plan_a[0].get("path"):  # the plan text itself, apart from timestamps
+        texts = [__import__("re").sub(r"\d{4}-\d{2}-\d{2}T[0-9:Z]+", "<t>",
+                                     (p.root / ".aew" / plan_a[0]["path"]).read_text(encoding="utf-8"))
+                 for p in (a, b)]
+        assert texts[0] == texts[1]
+
+
+def test_a_stale_first_step_stops_before_anything_commits(tmp_path):
+    p = sample_project(tmp_path)
+    rev = p.rev()
+    out = run.run_tool(Engine.discover(p.root), p.token, "ticket_draft", {"expect_rev": rev - 1, **DRAFT})
+    assert not out["ok"] and out["stopped"] == {
+        "at": "work.create", "boundary": "stale_revision", "error": out["stopped"]["error"]}
+    assert out["stopped"]["error"]["code"] == "STALE_REVISION" and out["completed_steps"] == []
+    assert out["revision"] == rev == p.rev()
+
+
+def test_a_refusal_mid_bundle_keeps_the_completed_steps_and_projects_the_new_unit(tmp_path):
+    p = sample_project(tmp_path)
+    bad = {**DRAFT, "plan": {**DRAFT["plan"], "assurance": {"review": ["no-such-card"]}}}
+    out = run.run_tool(Engine.discover(p.root), p.token, "ticket_draft", {"expect_rev": p.rev(), **bad})
+    validate("surface", out, source="ticket_draft")
+    assert not out["ok"] and [s["primitive"] for s in out["completed_steps"]] == ["work.create"]
+    assert out["stopped"]["at"] == "plan.propose" and out["stopped"]["boundary"] in ("refused", "not_found", "usage")
+    assert out["projection"]["subject"] == "T-0001" and out["revision"] == p.rev()
+
+
+def test_results_never_carry_a_credential_key():
+    assert run.scrub({"a": {"invocation_token": "x", "token": "y", "keep": [{"offer": "z", "b": 1}]}}) == {
+        "a": {"keep": [{"b": 1}]}}
+
+
+def test_the_cli_transport_returns_the_same_contract(tmp_path):
+    p = sample_project(tmp_path)
+    listed = p.ok("lead", "tool", "--list")
+    assert {t["name"] for t in listed["tools"]} == {t.name for t in contract.exposed()}
+    out = p.ok("lead", "tool", "status", "--token", p.token)
+    validate("surface", out, source="aew lead tool status")
+    assert out["ok"] and out["tool"] == "status" and out["revision"] == p.rev()
+    out = p.ok("lead", "tool", "ticket_draft", "--token", p.token,
+               "--arguments", json.dumps({"expect_rev": p.rev(), **DRAFT}))
+    assert out["ok"] and out["result"]["work_id"] == "T-0001"
