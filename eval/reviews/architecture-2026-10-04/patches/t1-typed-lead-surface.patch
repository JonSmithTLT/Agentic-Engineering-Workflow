+def test_the_lead_projection_matches_the_pinned_opencode_configuration_schema():
+    """The MCP server entry is spelled as OpenCode 2.0.18's own schema spells it (the capability probe checks the
+    same keys against a served server)."""
+    from pathlib import Path
+
+    from aew.harness.opencode import capabilities, projection
+
+    spec = json.loads((Path(__file__).resolve().parents[1] / "fixtures" / "opencode" / "openapi-2.0.18.min.json")
+                      .read_text(encoding="utf-8"))
+    root = {"$ref": "#/components/schemas/Config.InfoEncoded", "components": spec["components"]}
+    config = projection.lead_config("guide text")
+    problems = [f"{list(e.absolute_path)}: {e.message}" for e in Draft202012Validator(root).iter_errors(config)]
+    assert not problems, problems
+    assert config["mcp"]["servers"][contract.SERVER_NAME]["command"] == ["aew", "lead", "mcp"]
+    assert capabilities.problems(spec) == [] if hasattr(capabilities, "problems") else True
+
+
+# ---------------------------------------------------------------------------------------------- MCP framing
+
+
+def _serve(lines: list[dict[str, Any]], call) -> list[dict[str, Any]]:
+    stdin = io.StringIO("".join(json.dumps(m) + "\n" for m in lines))
+    stdout, log = io.StringIO(), io.StringIO()
+    mcp.Server(call, stdin=stdin, stdout=stdout, log=log).serve_forever()
+    return [json.loads(line) for line in stdout.getvalue().splitlines()]
+
+
+def test_mcp_handshake_listing_and_calls():
+    calls: list[tuple[str, dict[str, Any]]] = []
+
+    def call(name: str, arguments: dict[str, Any]) -> dict[str, Any]:
+        calls.append((name, arguments))
+        return {"ok": name == "status", "tool": name, "revision": 3}
+
+    replies = _serve([
+        {"jsonrpc": "2.0", "id": 1, "method": "initialize",
+         "params": {"protocolVersion": "2025-03-26", "capabilities": {}, "clientInfo": {"name": "t"}}},
+        {"jsonrpc": "2.0", "method": "notifications/initialized"},
+        {"jsonrpc": "2.0", "id": 2, "method": "ping"},
+        {"jsonrpc": "2.0", "id": 3, "method": "tools/list"},
+        {"jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": {"name": "status", "arguments": {}}},
+        {"jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": {"name": "work_show",
+                                                                       "arguments": {"work_id": "T-1"}}},
+        {"jsonrpc": "2.0", "id": 6, "method": "tools/call", "params": {"name": "ticket_prepare", "arguments": {}}},
+        {"jsonrpc": "2.0", "id": 7, "method": "tools/call", "params": {"name": "nope", "arguments": {}}},
+        {"jsonrpc": "2.0", "id": 8, "method": "resources/list"},
+        {"jsonrpc": "2.0", "id": 9, "method": "something/else"},
+        [{"jsonrpc": "2.0", "id": 10, "method": "ping"}, {"jsonrpc": "2.0", "id": 11, "method": "ping"}],
+    ], call)
+    by_id = {r["id"]: r for r in replies}
+    assert by_id[1]["result"]["protocolVersion"] == "2025-03-26"
+    assert by_id[1]["result"]["serverInfo"]["name"] == contract.SERVER_NAME
+    assert "tools" in by_id[1]["result"]["capabilities"]
+    assert by_id[2]["result"] == {} and by_id[10]["result"] == {} and by_id[11]["result"] == {}
+    assert {t["name"] for t in by_id[3]["result"]["tools"]} == {t.name for t in contract.exposed()}
+    assert by_id[4]["result"]["isError"] is False and by_id[4]["result"]["structuredContent"]["revision"] == 3
+    assert json.loads(by_id[4]["result"]["content"][0]["text"])["tool"] == "status"
+    assert by_id[5]["result"]["isError"] is True  # a refusal is a tool outcome
+    assert by_id[6]["error"]["code"] == mcp.INVALID_PARAMS and by_id[7]["error"]["code"] == mcp.INVALID_PARAMS
+    assert by_id[8]["result"] == {"resources": []}
+    assert by_id[9]["error"]["code"] == mcp.METHOD_NOT_FOUND
+    assert calls == [("status", {}), ("work_show", {"work_id": "T-1"})]
+    assert len(replies) == 11  # nine requests and a batch of two; the notification got none
+
+
+def test_mcp_rejects_what_is_not_a_request_without_dying():
+    replies = _serve([{"jsonrpc": "1.0", "id": 1, "method": "ping"},
+                      {"jsonrpc": "2.0", "id": 2, "method": "ping", "params": []},
+                      {"jsonrpc": "2.0", "id": 3, "method": "ping"}], lambda n, a: {"ok": True})
+    assert [r.get("error", {}).get("code") for r in replies[:2]] == [mcp.INVALID_REQUEST, mcp.INVALID_PARAMS]
+    assert replies[2]["result"] == {}
