new file mode 100644
index 0000000..545900c
--- /dev/null
+++ b/src/aew/surface/run.py
@@ -0,0 +1,304 @@
+"""Run one tool of the Lead surface against the Engine and return its ``StageResult`` (F15 v0.4 §7, §9; T1).
+
+A **stage** is one Lead judgment and the mechanics it implies: a sequence of existing, individually guarded engine
+operations, run in order, each with the revision the previous one committed. The engine's checks (current Lead,
+expected revision, every gate and guard) stay authoritative at every step: this module composes, it never bypasses.
+A bundle is one tool call, not one atomic commit: each step is its own durable transition with its own ``via``.
+
+Stop rules. The first refusal stops the bundle; completed steps are reported, nothing is undone (every intermediate
+state is a legal primitive-reachable state, §9). ``STALE_REVISION`` on the **first** step is the caller's CAS and
+stops. On a later step it means another writer committed between two of our steps; a ``MECHANICAL`` or
+``POLICY_RESOLVED`` step is then re-run once against the current revision (its guards are re-evaluated by the engine;
+nothing is cached), a ``JUDGMENT_BEARING`` step never is (the judgment was made against a state that moved). Policy
+drift (``STALE_POLICY``, §8) and the stage-intent journal (§9 to §11) are M4-E engine work and are not here.
+
+Transports call :func:`run_tool`; nothing else needs to know a tool's steps.
+"""
+
+from __future__ import annotations
+
+import copy
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from typing import Any
+
+from jsonschema import Draft202012Validator
+
+from aew.engine.primitives import JUDGMENT_BEARING, MECHANICAL, POLICY_RESOLVED
+from aew.errors import AEWError, IllegalTransition, StaleRevision, UsageError, ValidationFailed
+from aew.schemas import validate as validate_schema
+from aew.surface import contract
+from aew.surface.projection import projection
+
+RunCli = Callable[[list[str], str], dict[str, Any]]  # (argv, stdin) -> {"result": ..., "json": bool}
+SECRET_KEYS = frozenset({"invocation_token", "token", "offer", "secret"})  # never in a result, whatever a step returns
+
+
+def boundary_of(exc: AEWError) -> str:
+    code = exc.code
+    if code == "STALE_REVISION":
+        return "stale_revision"
+    if code == "STALE_AUTHORITY":
+        return "stale_authority"
+    if code in ("PERMISSION_DENIED", "OPERATOR_AUTHORIZATION_REQUIRED", "OBSERVATION_MUTATED", "WORKSPACE_MUTATED"):
+        return "permission"
+    if code in ("NOT_FOUND", "PROJECT_NOT_FOUND"):
+        return "not_found"
+    if code in ("USAGE", "VALIDATION_FAILED"):
+        return "usage"
+    if code.startswith("HARNESS_LAUNCH") or code == "HARNESS_INCOMPATIBLE":
+        return "launch_failed"
+    if isinstance(exc, IllegalTransition):
+        return "refused"
+    return "error"
+
+
+def scrub(value: Any) -> Any:
+    """A result with no credential-bearing key, however deep (defense in depth: the bridge also redacts)."""
+    if isinstance(value, dict):
+        return {k: scrub(v) for k, v in value.items() if k not in SECRET_KEYS}
+    if isinstance(value, list):
+        return [scrub(v) for v in value]
+    return value
+
+
+def _summary(out: Any) -> str | None:
+    if not isinstance(out, dict):
+        return None
+    parts = [f"{k}={out[k]}" for k in ("id", "work_id", "invocation", "run", "from", "to", "revision_number",
+                                        "accepted") if k in out and not isinstance(out[k], (dict, list))]
+    return ", ".join(parts) or None
+
+
+def _refs(out: Any) -> list[str]:
+    if not isinstance(out, dict):
+        return []
+    return [str(out[k]) for k in ("path", "record", "handoff_record") if isinstance(out.get(k), str)]
+
+
+@dataclass
+class Bundle:
+    """The steps of one tool call and the revision they carry forward."""
+
+    engine: Any
+    token: str
+    tool: contract.Tool
+    revision: int | None
+    steps: list[dict[str, Any]] = field(default_factory=list)
+    current: str | None = None
+    retried: bool = False
+    subject: str | None = None  # the unit a step created or acted on, for the projection of a stopped bundle
+
+    def step(self, primitive: str, fn: Callable[[int], Any], *, operation_class: str, commits: bool = True) -> Any:
+        """Run one primitive with the bundle's current expected revision; record it; carry its revision forward."""
+        if commits and self.revision is None:
+            raise UsageError(f"{self.tool.name}: expect_rev is required")
+        self.current = primitive
+        retried = False
+        try:
+            out = fn(self.revision)  # type: ignore[arg-type]
+        except StaleRevision as exc:
+            if not self.steps or operation_class == JUDGMENT_BEARING or self.retried:
+                raise
+            # Another writer committed between two of our steps: re-run this mechanical step once, re-guarded.
+            current = exc.details.get("current")
+            self.revision = current if isinstance(current, int) else self.engine.store.read()["revision"]
+            self.retried = retried = True
+            out = fn(self.revision)  # type: ignore[arg-type]
+        if commits and isinstance(out, dict) and isinstance(out.get("revision"), int):
+            self.revision = out["revision"]
+        record: dict[str, Any] = {"primitive": primitive, "operation_class": operation_class,
+                                  "revision": self.revision if commits else None, "summary": _summary(out),
+                                  "refs": _refs(out)}
+        if retried:
+            record["retried_after_stale_revision"] = True
+        self.steps.append(record)
+        self.current = None
+        return out
+
+
+@dataclass
+class Call:
+    engine: Any
+    token: str
+    args: dict[str, Any]
+    bundle: Bundle
+    run_cli: RunCli | None
+
+
+# ---------------------------------------------------------------------------------------------- the runners
+
+def _status(c: Call) -> Any:
+    return c.engine.status(c.args.get("work_id"))
+
+
+def _resume(c: Call) -> Any:
+    lead = c.engine.store.read()["lead"]  # this call holds the Lead's authority: say so (M3-D10), never the credential
+    return c.engine.resume(session={"holds": True, "generation": lead["generation"],
+                                    "session_label": lead.get("session_label")})
+
+
+def _work_show(c: Call) -> Any:
+    return c.engine.work_show(c.args["work_id"])
+
+
+def _explain(c: Call) -> Any:
+    a = c.args
+    return c.engine.dispatch_explain(a.get("work_id") or "", entrypoint=a.get("entrypoint"), role=a.get("role"),
+                                     card=a.get("card"), scope=a.get("scope") or "ticket",
+                                     invocation=a.get("invocation"))
+
+
+def _harness_status(c: Call) -> Any:
+    return c.engine.harness_status(c.args.get("invocation"))
+
+
+def _harness_wait(c: Call) -> Any:
+    runs = list(c.args["runs"])
+    if len(runs) > 1:
+        raise UsageError("waiting on several runs at once arrives with wait-any (M4-D, with the transaction outbox); "
+                         "name one run for now", runs=runs)
+    return c.engine.harness_wait(runs[0], timeout=float(c.args.get("timeout_s") or 600.0))
+
+
+def _checkpoint(c: Call) -> Any:
+    a = c.args
+    return c.bundle.step("checkpoint", lambda rev: c.engine.checkpoint(
+        token=c.token, expect_rev=rev, note=a.get("note") or "", next_action=a.get("next")),
+        operation_class=MECHANICAL)
+
+
+def _ticket_draft(c: Call) -> Any:
+    a = c.args
+    created = c.bundle.step("work.create", lambda rev: c.engine.work_create(
+        token=c.token, expect_rev=rev, kind="ticket", title=a["title"], risk_class=int(a["risk_class"]),
+        mutating=not a.get("non_mutating"), parent=a.get("parent"), depends_on=list(a.get("depends_on") or []),
+        scope_paths=list(a.get("scope") or []), goal_backwards=list(a.get("goal") or []),
+        contract=list(a.get("contract") or []), rationale=a.get("rationale"), body=a.get("body") or "",
+        card=a.get("card"), acceptance_checks=list(a.get("acceptance_checks") or []),
+        acceptance_inputs=list(a.get("acceptance_inputs") or []),
+        class0_assertions=list(a.get("class0_assert") or [])), operation_class=JUDGMENT_BEARING)
+    wid = created["id"]
+    c.bundle.subject = wid
+    out: dict[str, Any] = {"work_id": wid, "record": created.get("record") or created.get("path"), "plan": None}
+    plan = a.get("plan")
+    if plan:
+        assurance = plan["assurance"]
+        proposed = c.bundle.step("plan.propose", lambda rev: c.engine.plan_propose(
+            token=c.token, expect_rev=rev, work_id=wid, body=plan["body"], reason=plan.get("reason"),
+            affected_paths=list(plan.get("affected") or []) or None,
+            review=list(assurance.get("review") or []) if isinstance(assurance, dict) else None,
+            verify=list(assurance.get("verify") or []) if isinstance(assurance, dict) else None,
+            no_assurance=assurance == "none"), operation_class=JUDGMENT_BEARING)
+        out["plan"] = {"revision_number": proposed.get("revision_number"), "path": proposed.get("path"),
+                       "accepted": False}
+    return out
+
+
+def _execution(a: dict[str, Any]) -> dict[str, Any] | None:
+    chosen = {k: v for k, v in (a.get("execution") or {}).items() if v is not None}
+    return chosen or None
+
+
+def _ticket_start(c: Call) -> Any:
+    a, wid = c.args, c.args["work_id"]
+    assigned = c.bundle.step("work.assign", lambda rev: c.engine.work_assign(
+        token=c.token, expect_rev=rev, work_id=wid, execution_profile=_execution(a), launch=True),
+        operation_class=POLICY_RESOLVED)
+    launched = c.bundle.step("dispatch.launch", lambda rev: c.engine.launch_dispatched(assigned),
+                             operation_class=MECHANICAL, commits=False)
+    c.bundle.step("work.transition", lambda rev: c.engine.work_transition(
+        token=c.token, expect_rev=rev, work_id=wid, to="RUNNING"), operation_class=MECHANICAL)
+    return {"work_id": wid, "invocation": assigned.get("invocation"), "run": (launched.get("launch") or {}).get("run"),
+            "workspace": assigned.get("workspace"), "state": "RUNNING"}
+
+
+def _launch_role(c: Call, wid: str, role: str) -> dict[str, Any]:
+    """Dispatch the policy's default card of ``role`` for the Ticket and launch its run (custody to the supervisor)."""
+    created = c.bundle.step("invoke.create.mutating", lambda rev: c.engine.invoke_create(
+        token=c.token, expect_rev=rev, work_id=wid, role=role, scope="ticket", execution_profile=_execution(c.args),
+        launch=True), operation_class=POLICY_RESOLVED)
+    launched = c.bundle.step("dispatch.launch", lambda rev: c.engine.launch_dispatched(created),
+                             operation_class=MECHANICAL, commits=False)
+    return {"invocation": created.get("invocation"), "run": (launched.get("launch") or {}).get("run"), "role": role}
+
+
+def _ticket_request_review(c: Call) -> Any:
+    wid = c.args["work_id"]
+    c.bundle.step("work.transition", lambda rev: c.engine.work_transition(
+        token=c.token, expect_rev=rev, work_id=wid, to="REVIEW_PENDING"), operation_class=MECHANICAL)
+    return {"work_id": wid, "state": "REVIEW_PENDING", "launched": [_launch_role(c, wid, "reviewer")]}
+
+
+def _ticket_request_verification(c: Call) -> Any:
+    a, wid = c.args, c.args["work_id"]
+    ingested = c.bundle.step("review.ingest", lambda rev: c.engine.review_ingest(
+        token=c.token, expect_rev=rev, work_id=wid, evidence_id=a["review_evidence"]),
+        operation_class=JUDGMENT_BEARING)
+    c.bundle.step("work.transition", lambda rev: c.engine.work_transition(
+        token=c.token, expect_rev=rev, work_id=wid, to="VERIFY_PENDING"), operation_class=MECHANICAL)
+    return {"work_id": wid, "state": "VERIFY_PENDING", "review": scrub(ingested),
+            "launched": [_launch_role(c, wid, "verifier")]}
+
+
+def _cli(c: Call) -> Any:
+    if c.run_cli is None:
+        raise UsageError("the cli tool needs a Lead session or an operator shell to run commands in")
+    reply = c.run_cli([str(x) for x in c.args["argv"]], str(c.args.get("stdin") or ""))
+    return reply.get("result") if isinstance(reply, dict) else reply
+
+
+RUNNERS: dict[str, Callable[[Call], Any]] = {
+    "status": _status, "resume": _resume, "work_show": _work_show, "explain": _explain,
+    "harness_status": _harness_status, "harness_wait": _harness_wait, "checkpoint": _checkpoint,
+    "ticket_draft": _ticket_draft, "ticket_start": _ticket_start, "ticket_request_review": _ticket_request_review,
+    "ticket_request_verification": _ticket_request_verification, "cli": _cli,
+}
+
+
+# ---------------------------------------------------------------------------------------------- the entry point
+
+def validate_arguments(t: contract.Tool, arguments: dict[str, Any]) -> None:
+    errors = sorted(Draft202012Validator(t.input_schema).iter_errors(arguments), key=lambda e: list(e.absolute_path))
+    if errors:
+        raise ValidationFailed(f"{t.name}: arguments do not match the tool's schema",
+                               violations=[f"{'/'.join(map(str, e.absolute_path)) or '<root>'}: {e.message}"
+                                           for e in errors[:20]])
+
+
+def run_tool(engine: Any, token: str, name: str, arguments: dict[str, Any], *,
+             run_cli: RunCli | None = None) -> dict[str, Any]:
+    """Run ``name`` with ``arguments`` as the Lead ``token`` authenticates; always a ``StageResult``.
+
+    Every refusal the engine makes, and every argument error, is a tool **outcome** (``ok: false``, ``stopped``):
+    the caller reads what happened and what is open now. Only a bug raises."""
+    t = contract.TOOLS.get(name)
+    if t is None:
+        raise UsageError(f"unknown tool {name!r}", offered=[x.name for x in contract.exposed()])
+    if t.status != contract.BUILT:
+        raise UsageError(f"tool {name!r} is in the contract but not built yet; see its `cli` path in the projection",
+                         offered=[x.name for x in contract.exposed()])
+    arguments = copy.deepcopy(arguments)
+    bundle = Bundle(engine, token, t, arguments.get("expect_rev") if isinstance(arguments.get("expect_rev"), int)
+                    else None)
+    payload: Any = None
+    stopped: dict[str, Any] | None = None
+    try:
+        validate_arguments(t, arguments)
+        payload = RUNNERS[name](Call(engine, token, arguments, bundle, run_cli))
+    except AEWError as exc:
+        stopped = {"at": bundle.current or name, "boundary": boundary_of(exc), "error": exc.to_dict()}
+    state = engine.store.read()
+    subject = arguments.get("work_id") if isinstance(arguments.get("work_id"), str) else None
+    if subject is None and isinstance(payload, dict) and isinstance(payload.get("work_id"), str):
+        subject = payload["work_id"]
+    if subject is None:
+        subject = bundle.subject
+    result = {
+        "ok": stopped is None, "surface": contract.SURFACE_VERSION, "tool": name,
+        "revision": state["revision"], "generation": (state.get("lead") or {}).get("generation"),
+        "completed_steps": bundle.steps, "stopped": stopped, "result": scrub(payload),
+        "projection": projection(engine, subject),
+    }
+    validate_schema("surface", result, source=f"tool {name}")  # our own contract, checked on every call
+    return result
