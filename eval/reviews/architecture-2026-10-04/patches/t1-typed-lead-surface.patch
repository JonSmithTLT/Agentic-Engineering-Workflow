index 0000000..e5a20d4
--- /dev/null
+++ b/src/aew/surface/contract.py
@@ -0,0 +1,231 @@
+"""The typed Lead surface, below any transport (F15 v0.4 §5, §12, §15; architecture review G2, thread T1).
+
+One catalog states every tool the Lead may be offered: what it does, the exact JSON Schema of its arguments, the
+engine primitives it expands to, the judgment inputs it carries and its operation class (``aew.engine.primitives``).
+Every transport is an adapter over this catalog and over :mod:`aew.surface.run`: the MCP server (``aew lead mcp``)
+and the CLI (``aew lead tool``) call the same runner, so neither is a second state authority (WC §15.6, invariant
+21) and neither carries semantics the other lacks. The catalog is data: a conformance test enumerates it against the
+dispatch registry, and the tool list a model sees is rendered from it.
+
+A tool's result is a ``StageResult`` (``schemas/surface.schema.json``): the revision after the call, the primitive
+steps that completed, where and why a bundle stopped, the tool's own payload, and the ``ActionProjection`` of what
+can happen next, so a Lead never reads the state between steps to learn the revision or the next action.
+
+Classification (v0.4 §3): a stage's class is the class of the judgment it stands for. A stage whose primitives are
+judgment-bearing is offered only when every judgment it needs is an explicit argument (``required_judgments`` names
+them); the engine still refuses at each step, so the catalog never widens what a primitive allows.
+"""
+
+from __future__ import annotations
+
+from typing import Any, NamedTuple
+
+from aew.engine.dispatch import ENTRYPOINTS
+from aew.engine.primitives import JUDGMENT_BEARING, MECHANICAL, POLICY_RESOLVED
+
+SERVER_NAME = "aew"  # the MCP server's name: OpenCode exposes its tools as ``aew_<name>``
+SURFACE_VERSION = "aew/surface/v1"
+
+QUERY = "query"  # reads committed state; never commits
+STAGE = "stage"  # a guarded sequence of primitives for one Lead judgment (v0.4 §5, surface A)
+PRIMITIVE = "primitive"  # the recovery surface (v0.4 §5, surface B): one existing command
+WAIT = "wait"  # blocks on local run telemetry; never commits
+KINDS = (QUERY, STAGE, PRIMITIVE, WAIT)
+
+BUILT = "built"  # exposed to every transport
+DESIGNED = "designed"  # in the contract, not yet implemented: never listed to a model, refused if called
+
+
+class Tool(NamedTuple):
+    name: str
+    kind: str
+    operation_class: str
+    description: str
+    input_schema: dict[str, Any]
+    expands_to: tuple[str, ...] = ()  # primitive ids or transaction ops, in the order the stage runs them
+    required_judgments: tuple[str, ...] = ()  # judgment inputs the arguments must carry (v0.4 §4)
+    dispatches: bool = False  # creates an invocation or a run: always with the run's supervisor taking custody
+    mutates: bool = False
+    status: str = BUILT
+
+    @property
+    def read_only(self) -> bool:
+        return not self.mutates
+
+
+# ---------------------------------------------------------------------------------------------- schema pieces
+
+def _obj(properties: dict[str, Any], required: tuple[str, ...] = ()) -> dict[str, Any]:
+    out: dict[str, Any] = {"type": "object", "properties": properties, "additionalProperties": False}
+    if required:
+        out["required"] = list(required)
+    return out
+
+
+def _strings(description: str, *, min_items: int = 0) -> dict[str, Any]:
+    out: dict[str, Any] = {"type": "array", "items": {"type": "string", "minLength": 1}, "description": description}
+    if min_items:
+        out["minItems"] = min_items
+    return out
+
+
+EXPECT_REV = {"type": "integer", "minimum": 0,
+              "description": "the control revision this decision is based on: the `revision` of your last result. "
+                             "If the state moved since, the call is refused (STALE_REVISION) and nothing changes."}
+WORK_ID = {"type": "string", "pattern": "^[A-Z]+-[0-9]+$", "description": "a work unit id, e.g. T-0012"}
+TEXT = {"type": "string", "description": "free text; it is stored as given, no shell ever sees it"}
+EXECUTION = _obj({
+    "profile": {"type": "string", "description": "an execution profile from policy/execution.yaml"},
+    "model": {"type": "string", "description": "PROVIDER/MODEL to pin instead of a profile"},
+    "effort": {"type": "string", "description": "reasoning-effort variant"},
+})
+EXECUTION["description"] = ("Lead override of the execution policy for the invocation this creates (ADR-0010); "
+                            "omit to route by policy")
+ASSURANCE = {
+    "description": "the plan's assurance: the string 'none', or the review and verification cards that become "
+                   "required gates",
+    "oneOf": [
+        {"const": "none"},
+        _obj({"review": _strings("review cards"), "verify": _strings("verification cards")}),
+    ],
+}
+PLAN = _obj({
+    "body": {**TEXT, "description": "the plan, Markdown"},
+    "affected": _strings("paths the plan changes (plan lint checks them against the scope)"),
+    "assurance": ASSURANCE,
+    "reason": TEXT,
+}, ("body", "assurance"))
+PLAN["description"] = "a proposed plan revision for the new Ticket; it is proposed, never accepted, by this stage"
+
+
+# ---------------------------------------------------------------------------------------------- the catalog
+
+def _catalog(*tools: Tool) -> dict[str, Tool]:
+    out: dict[str, Tool] = {}
+    for t in tools:
+        if t.kind not in KINDS or t.operation_class not in (MECHANICAL, POLICY_RESOLVED, JUDGMENT_BEARING):
+            raise ValueError(f"tool {t.name}: unknown kind or class")
+        if t.name in out:
+            raise ValueError(f"tool {t.name} is declared twice")
+        out[t.name] = t
+    return out
+
+
+TOOLS: dict[str, Tool] = _catalog(
+    # ---- queries: committed state, read without a lock being held across the call
+    Tool("status", QUERY, MECHANICAL,
+         "AEW status: the project (Lead, work graph, runs, next actions) or one work unit's control record.",
+         _obj({"work_id": WORK_ID})),
+    Tool("resume", QUERY, MECHANICAL,
+         "Rebuild the Lead's context from durable state: objective, active work, in-flight runs, contradictions, "
+         "next actions. Run it first after any restart.",
+         _obj({})),
+    Tool("work_show", QUERY, MECHANICAL, "One work unit: its record, plans, evidence, gates and integration.",
+         _obj({"work_id": WORK_ID}, ("work_id",))),
+    Tool("explain", QUERY, MECHANICAL,
+         "The dispatch decision a dispatch would get now (allowed or not, every blocking condition and obligation), "
+         "from the same predicate the dispatch itself uses. Query equals execution.",
+         _obj({"work_id": WORK_ID,
+               "entrypoint": {"type": "string", "enum": sorted(e for e in ENTRYPOINTS if e != "lead_broker.relay"),
+                              "description": "which dispatch; default: the unit's next one"},
+               "role": {"type": "string"}, "card": {"type": "string"},
+               "scope": {"type": "string", "enum": ["ticket", "integration", "observation", "parent"]},
+               "invocation": {"type": "string", "description": "explain a harness launch of this invocation"}})),
+    Tool("harness_status", QUERY, MECHANICAL, "Harness runs: status, heartbeat, evidence produced, next action.",
+         _obj({"invocation": {"type": "string"}})),
+    # ---- waiting: local telemetry, no commit
+    Tool("harness_wait", WAIT, MECHANICAL,
+         "Block until one of the named runs is no longer running, then return its status, its evidence and the next "
+         "action. One blocking call replaces polling in slices.",
+         _obj({"runs": {**_strings("run ids, e.g. R-INV-0003-1", min_items=1), "maxItems": 16},
+               "timeout_s": {"type": "number", "minimum": 1, "maximum": 3600, "default": 600}}, ("runs",))),
+    # ---- stages: one Lead judgment, the mechanics it implies (v0.4 §5, surface A)
+    Tool("checkpoint", STAGE, MECHANICAL,
+         "Record a checkpoint note and the Lead's next intended action (for a handoff or before a pause).",
+         _obj({"expect_rev": EXPECT_REV, "note": TEXT, "next": {**TEXT, "description": "the next intended action"}},
+              ("expect_rev",)),
+         expands_to=("checkpoint",), mutates=True),
+    Tool("ticket_draft", STAGE, JUDGMENT_BEARING,
+         "Create a Ticket from your proposition (title, risk class, scope, goals, contract) and, if given, propose "
+         "its plan. The plan is proposed, not accepted: accept it with cli ['plan','accept',...] after inspection.",
+         _obj({"expect_rev": EXPECT_REV,
+               "title": {"type": "string", "minLength": 1},
+               "risk_class": {"type": "integer", "minimum": 0, "maximum": 4,
+                              "description": "by the guide's class definitions"},
+               "scope": _strings("allowed change path globs, e.g. ['src/**', 'tests/**']"),
+               "goal": _strings("goal-backwards acceptance criteria"),
+               "contract": _strings("contract or conformance criteria"),
+               "non_mutating": {"type": "boolean", "description": "an evidence-only Ticket (changes no source)"},
+               "parent": WORK_ID,
+               "depends_on": _strings("ID or ID:mutating|evidence"),
+               "rationale": TEXT, "body": {**TEXT, "description": "objective/body, Markdown"},
+               "card": {"type": "string", "description": "the role card that executes it"},
+               "acceptance_checks": _strings("project checks that decide acceptance"),
+               "acceptance_inputs": _strings("acceptance input globs"),
+               "class0_assert": {"type": "array", "items": {"type": "string", "enum": [
+                   "transformation_clear", "inputs_complete", "no_consequential_boundary"]}},
+               "plan": PLAN},
+              ("expect_rev", "title", "risk_class")),
+         expands_to=("work.create", "plan.propose"), required_judgments=("ticket_proposition", "plan_proposal"),
+         mutates=True),
+    Tool("ticket_start", STAGE, POLICY_RESOLVED,
+         "Start an accepted, READY mutating Ticket: assign an implementer by policy, launch its run (the run's "
+         "supervisor holds the credential) and move the Ticket to RUNNING once custody is acknowledged.",
+         _obj({"expect_rev": EXPECT_REV, "work_id": WORK_ID, "execution": EXECUTION}, ("expect_rev", "work_id")),
+         expands_to=("work.assign", "dispatch.launch", "work.transition"), dispatches=True, mutates=True),
+    Tool("ticket_request_review", STAGE, POLICY_RESOLVED,
+         "Submit a RUNNING Ticket's implementation for independent review: move it to REVIEW_PENDING (the current "
+         "implementation report and checks are required) and launch the reviewer the policy names.",
+         _obj({"expect_rev": EXPECT_REV, "work_id": WORK_ID, "execution": EXECUTION}, ("expect_rev", "work_id")),
+         expands_to=("work.transition", "invoke.create.mutating", "dispatch.launch"), dispatches=True, mutates=True),
+    Tool("ticket_request_verification", STAGE, JUDGMENT_BEARING,
+         "Accept an inspected, passing review report and request verification: ingest exactly that report, move the "
+         "Ticket to VERIFY_PENDING and launch the verifier the policy names. A failed or pending review stops here.",
+         _obj({"expect_rev": EXPECT_REV, "work_id": WORK_ID,
+               "review_evidence": {"type": "string",
+                                   "description": "the review report you inspected (its evidence id)"},
+               "execution": EXECUTION},
+              ("expect_rev", "work_id", "review_evidence")),
+         expands_to=("review.ingest", "work.transition", "invoke.create.mutating", "dispatch.launch"),
+         required_judgments=("accept_review_evidence",), dispatches=True, mutates=True),
+    Tool("ticket_prepare", STAGE, JUDGMENT_BEARING,
+         "Accept an inspected, passing verification and prepare the integration candidate, launching the "
+         "post-integration verifier if policy requires one. Publication stays a separate decision.",
+         _obj({"expect_rev": EXPECT_REV, "work_id": WORK_ID,
+               "verification_evidence": {"type": "string"}, "execution": EXECUTION},
+              ("expect_rev", "work_id", "verification_evidence")),
+         expands_to=("verify.ingest", "work.transition", "integrate.prepare", "invoke.create.mutating",
+                     "dispatch.launch"),
+         required_judgments=("accept_verification",), dispatches=True, mutates=True, status=DESIGNED),
+    # ---- the primitive surface (v0.4 §5, surface B): every `aew` command, as data
+    Tool("cli", PRIMITIVE, JUDGMENT_BEARING,
+         "Run one `aew` command with its arguments as a list (never a shell): the recovery and expert surface. Lead "
+         "authentication is supplied by the session; never pass --token. Use a stage when one applies.",
+         _obj({"argv": _strings("the command and its arguments, e.g. ['plan','accept','T-0001','--revision','1',"
+                                "'--expect-rev','12']", min_items=1),
+               "stdin": {"type": "string", "description": "text for an argument given as '-'"}},
+              ("argv",)),
+         required_judgments=("undeclared",), mutates=True),
+)
+
+
+def exposed() -> list[Tool]:
+    """The tools a transport offers: built ones, in catalog order."""
+    return [t for t in TOOLS.values() if t.status == BUILT]
+
+
+def tool(name: str) -> Tool:
+    """The named tool, or ``KeyError``."""
+    return TOOLS[name]
+
+
+def mcp_tool(t: Tool, output_schema: dict[str, Any] | None = None) -> dict[str, Any]:
+    """One entry of an MCP ``tools/list`` result."""
+    out: dict[str, Any] = {
+        "name": t.name, "description": t.description, "inputSchema": t.input_schema,
+        "annotations": {"title": t.name.replace("_", " "), "readOnlyHint": t.read_only,
+                        "destructiveHint": False, "idempotentHint": t.kind in (QUERY, WAIT), "openWorldHint": False},
+    }
+    if output_schema is not None:
+        out["outputSchema"] = output_schema
+    return out
