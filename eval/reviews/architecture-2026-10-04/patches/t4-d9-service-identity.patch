+def service_violations(state: dict[str, Any]) -> list[str]:
+    """Rule 30 (ADR-0013 D9): a service principal holds at most one live credential; a service credential names
+    its service and family and carries no Lead generation; a transition a service committed is in its family."""
+    problems: list[str] = []
+    live: dict[str, list[str]] = {}
+    for tid, rec in state["tokens"].items():
+        if rec["kind"] != "service":
+            continue
+        scope = rec["scope"]
+        if not scope.get("service") or not scope.get("family"):
+            problems.append(f"service credential {tid} names no service or family: {scope}")
+        if "generation" in scope:
+            problems.append(f"service credential {tid} is bound to a Lead generation")
+        if rec["revoked_at"] is None:
+            live.setdefault(scope.get("service", "?"), []).append(tid)
+    for service, tids in live.items():
+        if len(tids) > 1:
+            problems.append(f"{service} holds {len(tids)} live credentials: {sorted(tids)}")
+    last = state.get("last_transition") or {}
+    actor = last.get("actor") or {}
+    if actor.get("kind") == "service" and not str(last.get("op", "")).startswith(f"{actor.get('family')}."):
+        problems.append(f"a service committed {last.get('op')}, outside its {actor.get('family')} family")
