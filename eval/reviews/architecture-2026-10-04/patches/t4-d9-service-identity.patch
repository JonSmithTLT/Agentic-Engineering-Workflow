diff --git a/tests/integration/test_service_identity.py b/tests/integration/test_service_identity.py
new file mode 100644
index 0000000..e50490b
--- /dev/null
+++ b/tests/integration/test_service_identity.py
@@ -0,0 +1,276 @@
+"""ADR-0013 D9 spike: one non-Lead service principal with a tiny, durable mutation authority, without a second Lead.
+
+`knowledge_service` holds its own credential kind, may commit only the `knowledge.*` family, is refused everywhere
+else, is bounded by the control store at commit (not only by the command layer), survives Lead handoff and takeover,
+and its secret reaches no file, output or agent environment.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent / "helpers"))
+sys.path.insert(0, str(HERE))
+
+from conftest import clean_env, run_aew  # noqa: E402
+from invariants import assert_control_invariants, load_control  # noqa: E402
+
+from aew.cli.main import build_parser  # noqa: E402
+from aew.engine.api import Engine  # noqa: E402
+from aew.engine.authority import issue_token  # noqa: E402
+from aew.engine.store import TXN_DIR, Transition, serialize_control  # noqa: E402
+from aew.errors import ClosureViolation, PermissionDenied  # noqa: E402
+from aew.harness import agentenv, lead_broker  # noqa: E402
+
+CASE = {
+    "template": "attempt-outcome/v1",
+    "title": "unit check failed, then passed after the fixture was regenerated",
+    "subject_refs": ["T-0001"],
+    "root_evidence_bindings": [{"evidence_id": "INV-0001-impl-1", "relation": "derived_from",
+                                "basis": "literal_outcome"}],
+    "observed_conditions": {"platform": "windows"},
+    "fields": {"condition": "check unit failed on attempt 1", "result": "check unit passed"},
+    "source_classes": {"condition": "ENGINE_OBSERVED_WEAK_BOUNDARY", "result": "ENGINE_OBSERVED_WEAK_BOUNDARY"},
+}
+SERVICE_ACTOR_KEYS = {"kind", "service", "family", "token_id"}
+
+
+def issue(p):
+    return p.lead("service", "issue", "knowledge_service")
+
+
+def case_as(p, token: str, *extra: str):
+    return p.aew("knowledge", "case", "--file", "-", *extra, "--token", token, "--expect-rev", str(p.rev()),
+                 input=json.dumps(CASE))
+
+
+# ------------------------------------------------------------------------------------- the principal's lifecycle
+
+def test_the_lead_issues_rotates_and_revokes_the_service_credential(project):
+    p = project
+    first = issue(p)
+    assert first["family"] == "knowledge" and first["rotated"] is None and first["token"].startswith("aew1.")
+    shown = p.ok("service", "show")
+    assert first["token"] not in json.dumps(shown)  # the secret is printed once, to the Lead, and never again
+    entry = shown["services"]["knowledge_service"]
+    assert entry == {"family": "knowledge", "token_id": first["token_id"], "issued_at": entry["issued_at"],
+                     "issued_by_generation": 1, "credentials_ever": 1}
+    second = issue(p)  # rotation is re-issuance: the old credential dies in the same commit
+    assert second["rotated"] == first["token_id"]
+    tokens = load_control(p.root)["tokens"]
+    assert tokens[first["token_id"]]["revoke_reason"] == "rotated by the Lead"
+    scope = tokens[second["token_id"]]["scope"]
+    assert scope["service"] == "knowledge_service" and scope["family"] == "knowledge"
+    assert scope["issued_by"]["kind"] == "lead" and scope["issued_by"]["generation"] == 1
+    assert "generation" not in scope  # no Lead authority to supersede
+    assert case_as(p, first["token"]).error["code"] == "STALE_AUTHORITY"
+    p.lead("service", "revoke", "knowledge_service", "--reason", "done")
+    assert p.ok("service", "show")["services"]["knowledge_service"]["token_id"] is None
+    assert case_as(p, second["token"]).error["code"] == "STALE_AUTHORITY"
+    res = p.aew("service", "revoke", "knowledge_service", "--token", p.token, "--expect-rev", str(p.rev()))
+    assert res.error["code"] == "NOT_FOUND"
+    res = p.aew("service", "issue", "payroll_service", "--token", p.token, "--expect-rev", str(p.rev()))
+    assert res.error["code"] == "USAGE"
+    assert_control_invariants(p)
+
+
+# ------------------------------------------------------------------------------------- the family it may commit
+
+def test_the_service_commits_the_knowledge_family_and_changes_nothing_else(project):
+    p = project
+    tok = issue(p)["token"]
+    before = load_control(p.root)
+    res = case_as(p, tok)
+    assert res.returncode == 0, res.stderr
+    assert res.json["actor"] == "service" and res.json["id"] == "K-0001"
+    after = load_control(p.root)
+    assert after["last_transition"]["actor"] == {"kind": "service", "service": "knowledge_service",
+                                                 "family": "knowledge", "token_id": tok.split(".")[1]}
+    assert after["last_transition"]["op"] == "knowledge.capture"
+    changed = {k for k in set(before) | set(after) if before.get(k) != after.get(k)}
+    assert changed <= {"revision", "counters", "knowledge", "cold", "last_transition",
+                       "recent", "archived_refs", "retained_workspaces", "retired_observations"}
+    for key in ("work", "invocations", "tokens", "lead"):
+        assert after[key] == before[key], key
+    assert {k for k in after["counters"] if after["counters"][k] != before["counters"].get(k)} == {
+        "knowledge", "disposition", "receipt"}
+    # the credential travels like the Lead's: in the environment of its own process, never on the command line
+    env = {**clean_env(), "AEW_SERVICE_TOKEN": tok}
+    d = run_aew("-C", str(p.root), "knowledge", "dispose", "K-0001", "--rel", "serving_hold", "--object", "AU-0001",
+                "--expect-rev", str(p.rev()), env=env)
+    assert d.returncode == 0, d.stderr
+    assert d.json["actor"] == "service"
+    assert p.ok("knowledge", "show", "K-0001")["state"]["serving_hold"] is True
+    # the Lead keeps the same surface
+    assert case_as(p, p.token).json["actor"] == "lead"
+    assert p.ok("history", "audit", "--full")["ok"]
+    assert_control_invariants(p)
+
+
+def test_the_service_credential_is_refused_everywhere_outside_its_family(project):
+    p = project
+    tok = issue(p)["token"]
+    rev = p.rev()
+    control = p.root / ".aew/state/control.yaml"
+    before = control.read_bytes()
+    attempts = [("work", "create", "ticket", "--title", "x", "--class", "1"), ("manifest", "adopt", "--reason", "x"),
+                ("service", "issue", "knowledge_service"), ("service", "revoke", "knowledge_service"),
+                ("history", "audit", "--full")]
+    for args in attempts:
+        res = p.aew(*args, "--token", tok, "--expect-rev", str(rev))
+        assert res.error["code"] == "PERMISSION_DENIED", (args, res.stdout, res.stderr)
+        assert "requires the Lead credential" in (res.stderr + res.stdout), args
+    # nor is it an invocation credential: the role surface refuses it as well
+    res = run_aew("-C", str(p.root), "whoami", env={**clean_env(), "AEW_INVOCATION_TOKEN": tok})
+    assert res.error["code"] == "PERMISSION_DENIED"
+    assert control.read_bytes() == before  # nothing was committed, nothing changed
+    assert_control_invariants(p)
+
+
+# ------------------------------------------------------------------------------------- the store's own check
+
+def test_closure_is_enforced_by_the_store_at_commit_whatever_layer_asked(project):
+    p = project
+    tok = issue(p)["token"]
+    eng = Engine.discover(p.root)
+    control = p.root / ".aew/state/control.yaml"
+    before = control.read_bytes()
+    txn_dir = p.root / ".aew" / TXN_DIR
+    staged_before = sorted(x.name for x in txn_dir.iterdir()) if txn_dir.exists() else []
+
+    def attempt(mutate, op: str = "knowledge.capture") -> str:
+        with pytest.raises(ClosureViolation) as e:
+            with eng.service_txn(tok, p.rev(), op, family="knowledge") as ctx:
+                mutate(ctx)
+        return str(e.value)
+
+    # every mutation outside the family is refused before the commit touches disk
+    assert "work changed" in attempt(lambda c: c.state["work"].__setitem__("T-0099", {"state": "PLANNED",
+                                                                                      "kind": "ticket"}))
+    assert "lead changed" in attempt(lambda c: c.state["lead"].__setitem__("generation", 99))
+    assert "tokens changed" in attempt(lambda c: issue_token(c.state, "lead", {"generation": 1}))
+    assert "tokens changed" in attempt(lambda c: c.state["tokens"].__delitem__(tok.split(".")[1]))
+    assert "counters.work changed" in attempt(lambda c: c.state["counters"].__setitem__("work", 42))
+    assert "record write outside" in attempt(lambda c: c.session.write("state/evil.yaml", "x: 1\n"))
+    assert "record write outside" in attempt(lambda c: c.session.write("evidence/T-0001/x.yaml", "x: 1\n"))
+    assert control.read_bytes() == before
+    assert (sorted(x.name for x in txn_dir.iterdir()) if txn_dir.exists() else []) == staged_before
+    # the positive control: the family's own keys commit
+    with eng.service_txn(tok, p.rev(), "knowledge.capture", family="knowledge") as ctx:
+        ctx.state["knowledge"]["pending_overflow"] = 1
+        ctx.state["counters"]["receipt"] += 1
+    assert load_control(p.root)["knowledge"]["pending_overflow"] == 1
+    rev = p.rev()
+    # an op outside the family is refused by the kernel...
+    with pytest.raises(PermissionDenied):
+        with eng.service_txn(tok, rev, "work.create", family="knowledge"):
+            pass
+    # ...and, when the kernel is bypassed, by the store: a service actor cannot commit a Lead change, an op outside
+    # its family, or without a family at all
+    store = eng.store
+    service = {"kind": "service", "service": "knowledge_service", "family": "knowledge", "token_id": "tk_x"}
+    with pytest.raises(ClosureViolation, match="counters.work changed"):
+        with store.session() as s:
+            s.state["counters"]["work"] = 7
+            s.commit(Transition(op="knowledge.capture", actor=service))
+    with pytest.raises(ClosureViolation, match="invocations changed"):  # (the dispatch finalizer guards this too)
+        with store.session() as s:
+            s.state["invocations"]["INV-9999"] = {"role": "implementer", "work_unit": "T-0001", "status": "active"}
+            s.commit(Transition(op="knowledge.capture", actor=service))
+    with pytest.raises(ClosureViolation, match="outside the knowledge"):
+        with store.session() as s:
+            s.commit(Transition(op="work.create", actor=service))
+    with pytest.raises(ClosureViolation, match="known closed family"):
+        with store.session() as s:
+            s.commit(Transition(op="knowledge.capture", actor={"kind": "service"}))
+    with pytest.raises(ClosureViolation, match="known closed family"):
+        with store.session() as s:
+            s.commit(Transition(op="payroll.pay", actor={"kind": "service", "family": "payroll"}))
+    assert p.rev() == rev
+    assert_control_invariants(p)
+
