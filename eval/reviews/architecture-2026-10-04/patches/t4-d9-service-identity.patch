diff --git a/src/aew/engine/service_ops.py b/src/aew/engine/service_ops.py
new file mode 100644
index 0000000..afc7758
--- /dev/null
+++ b/src/aew/engine/service_ops.py
@@ -0,0 +1,67 @@
+"""Service principals (ADR-0013 D9 spike): a project-scoped identity with its own credential kind, issued and revoked by
+the Lead, bound to one closed transaction family, independent of the Lead generation.
+
+The Lead issues the credential once (``aew service issue knowledge_service``), hands it to the service's own process
+the way its own credential travels (environment of the operator's shell, or in memory), and may rotate or revoke it
+at any time. A Lead handoff or takeover revokes every Lead credential and advances the generation; it leaves service
+credentials alone, because a service holds no Lead authority to supersede (``require_service`` checks no generation).
+The new Lead may revoke them.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from aew.engine.authority import SERVICE_FAMILIES, issue_service_token, revoke, service_token_id
+from aew.errors import NotFound, UsageError
+
+if TYPE_CHECKING:
+    from aew.engine.base import Kernel
+
+
+class Services:
+    def __init__(self, k: Kernel) -> None:
+        self.k = k
+
+    @staticmethod
+    def _known(service: str) -> str:
+        if service not in SERVICE_FAMILIES:
+            raise UsageError(f"unknown service {service!r}; known: {', '.join(sorted(SERVICE_FAMILIES))}")
+        return SERVICE_FAMILIES[service]
+
+    def service_issue(self, *, token: str, expect_rev: int, service: str, reason: str | None = None) -> dict[str, Any]:
+        """Issue (or rotate) the service's credential: a Lead transition. The secret is returned once and never
+        stored; a previous credential is revoked in the same commit."""
+        family = self._known(service)
+        with self.k.lead_txn(token, expect_rev, "service.issue", reason=reason) as ctx:
+            previous = service_token_id(ctx.state, service)
+            secret = issue_service_token(ctx.state, service, ctx.actor)
+            ctx.summary = f"service credential {'rotated' if previous else 'issued'}: {service} ({family}.*)"
+        return {"ok": True, "service": service, "family": family, "token": secret, "token_id": secret.split(".")[1],
+                "rotated": previous, "revision": ctx.session.committed_revision}
+
+    def service_revoke(self, *, token: str, expect_rev: int, service: str, reason: str | None = None) -> dict[str, Any]:
+        self._known(service)
+        with self.k.lead_txn(token, expect_rev, "service.revoke", reason=reason) as ctx:
+            current = service_token_id(ctx.state, service)
+            if current is None:
+                raise NotFound(f"{service} holds no credential")
+            revoke(ctx.state, current, reason or "revoked by the Lead")
+            ctx.summary = f"service credential revoked: {service}"
+        return {"ok": True, "service": service, "token_id": current, "revision": ctx.session.committed_revision}
+
+    def service_show(self) -> dict[str, Any]:
+        """Every service principal: its family, whether it holds a credential, and that credential's issuance. Never
+        the secret, which exists only where the Lead sent it."""
+        state = self.k.store.read()
+        out: dict[str, Any] = {}
+        for service, family in sorted(SERVICE_FAMILIES.items()):
+            current = service_token_id(state, service)
+            record = state["tokens"].get(current) if current else None
+            history = sorted(t for t, r in state["tokens"].items()
+                             if r["kind"] == "service" and r["scope"].get("service") == service)
+            out[service] = {"family": family, "token_id": current,
+                            "issued_at": record["issued_at"] if record else None,
+                            "issued_by_generation": record["issued_by_generation"] if record else None,
+                            "credentials_ever": len(history)}
+        return {"services": out, "lead_generation": state["lead"]["generation"], "revision": state["revision"]}
