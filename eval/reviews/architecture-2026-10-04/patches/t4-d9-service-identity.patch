+@pytest.mark.skipif(sys.platform == "win32", reason="an operator takeover needs a controlling terminal (pty)")
+def test_operator_takeover_does_not_invalidate_the_service_principal(project):
+    from test_authority import _pty_takeover
+
+    p = project
+    tok = issue(p)["token"]
+    result = _pty_takeover(p.root, p.rev(), "lead-b")
+    assert result["generation"] == 2
+    assert case_as(p, p.token).error["code"] == "STALE_AUTHORITY"
+    assert case_as(p, tok).returncode == 0
+    p.token = result["token"]
+    p.lead("service", "revoke", "knowledge_service", "--reason", "new Lead, new service credential")
+    assert case_as(p, tok).error["code"] == "STALE_AUTHORITY"
+    assert_control_invariants(p)
+
