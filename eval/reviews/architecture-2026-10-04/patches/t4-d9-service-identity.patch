+def test_the_service_secret_reaches_no_file_output_or_agent_environment(project):
+    p = project
+    issued = issue(p)
+    tok = issued["token"]
+    secret = tok.split(".")[2]
+    assert case_as(p, tok).returncode == 0
+    for f in (p.root / ".aew").rglob("*"):
+        if f.is_file():
+            assert secret not in f.read_text(encoding="utf-8", errors="replace"), f
+    for args in (("service", "show"), ("status",), ("lead", "show"), ("knowledge", "show", "K-0001"),
+                 ("history", "list"), ("history", "show", "KR-0001")):
+        res = p.aew(*args)
+        assert secret not in (res.stdout + res.stderr), args
+    # an agent's environment is built from an allowlist: the service credential is not on it
+    env = agentenv.build({**clean_env(), "AEW_SERVICE_TOKEN": tok, "AEW_LEAD_TOKEN": p.token}, endpoint="unix:/x",
+                         key_hex="00", invocation="INV-0001", run="R-INV-0001-1", work_unit="T-0001")
+    assert "AEW_SERVICE_TOKEN" not in env and "AEW_LEAD_TOKEN" not in env
+    # the Lead broker never runs the one command that would print a service credential into a model session
+    ns = build_parser().parse_args(["service", "issue", "knowledge_service", "--expect-rev", "1"])
+    assert "credential" in (lead_broker.refuses_locally(ns) or "")
+    assert lead_broker.refuses_locally(build_parser().parse_args(["service", "show"])) is None
+    assert lead_broker.refuses_locally(build_parser().parse_args(["knowledge", "list"])) is None
+
