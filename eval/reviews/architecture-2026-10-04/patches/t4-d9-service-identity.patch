+# ------------------------------------------------------------------------------------- Lead rotation
+
+def test_lead_handoff_does_not_invalidate_the_service_principal(project):
+    p = project
+    tok = issue(p)["token"]
+    gen0 = load_control(p.root)["lead"]["generation"]
+    offer = p.lead("lead", "handoff", "offer")["offer"]
+    new = p.ok("lead", "handoff", "accept", "--offer", offer, "--expect-rev", str(p.rev()))
+    assert new["generation"] == gen0 + 1
+    old_lead, p.token = p.token, new["token"]
+    res = p.aew("manifest", "adopt", "--reason", "x", "--token", old_lead, "--expect-rev", str(p.rev()))
+    assert res.error["code"] == "STALE_AUTHORITY"  # the Lead's authority rotated...
+    res = case_as(p, tok)
+    assert res.returncode == 0 and res.json["actor"] == "service"  # ...the service's did not
+    record = load_control(p.root)["tokens"][tok.split(".")[1]]
+    assert record["revoked_at"] is None and record["issued_by_generation"] == gen0
+    assert p.ok("service", "show")["services"]["knowledge_service"]["token_id"] == tok.split(".")[1]
+    # the new Lead owns the principal: it can rotate and revoke it
+    rotated = p.lead("service", "issue", "knowledge_service")
+    assert rotated["rotated"] == tok.split(".")[1]
+    assert case_as(p, tok).error["code"] == "STALE_AUTHORITY"
+    assert case_as(p, rotated["token"]).returncode == 0
+    p.lead("service", "revoke", "knowledge_service")
+    assert case_as(p, rotated["token"]).error["code"] == "STALE_AUTHORITY"
+    assert_control_invariants(p)
+
