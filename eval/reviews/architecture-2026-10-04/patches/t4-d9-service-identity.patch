+def test_a_v1_project_refuses_a_service_commit_until_it_is_migrated(project):
+    p = project
+    tok = issue(p)["token"]
+    control = p.root / ".aew/state/control.yaml"
+    state = load_control(p.root)
+    state["schema"] = "aew/control/v1"
+    state.pop("cold")
+    state.pop("knowledge")
+    control.write_bytes(serialize_control(state))
+    assert case_as(p, tok).error["code"] == "MIGRATION_REQUIRED"
