+"""`aew service`: service principals and their credentials (ADR-0013 D9 spike). Issue and revoke are Lead actions."""
+
+from __future__ import annotations
+
+import argparse
+from typing import Any
+
+from aew.cli.commands import _add_json, _add_lead, _engine, _lead_token
+
+
+def register(sub: argparse._SubParsersAction) -> None:
+    p = sub.add_parser("service", help="service principals: issue, revoke and show their credentials")
+    ssub = p.add_subparsers(dest="service_cmd", required=True)
+
+    q = ssub.add_parser("issue", help="issue (or rotate) a service's credential; printed once, never stored (Lead)")
+    q.add_argument("service", help="the service principal, e.g. knowledge_service")
+    q.add_argument("--reason")
+    _add_lead(q)
+    _add_json(q)
+    q.set_defaults(handler=lambda a: _engine(a).service_issue(token=_lead_token(a), expect_rev=a.expect_rev,
+                                                              service=a.service, reason=a.reason))
+
+    q = ssub.add_parser("revoke", help="revoke a service's current credential (Lead)")
+    q.add_argument("service")
+    q.add_argument("--reason")
+    _add_lead(q)
+    _add_json(q)
+    q.set_defaults(handler=lambda a: _engine(a).service_revoke(token=_lead_token(a), expect_rev=a.expect_rev,
+                                                               service=a.service, reason=a.reason))
+
+    q = ssub.add_parser("show", help="every service principal and whether it holds a credential (never the secret)")
+    _add_json(q)
+    q.set_defaults(handler=_show)
+
+
+def _show(a: argparse.Namespace) -> Any:
+    return _engine(a).service_show()
