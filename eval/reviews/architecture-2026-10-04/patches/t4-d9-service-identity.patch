diff --git a/src/aew/engine/closure.py b/src/aew/engine/closure.py
new file mode 100644
index 0000000..4d1d1fc
--- /dev/null
+++ b/src/aew/engine/closure.py
@@ -0,0 +1,83 @@
+"""Closed transaction families, enforced where the control store commits (ADR-0013 D9 spike).
+
+A *service principal* (`knowledge_service`) holds a durable, tiny mutation authority: it may commit transitions of
+exactly one family (``knowledge.*``) and nothing else. The command layer routes such a credential through
+``Kernel.service_txn``; this module is the second, independent check: ``ControlStore`` refuses to commit a
+transition whose actor is a service unless the state it would write differs from the committed state only in the
+keys the family owns, its record writes stay under the family's paths, and the op carries the family's prefix.
+The check does not trust the caller: it compares the two states, so a bug or a hostile call site that reached the
+store with a Lead-only change under a service actor fails before anything touches disk.
+
+Nothing here applies to the Lead. A Lead transition has no closure; the Lead's authority is bounded by generation
+and revision (ADR-0005), not by a key list.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+
+from aew.errors import ClosureViolation
+
+
+@dataclass(frozen=True)
+class Closure:
+    family: str
+    hot_keys: frozenset[str]            # top-level control keys the family may change
+    counters: frozenset[str]            # counters it may change (``counters`` itself is always in ``hot_keys``)
+    write_prefixes: tuple[str, ...]     # record paths (relative to the AEW root) it may stage or pre-write
+
+
+# Keys the archival finalizer materializes as empty containers on the first commit that appends to the history. A
+# service commit may create them empty; it may never change them once they exist.
+MATERIALIZED = frozenset({"recent", "archived_refs", "retained_workspaces", "retired_observations"})
+
+CLOSURES: dict[str, Closure] = {
+    "knowledge": Closure(
+        family="knowledge",
+        hot_keys=frozenset({"revision", "last_transition", "counters", "knowledge", "cold"}),
+        counters=frozenset({"knowledge", "disposition", "receipt"}),
+        write_prefixes=("knowledge/", "history/"),
+    ),
+}
+
+
+def closure_for(actor: dict[str, Any]) -> Closure | None:
+    """The closure a transition's actor is bound by: none for the Lead and the operator, the family's for a service.
+    A service actor that names no known family is refused: the store never guesses an open authority."""
+    if actor.get("kind") != "service":
+        return None
+    closure = CLOSURES.get(str(actor.get("family") or ""))
+    if closure is None:
+        raise ClosureViolation(f"a service actor must name a known closed family, not {actor.get('family')!r}",
+                               family=actor.get("family"))
+    return closure
+
+
+def violations(closure: Closure, before: dict[str, Any], after: dict[str, Any], op: str,
+               write_paths: list[str]) -> list[str]:
+    problems: list[str] = []
+    if not op.startswith(closure.family + "."):
+        problems.append(f"op {op} is outside the {closure.family}.* family")
+    for key in sorted(set(before) | set(after)):
+        if before.get(key) == after.get(key) or key in closure.hot_keys:
+            continue
+        if key in MATERIALIZED and key not in before and after.get(key) in ([], {}):
+            continue
+        problems.append(f"{key} changed")
+    counters_before, counters_after = before.get("counters") or {}, after.get("counters") or {}
+    for name in sorted(set(counters_before) | set(counters_after)):
+        if counters_before.get(name) != counters_after.get(name) and name not in closure.counters:
+            problems.append(f"counters.{name} changed")
+    for path in write_paths:
+        if not path.startswith(closure.write_prefixes):
+            problems.append(f"record write outside {'/'.join(closure.write_prefixes)}: {path}")
+    return problems
+
+
+def enforce(closure: Closure, before: dict[str, Any], after: dict[str, Any], op: str,
+            write_paths: list[str]) -> None:
+    problems = violations(closure, before, after, op, write_paths)
+    if problems:
+        raise ClosureViolation(f"the {closure.family} service may not commit this transition: " + "; ".join(problems),
+                               family=closure.family, violations=problems)
