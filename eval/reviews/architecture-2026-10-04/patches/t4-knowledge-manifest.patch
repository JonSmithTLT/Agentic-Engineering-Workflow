+    def knowledge_list(self, *, kind: str | None = None, limit: int = 50) -> dict[str, Any]:
+        if kind is not None and kind not in M.KNOWLEDGE_KINDS:
+            raise UsageError(f"--kind must be one of {', '.join(M.KNOWLEDGE_KINDS)}")
+        if not 1 <= limit <= 1000:
+            raise UsageError("--limit must be between 1 and 1000")
+        state = self.k.store.read()
+        self._require_v2(state)
+        index = self._index(state)
+        items = []
+        for e in index.list(kind=kind, limit=limit) if kind else [
+                e for e in index.list(limit=limit * 4) if e["kind"] in M.KNOWLEDGE_KINDS][:limit]:
+            item = {k: e[k] for k in ("seq", "kind", "id", "at", "source") if k in e}
