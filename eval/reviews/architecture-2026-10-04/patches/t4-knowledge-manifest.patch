diff --git a/tests/integration/test_knowledge_manifest.py b/tests/integration/test_knowledge_manifest.py
new file mode 100644
index 0000000..e1a94c4
--- /dev/null
+++ b/tests/integration/test_knowledge_manifest.py
@@ -0,0 +1,212 @@
+"""Knowledge records in the history manifest (ADR-0013 draft; architecture review T4): the manifest takes the new
+kinds, the index folds dispositions and searches record bodies without vouching for them, and orphaned knowledge
+records are reported. In-process, over the deterministic history workload (``history_model``)."""
+
+from __future__ import annotations
+
+import sqlite3
+import sys
+from pathlib import Path
+
+import pytest
+
+HELPERS = Path(__file__).resolve().parents[1] / "helpers"
+sys.path.insert(0, str(HELPERS))
+
+from history_model import ROOT_REL, archive, init, read_root  # noqa: E402
+
+from aew.engine.store import Transition  # noqa: E402
+from aew.errors import ValidationFailed  # noqa: E402
+from aew.history import manifest as M  # noqa: E402
+from aew.history.index import HistoryIndex, fold_dispositions  # noqa: E402
+from aew.history.store import History, disposition_rel, knowledge_rel, receipt_rel  # noqa: E402
+from aew.schemas import validate  # noqa: E402
+from aew.util import dump_yaml  # noqa: E402
+
+AT = "2026-10-04T00:00:00Z"
+
+
+@pytest.fixture
+def store(tmp_path):
+    s = init(tmp_path)
+    archive(s, 2)
+    return s
+
+
+def case_text(n: int, unit: str, words: str) -> str:
+    return dump_yaml({"schema": "aew/knowledge/case/v1", "id": f"K-{n:04d}", "version": 1, "record_kind": "case",
+                      "template": "attempt-outcome/v1", "authority_class": "advisory", "subject_refs": [unit],
+                      "root_evidence_bindings": [{"evidence_id": f"E-{n:04d}", "relation": "derived_from",
+                                                  "basis": "literal_outcome"}],
+                      "observed_conditions": {"platform": "linux"}, "fields": {"condition": words, "result": "passed"},
+                      "source_classes": {"condition": "ENGINE_OBSERVED_WEAK_BOUNDARY", "result": "ROLE_ATTESTED"},
+                      "created_at": AT})
+
+
+def append(store, items: list[tuple[str, str, dict]]) -> dict:
+    """One commit: records then entries, as a capture job's transaction does."""
+    history = History(store.root)
+    with store.session() as s:
+        fields = []
+        for rel, text, f in items:
+            sha = history.write_record(s, rel, text)
+            fields.append({**f, "path": rel, "sha256": sha, "at": AT})
+        root = history.append(s, read_root(store.root), fields)
+        s.write(ROOT_REL, dump_yaml(root), immutable=False)
+        s.commit(Transition(op="knowledge.capture", actor={"kind": "test"}, summary="knowledge"))
+    return root
+
+
+def case_items(n: int, unit: str, words: str, rel: str = "admitted") -> list[tuple[str, str, dict]]:
+    kid, did, rid = f"K-{n:04d}", f"KD-{n:04d}", f"KR-{n:04d}"
+    return [
+        (knowledge_rel("case", kid, 1), case_text(n, unit, words),
+         {"kind": "case", "id": kid, "version": 1, "source": "model",
+          "links": {"derived_from": [f"E-{n:04d}"], "subject": [unit], "job": [rid]}}),
+        (disposition_rel(kid, 1), dump_yaml({"schema": "aew/knowledge/disposition/v1", "id": did, "subject": {"id": kid,
+                                             "version": 1}, "rel": rel, "disposition_seq": 1, "actor": {"kind": "lead"},
+                                             "at": AT}),
+         {"kind": "disposition", "id": did, "source": "engine", "subject": kid, "rel": rel,
+          "links": {rel: [f"{kid}@v1"]}}),
+        (receipt_rel(rid), dump_yaml({"schema": "aew/knowledge/receipt/v1", "id": rid, "job": {"project": "p",
+                                      "revision": 3, "event_index": 0}, "status": "COMPLETE", "produced": [kid],
+                                      "no_candidate": False, "at": AT}),
+         {"kind": "receipt", "id": rid, "source": "engine", "links": {"produced": [kid], "outbox": ["rev:3"]}}),
+    ]
+
+
+def synced(store) -> HistoryIndex:
+    index = HistoryIndex(store.root)
+    index.sync(read_root(store.root))
+    return index
+
+
+# ---------------------------------------------------------------------------------------------- the manifest
+
+def test_the_manifest_takes_knowledge_kinds_and_versions(store):
+    for kind in M.KNOWLEDGE_KINDS:
+        fields = {"kind": kind, "id": "X-1", "path": "knowledge/x.yaml", "sha256": "0" * 64, "at": AT,
+                  "source": "engine"}
+        if kind in M.CONTENT_KINDS:
+            fields["version"] = 2
+        entry = M.new_entry(1, M.GENESIS_H, fields)
+        assert entry["kind"] == kind
+    with pytest.raises(ValidationFailed):
+        M.new_entry(1, M.GENESIS_H, {"kind": "case", "id": "K-1", "path": "k.yaml", "sha256": "0" * 64, "at": AT,
+                                      "source": "engine", "version": 0})
+    with pytest.raises(ValidationFailed):
+        M.new_entry(1, M.GENESIS_H, {"kind": "memo", "id": "K-1", "path": "k.yaml", "sha256": "0" * 64, "at": AT})
+
+
+def test_the_record_schemas_accept_the_workload_records():
+    validate("knowledge-case", __import__("yaml").safe_load(case_text(1, "T-0001", "x")), source="t")
+
+
+def test_a_capture_commit_appends_verifies_and_indexes(store):
+    root = append(store, case_items(1, "T-0001", "fixture regenerated"))
+    assert root["count"] == 5  # 2 units + case + disposition + receipt
+    report = History(store.root).verify(root)
+    assert report.ok and report.records == 5
+    index = synced(store)
+    assert [e["kind"] for e in index.by_id("K-0001")] == ["case"]
+    assert index.by_id("K-0001")[0]["version"] == 1
+    assert [e["id"] for e in index.list(kind="case")] == ["K-0001"]
+    assert [e["id"] for e in index.linked("derived_from", "E-0001")] == ["K-0001"]
+    assert [e["id"] for e in index.linked("outbox", "rev:3")] == ["KR-0001"]  # the capture cursor is a receipt link
+    assert History(store.root).unreferenced(index.paths()) == []
+
+
+# ---------------------------------------------------------------------------------------------- about and the fold
+
+def test_dispositions_are_about_their_subject_and_fold_in_order(store):
+    append(store, case_items(1, "T-0001", "a", rel="held_active"))
+    history = History(store.root)
+    seq = 2
+    for rel in ("admitted", "serving_hold", "challenged", "serving_release", "superseded_by"):
+        with store.session() as s:
+            rel_path = disposition_rel("K-0001", seq)
+            sha = history.write_record(s, rel_path, dump_yaml({"schema": "aew/knowledge/disposition/v1",
+                                                                "id": f"KD-{seq:04d}", "subject": {"id": "K-0001",
+                                                                "version": 1}, "rel": rel, "disposition_seq": seq,
+                                                                "actor": {"kind": "lead"}, "at": AT}))
+            root = history.append(s, read_root(store.root), [{"kind": "disposition", "id": f"KD-{seq:04d}",
+                                                              "path": rel_path, "sha256": sha, "at": AT,
+                                                              "source": "operator", "subject": "K-0001", "rel": rel,
+                                                              "links": {rel: ["K-0002@v1" if rel == "superseded_by"
+                                                                              else "K-0001@v1"]}}])
+            s.write(ROOT_REL, dump_yaml(root), immutable=False)
+            s.commit(Transition(op="knowledge.dispose", actor={"kind": "test"}))
+        seq += 1
+    index = synced(store)
+    assert index.annotations("K-0001") == []  # annotations are a kind; dispositions another
+    about = index.about("K-0001")
+    assert [d["rel"] for d in about] == ["held_active", "admitted", "serving_hold", "challenged", "serving_release",
+                                         "superseded_by"]
+    assert [d["rel"] for d in index.about("K-0001", kinds=("disposition",))] == [d["rel"] for d in about]
+    current = index.current("K-0001")
+    assert current["version"] == 1 and current["kind"] == "case"
+    assert current["admission"] == "admitted" and current["serving_hold"] is False
+    assert current["lifecycle"] == "superseded_within_scope" and current["challenges"] == 1
+    assert current["disposition_seq"] == 6 and current["last_event_seq"] == about[-1]["seq"]
+    assert index.current("K-9999") is None
+
+
+def test_the_fold_is_a_pure_function_of_the_events():
+    assert fold_dispositions([]) == {"admission": "candidate", "serving_hold": False, "lifecycle": "active",
+                                     "challenges": 0, "disposition_seq": 0, "last_event_seq": None}
+    events = [{"seq": 1, "rel": "admitted"}, {"seq": 2, "rel": "serving_hold"}, {"seq": 3, "rel": "rejected"}]
+    assert fold_dispositions(events)["admission"] == "rejected"
+    assert fold_dispositions(events)["serving_hold"] is True
+
+
+# ---------------------------------------------------------------------------------------------- search
+
+def test_search_finds_record_bodies_and_authenticates_every_hit(store):
+    append(store, case_items(1, "T-0001", "fixture regenerated after a stale compilation database"))
+    append(store, case_items(2, "T-0002", "unrelated words only"))
+    index = synced(store)
+    if not index.fts:
+        pytest.skip("this SQLite has no FTS5")
+    hits = index.search("compilation AND database")
+    assert [e["id"] for e in hits] == ["K-0001"]
+    assert all(e["kind"] == "case" for e in hits)
+    assert index.search("unrelated", kinds=("receipt",)) == []  # kinds narrow the hits
+    assert [e["id"] for e in index.search("unrelated", kinds=("case",))] == ["K-0002"]
+    assert index.search("nothing-here") == []  # punctuation: searched as a phrase, not an FTS5 syntax error
+    assert index.search("AND AND") == []  # not an expression either: the phrase fallback finds nothing
+
+
+def test_a_tampered_fts_row_hides_a_record_and_never_invents_one(store):
+    append(store, case_items(1, "T-0001", "needle in the haystack"))
+    index = synced(store)
+    if not index.fts:
+        pytest.skip("this SQLite has no FTS5")
+    conn = sqlite3.connect(index.path)
+    # 1. a body rewritten to match a query it never matched: the hit is authenticated and the entry is genuine, so
+    #    the result is the real K-0001 (the index can only mislabel, not forge content: the record is read from disk)
+    conn.execute("UPDATE fts SET body = 'planted phrase' WHERE id = 'K-0001'")
+    # 2. a row pointing at a position that is not a knowledge entry: filtered out by the kind check
+    conn.execute("INSERT INTO fts (seq, id, kind, body) VALUES (1, 'T-0001', 'case', 'planted phrase')")
+    # 3. a row pointing beyond the history: refused by authentication and the index is rebuilt
+    conn.execute("INSERT INTO fts (seq, id, kind, body) VALUES (99, 'K-0099', 'case', 'planted phrase')")
+    conn.commit()
+    conn.close()
+    hits = index.search("planted")
+    assert [e["id"] for e in hits] == ["K-0001"]  # the only genuine knowledge entry among the planted rows
+    assert index.search("needle") == [] or [e["id"] for e in index.search("needle")] == ["K-0001"]
+    # a full consistency check restores the derived table from the manifest
+    index.sync(read_root(store.root))
+    index._rebuild()
+    assert [e["id"] for e in index.search("needle")] == ["K-0001"]
+    assert index.search("planted") == []
+
+
+# ---------------------------------------------------------------------------------------------- orphans
+
+def test_an_orphaned_knowledge_record_is_reported_as_unreferenced(store):
+    append(store, case_items(1, "T-0001", "a"))
+    orphan = store.root / knowledge_rel("case", "K-9999", 1)
+    orphan.parent.mkdir(parents=True)
+    orphan.write_text("schema: x\n", encoding="utf-8")
+    index = synced(store)
+    assert History(store.root).unreferenced(index.paths()) == [knowledge_rel("case", "K-9999", 1)]
diff --git a/tests/integration/test_knowledge_surface.py b/tests/integration/test_knowledge_surface.py
new file mode 100644
index 0000000..6f1af24
--- /dev/null
+++ b/tests/integration/test_knowledge_surface.py
@@ -0,0 +1,163 @@
+"""`aew knowledge`: capture, dispositions and the read surface through the CLI (ADR-0013 draft; review T4).
+
+A knowledge commit is an ordinary Lead transaction that changes only the hot constants (counters, the knowledge
+block, the cold root, the transition), appends to the one history, and survives a crash at the history fault points.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+HELPERS = Path(__file__).resolve().parents[1] / "helpers"
+sys.path.insert(0, str(HELPERS))
+
+from conftest import clean_env, run_aew  # noqa: E402
+from invariants import assert_control_invariants, load_control  # noqa: E402
+
+from aew.engine.faults import CRASH_EXIT_CODE  # noqa: E402
+
+CASE = {
+    "template": "attempt-outcome/v1",
+    "title": "unit check failed, then passed after the fixture was regenerated",
+    "subject_refs": ["T-0001", "component:calc.core"],
+    "root_evidence_bindings": [{"evidence_id": "INV-0001-impl-1", "relation": "derived_from",
+                                "basis": "literal_outcome"}],
+    "observed_conditions": {"platform": "windows", "python": "3.12", "check": "unit"},
+    "fields": {"condition": "check unit failed on attempt 1", "action": "regenerated the fixture",
+               "result": "check unit passed, 7 tests"},
+    "source_classes": {"condition": "ENGINE_OBSERVED_WEAK_BOUNDARY", "result": "ENGINE_OBSERVED_WEAK_BOUNDARY",
+                       "action": "ROLE_ATTESTED"},
+    "limitations": ["single attempt"],
+    "unknowns": ["root cause"],
+}
+
+
+def case(p, record: dict | None = None, *extra: str):
+    res = p.aew("knowledge", "case", "--file", "-", *extra, "--token", p.token, "--expect-rev", str(p.rev()),
+                input=json.dumps(record or CASE))
+    return res
+
+
+def test_a_case_is_admitted_with_its_disposition_and_receipt_in_one_commit(project):
+    p = project
+    before = load_control(p.root)
+    res = case(p)
+    assert res.returncode == 0, res.stderr
+    out = res.json
+    assert out["id"] == "K-0001" and out["disposition"] == "KD-0001" and out["receipt"] == "KR-0001"
+    assert out["source"] == "model"  # a ROLE_ATTESTED field: the most restrictive class labels the entry
+    assert out["serving_eligibility"] == "explicit_investigation_only"
+    after = load_control(p.root)
+    changed = {k for k in set(before) | set(after) if before.get(k) != after.get(k)}
+    # Rule 28: a knowledge commit touches nothing under work, invocations, tokens or lead. The archival finalizer
+    # also materializes its own (empty) hot keys on the first commit that appends to the history.
+    assert changed <= {"revision", "counters", "knowledge", "cold", "last_transition", "next_action",
+                       "recent", "archived_refs", "retained_workspaces", "retired_observations"}
+    for key in ("work", "invocations", "tokens", "lead"):
+        assert after[key] == before[key], key
+    assert after.get("recent", []) == [] and after.get("archived_refs", {}) == {}
+    assert after["cold"]["root"]["count"] == 3
+    assert after["counters"]["knowledge"] == 1 and after["counters"]["receipt"] == 1
+    assert after["knowledge"]["capture"] == {"last_receipt": "KR-0001", "through_revision": before["revision"]}
+    assert after["knowledge"]["pending"] == []
+    assert_control_invariants(p)
+    # the records are where ADR-0013 D2 puts them, immutable
+    assert (p.root / ".aew/knowledge/cases/K-0001/v1.yaml").exists()
+    assert (p.root / ".aew/knowledge/cases/K-0001/dispositions/0001.yaml").exists()
+    assert (p.root / ".aew/knowledge/receipts/KR-0001.yaml").exists()
+
