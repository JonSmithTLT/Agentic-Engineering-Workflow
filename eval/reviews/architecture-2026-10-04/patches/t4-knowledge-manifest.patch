+def test_a_crash_inside_a_capture_commit_leaves_the_old_or_the_new_history(project):
+    p = project
+    env = {**clean_env(), "AEW_FAULT": "history.after_tail", "AEW_FAULT_MODE": "exit"}
+    res = run_aew("-C", str(p.root), "knowledge", "case", "--file", "-", "--token", p.token, "--expect-rev",
+                  str(p.rev()), env=env, input=json.dumps(CASE))
+    assert res.returncode == CRASH_EXIT_CODE
+    state = load_control(p.root)  # recovery ran: the commit either landed whole or not at all
+    assert state["cold"]["root"]["count"] in (0, 3)
+    assert p.ok("history", "audit", "--full")["ok"]
+    assert_control_invariants(p)
+    again = case(p)
+    assert again.returncode == 0
+    assert load_control(p.root)["cold"]["root"]["count"] in (3, 6)
+    assert p.ok("history", "audit", "--full")["ok"]
