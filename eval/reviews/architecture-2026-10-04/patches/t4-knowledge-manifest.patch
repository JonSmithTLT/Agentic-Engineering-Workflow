+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "aew/knowledge/receipt/v1",
+  "title": "AEW knowledge capture receipt",
+  "description": "The durable outcome of one capture job (capture draft §8): what it read (the outbox position, ADR-0012 D3), what it produced or held, and under which extractor and policy. Receipts are the capture cursor: the highest revision any receipt covers is where a worker resumes (ADR-0013 draft D5). A job that produced nothing still has a receipt (NO_CANDIDATE is a successful outcome).",
+  "type": "object",
+  "required": ["schema", "id", "job", "status", "produced", "no_candidate", "at"],
+  "additionalProperties": false,
+  "properties": {
+    "schema": {"const": "aew/knowledge/receipt/v1"},
+    "id": {"type": "string", "pattern": "^KR-[0-9]{4,}$"},
+    "job": {
+      "type": "object",
+      "required": ["project", "revision", "event_index"],
+      "additionalProperties": false,
+      "properties": {
+        "project": {"type": "string", "minLength": 1},
+        "revision": {"description": "The control revision (outbox position) the job read, or the end of its debounce window.", "type": "integer", "minimum": 0},
+        "revision_from": {"type": ["integer", "null"], "minimum": 0},
+        "event_index": {"type": "integer", "minimum": 0}
+      }
+    },
+    "status": {"enum": ["COMPLETE", "PARTIAL", "RETRYABLE_FAILURE", "PERMANENT_FAILURE"]},
+    "produced": {"type": "array", "items": {"type": "string", "pattern": "^K-[0-9]{4,}$"}},
+    "held": {"type": "array", "items": {"type": "string", "pattern": "^K-[0-9]{4,}$"}},
+    "no_candidate": {"type": "boolean"},
+    "extractor": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
+    "input_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
+    "actor": {"type": "object", "additionalProperties": {"type": ["string", "integer", "null"]}},
+    "at": {"type": "string", "minLength": 1}
+  }
+}
