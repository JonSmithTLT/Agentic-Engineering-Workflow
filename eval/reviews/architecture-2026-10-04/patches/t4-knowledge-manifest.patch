+def test_the_audit_covers_knowledge_records_and_resume_reads_none_of_them(project):
+    p = project
+    assert case(p).returncode == 0
+    advisory = p.ok("history", "audit", "--full")
+    assert advisory["ok"] and advisory["records"] == 3 and advisory["recorded"] is False
+    recorded = p.ok("history", "audit", "--full", "--token", p.token, "--expect-rev", str(p.rev()))
+    assert recorded["ok"] and recorded["recorded"] is True
+    # damage a disposition's record: the next read of it is a contradiction and the audit reports it
+    path = p.root / ".aew/knowledge/cases/K-0001/dispositions/0001.yaml"
+    original = path.read_bytes()
+    path.write_bytes(original.replace(b"admitted", b"rejected"))
+    res = p.aew("history", "audit", "--full")  # incremental covers only what the recorded audit did not
+    assert res.returncode != 0 and "does not hold the content" in (res.stderr + res.stdout)
+    res = p.aew("knowledge", "show", "K-0001")  # and reading the record is a contradiction too, not a stale view
+    assert res.returncode == 0  # the content version itself is intact; the damaged disposition is read lazily
+    path.write_bytes(original)
+    assert p.ok("history", "audit", "--full")["ok"]
+    # resume and status are history-independent: they succeed without reading any knowledge record
+    assert p.aew("resume").returncode == 0
+    assert p.aew("status").returncode == 0
+
