+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "aew/knowledge/disposition/v1",
+  "title": "AEW knowledge disposition: an append-only event about a knowledge record",
+  "description": "Admission, hold, release, challenge, supersession and reassessment are events, never rewrites of the content version (shared semantics §4.2, §7). The current state is a fold over these in manifest order; the manifest sequence number is the global knowledge_event_seq. ADR-0013 (draft) D3, D4.",
+  "type": "object",
+  "required": ["schema", "id", "subject", "rel", "disposition_seq", "actor", "at"],
+  "additionalProperties": false,
+  "properties": {
+    "schema": {"const": "aew/knowledge/disposition/v1"},
+    "id": {"type": "string", "pattern": "^KD-[0-9]{4,}$"},
+    "subject": {
+      "type": "object",
+      "required": ["id", "version"],
+      "additionalProperties": false,
+      "properties": {
+        "id": {"type": "string", "pattern": "^K-[0-9]{4,}$"},
+        "version": {"type": "integer", "minimum": 1},
+        "entry_seq": {"description": "The manifest position of the content version this event is about.", "type": "integer", "minimum": 1}
+      }
+    },
+    "rel": {"enum": ["admitted", "held_active", "held_dormant", "rejected", "superseded_proposal", "serving_hold", "serving_release", "superseded_by", "refines", "challenged", "reassessed", "visibility_widened", "quarantined", "archived", "audit_finding"]},
+    "object": {"description": "What the event points at, when it points: a K-nnnn@v<k>, a decision id, an audit id.", "type": ["string", "null"]},
+    "disposition_seq": {"description": "This event's position among the events about its subject (checkable against the manifest).", "type": "integer", "minimum": 1},
+    "policy_version": {"type": ["string", "null"]},
+    "serving_eligibility": {"description": "The serving envelope an admission establishes (shared semantics §7.5).", "enum": ["direct_reference", "case_recall", "default_lesson_eligible", "explicit_investigation_only", "suppressed", null]},
+    "decision": {"description": "The decision record (D-nnnn) behind a judgment-bearing event.", "type": ["string", "null"]},
+    "actor": {
+      "type": "object",
+      "required": ["kind"],
+      "additionalProperties": false,
+      "properties": {
+        "kind": {"enum": ["lead", "operator", "service", "engine"]},
+        "generation": {"type": ["integer", "null"]},
+        "identity": {"type": ["string", "null"]}
+      }
+    },
+    "note": {"type": ["string", "null"]},
+    "at": {"type": "string", "minLength": 1}
+  }
+}
