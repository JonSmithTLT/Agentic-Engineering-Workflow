+          "claim_components": {"type": "array", "items": {"type": "string"}},
+          "structured_field_path": {"type": "string"}
+        }
+      }
+    },
+    "observed_conditions": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
+    "fields": {"description": "The template's literal fields (condition, action, result, ...).", "type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null", "array"]}},
+    "source_classes": {
+      "description": "Per field, the source class and authentication boundary it was established under (capture draft §10). Typed is not trusted.",
+      "type": "object",
+      "additionalProperties": {"enum": ["ENGINE_OBSERVED_CONTAINED", "ENGINE_OBSERVED_WEAK_BOUNDARY", "ROLE_ATTESTED", "EXTERNAL_UNTRUSTED"]}
+    },
+    "source_disposition": {"description": "The workflow disposition of the observation, carried, never read as proof (capture draft §15).", "type": ["string", "null"]},
+    "limitations": {"type": "array", "items": {"type": "string"}},
+    "unknowns": {"type": "array", "items": {"type": "string"}},
+    "visibility_scope": {"const": "project"},
+    "created_at": {"type": "string", "minLength": 1},
+    "supersedes": {"description": "An exact earlier version this one replaces (K-nnnn@v<k>), when a new version is admitted.", "type": ["string", "null"]}
+  }
+}
