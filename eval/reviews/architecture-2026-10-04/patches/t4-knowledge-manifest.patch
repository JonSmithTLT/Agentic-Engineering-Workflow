@@ -0,0 +1,75 @@
+"""`aew knowledge`: capture, dispositions and the read surface of knowledge records (ADR-0013 draft; review T4)."""
+
+from __future__ import annotations
+
+import argparse
+from typing import Any
+
+from aew.cli.commands import _add_json, _add_lead, _engine, _lead_token, _read_text_arg
+from aew.errors import UsageError
+from aew.util import load_yaml
+
+
+def _record(args: argparse.Namespace) -> dict[str, Any]:
+    text = _read_text_arg(args.file)
+    doc = load_yaml(text, source=args.file or "-")
+    if not isinstance(doc, dict):
+        raise UsageError("the record file must hold a YAML or JSON mapping")
+    return doc
+
+
+def _case(a: argparse.Namespace) -> Any:
+    extractor = {"template_set": a.template_set} if a.template_set else None
+    return _engine(a).knowledge_case(token=_lead_token(a), expect_rev=a.expect_rev, record=_record(a), hold=a.hold,
+                                     job_revision=a.job_revision, job_index=a.job_index, extractor=extractor)
+
+
+def register(sub: argparse._SubParsersAction) -> None:
+    p = sub.add_parser("knowledge", help="knowledge records in the history: capture, dispose, show, list, search")
+    ksub = p.add_subparsers(dest="knowledge_cmd", required=True)
+
+    q = ksub.add_parser("case", help="admit (or hold) one observed Case from a record file, with its receipt (Lead)")
+    q.add_argument("--file", required=True, metavar="FILE|-", help="the Case record (YAML or JSON mapping)")
+    q.add_argument("--hold", action="store_true", help="hold the candidate for judgment instead of admitting it")
+    q.add_argument("--job-revision", type=int, help="the outbox revision the capture job read (default: --expect-rev)")
+    q.add_argument("--job-index", type=int, default=0, help="the event index within that revision")
+    q.add_argument("--template-set", help="the K1 template set the capture used, recorded on the receipt")
+    _add_lead(q)
+    _add_json(q)
+    q.set_defaults(handler=_case)
+
+    q = ksub.add_parser("dispose", help="record a later fact about a knowledge record (Lead): admitted, held, "
+                                        "rejected, serving_hold, serving_release, superseded_by, ...")
+    q.add_argument("knowledge_id")
+    q.add_argument("--rel", required=True)
+    q.add_argument("--object", dest="obj", help="what the event points at (K-nnnn@v<k>, a decision id, an audit id)")
+    q.add_argument("--decision", help="the decision record behind a judgment-bearing event")
+    q.add_argument("--note")
+    q.add_argument("--policy-version")
+    q.add_argument("--serving", dest="serving", help="serving eligibility an admission establishes")
+    _add_lead(q)
+    _add_json(q)
+    q.set_defaults(handler=lambda a: _engine(a).knowledge_dispose(
+        token=_lead_token(a), expect_rev=a.expect_rev, knowledge_id=a.knowledge_id, rel=a.rel, obj=a.obj,
+        decision=a.decision, note=a.note, policy_version=a.policy_version, serving_eligibility=a.serving))
+
+    q = ksub.add_parser("show", help="a knowledge record: its current version, its record and the fold of its "
+                                     "dispositions")
+    q.add_argument("knowledge_id")
+    _add_json(q)
+    q.set_defaults(handler=lambda a: _engine(a).knowledge_show(a.knowledge_id))
+
+    q = ksub.add_parser("list", help="knowledge entries, newest first")
+    q.add_argument("--kind", help="reference, case, lesson, disposition or receipt")
+    q.add_argument("--limit", type=int, default=50)
+    _add_json(q)
+    q.set_defaults(handler=lambda a: _engine(a).knowledge_list(kind=a.kind, limit=a.limit))
+
+    q = ksub.add_parser("search", help="full-text search over knowledge record bodies (derived index; hits are "
+                                       "authenticated against the history)")
+    q.add_argument("query")
+    q.add_argument("--kind", action="append", help="restrict to these kinds (repeatable)")
+    q.add_argument("--limit", type=int, default=20)
+    _add_json(q)
+    q.set_defaults(handler=lambda a: _engine(a).knowledge_search(a.query, kinds=tuple(a.kind) if a.kind else None,
+                                                                limit=a.limit))
