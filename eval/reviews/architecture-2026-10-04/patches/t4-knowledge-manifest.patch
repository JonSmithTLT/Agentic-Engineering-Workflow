diff --git a/src/aew/engine/knowledge_ops.py b/src/aew/engine/knowledge_ops.py
new file mode 100644
index 0000000..b787a18
--- /dev/null
+++ b/src/aew/engine/knowledge_ops.py
@@ -0,0 +1,294 @@
+"""Knowledge records in the history manifest (ADR-0013, draft; architecture review T4).
+
+A knowledge record (an observed Case, K1) is a durable, immutable, content-addressed record exactly like an archived
+unit's bundle: written create-if-absent through the ADR-0001 redo record and pinned by an entry of the ADR-0011
+history manifest. Every later fact about it is a ``disposition`` entry (admitted, held, rejected, serving hold or
+release, superseded); the current state is a fold over those in manifest order, never written back. A capture job's
+outcome is a ``receipt`` entry, which is also the capture cursor (the highest revision any receipt covers).
+
+One chain, one root, one audit, one derived index: the shared semantics' global ``knowledge_event_seq`` is the
+manifest sequence number. Hot state gains only constants: three counters, ``knowledge.capture`` (the last receipt
+and the revision it covers, so ``status`` never reads the history) and ``knowledge.pending`` (a bounded list of held
+candidates awaiting judgment, for the action projection).
+
+Prototype scope: the Lead commits (``lead_txn``); the service identity the draft's D9 proposes is not modelled, so
+the closed-transaction property (oracle rule 28) is asserted by tests on what a ``knowledge.*`` commit changes.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from aew.engine.archive_ops import redact
+from aew.engine.history_ops import TRUST_LABEL
+from aew.errors import NotFound, UsageError, ValidationFailed
+from aew.history import manifest as M
+from aew.history.index import HistoryIndex
+from aew.history.store import History, disposition_rel, knowledge_rel, receipt_rel
+from aew.knowledge.records import format_id
+from aew.schemas import validate
+from aew.util import dump_yaml, utc_now
+
+if TYPE_CHECKING:
+    from aew.engine.base import Kernel, TxnContext
+    from aew.engine.ports import ArchivePort
+
+V2 = "aew/control/v2"
+CASE_SCHEMA = "aew/knowledge/case/v1"
+DISPOSITION_SCHEMA = "aew/knowledge/disposition/v1"
+RECEIPT_SCHEMA = "aew/knowledge/receipt/v1"
+PENDING_MAX = 20
+# The entry's trust label is the most restrictive source class in the record (ADR-0013 D7).
+SOURCE_RANK = {"ENGINE_OBSERVED_CONTAINED": 0, "ENGINE_OBSERVED_WEAK_BOUNDARY": 0, "ROLE_ATTESTED": 1,
+               "EXTERNAL_UNTRUSTED": 2}
+SOURCE_LABEL = {0: "engine", 1: "model", 2: "external"}
+ADMISSION_RELS = frozenset({"admitted", "held_active", "held_dormant", "rejected", "superseded_proposal"})
+SERVING_RELS = frozenset({"serving_hold", "serving_release"})
+LIFECYCLE_RELS = frozenset({"superseded_by", "quarantined", "archived"})
+OTHER_RELS = frozenset({"refines", "challenged", "reassessed", "visibility_widened", "audit_finding"})
+RELS = ADMISSION_RELS | SERVING_RELS | LIFECYCLE_RELS | OTHER_RELS
+
+
+def _empty_knowledge() -> dict[str, Any]:
+    return {"capture": None, "pending": [], "pending_overflow": 0}
+
+
+def knowledge_state(state: dict[str, Any]) -> dict[str, Any]:
+    """The hot ``knowledge`` block, created on first use (a v2 project from before this ADR has none)."""
+    block = state.get("knowledge")
+    if block is None:
+        block = state["knowledge"] = _empty_knowledge()
+    return block
+
+
+def source_of(record: dict[str, Any]) -> str:
+    classes = (record.get("source_classes") or {}).values()
+    return SOURCE_LABEL[max((SOURCE_RANK.get(c, 2) for c in classes), default=0)]
+
+
+def knowledge_problems(index: HistoryIndex) -> list[str]:
+    """Audit-time checks over the knowledge entries (ADR-0013 D12, the index-only part): every disposition's subject
+    is a content record at a lower position, and every receipt's produced ids exist. Linear in knowledge entries,
+    like the audit itself; never on the commit path."""
+    problems: list[str] = []
+    content = {e["id"]: e["seq"] for e in index.list(kind=None, limit=None) if e["kind"] in M.CONTENT_KINDS}
+    for e in index.list(kind="disposition", limit=None):
+        subject = e.get("subject")
+        if subject not in content:
+            problems.append(f"entry {e['seq']} ({e['id']}): disposition about {subject}, which is not a knowledge "
+                            "record")
+        elif content[subject] > e["seq"]:
+            problems.append(f"entry {e['seq']} ({e['id']}): disposition precedes its subject {subject}")
+    for e in index.list(kind="receipt", limit=None):
+        for kid in (e.get("links") or {}).get("produced") or []:
+            if kid not in content:
+                problems.append(f"entry {e['seq']} ({e['id']}): receipt names {kid}, which is not a knowledge record")
+    return problems
+
+
+class Knowledge:
+    """Capture, disposition and the read surface of knowledge records."""
+
+    def __init__(self, k: Kernel, *, archive: ArchivePort) -> None:
+        self.k = k
+        self.archive = archive
+        self.cold = History(k.aew_root)
+
+    # ------------------------------------------------------------------ helpers
+
+    @staticmethod
+    def _require_v2(state: dict[str, Any]) -> None:
+        if state.get("schema") != V2:
+            raise UsageError("this project's control state is v1: migrate it first (`aew migrate`); knowledge "
+                             "records live in the v2 history")
+
+    def _index(self, state: dict[str, Any]) -> HistoryIndex:
+        return self.archive.index(state)
+
+    def _content_entry(self, state: dict[str, Any], knowledge_id: str) -> dict[str, Any]:
+        entries = [e for e in self._index(state).by_id(knowledge_id) if e["kind"] in M.CONTENT_KINDS]
+        if not entries:
+            raise NotFound(f"no knowledge record {knowledge_id}")
+        return entries[-1]
+
+    def _pending_add(self, state: dict[str, Any], item: dict[str, Any]) -> None:
+        block = knowledge_state(state)
+        pending = [p for p in block["pending"] if p["id"] != item["id"]]
+        pending.append(item)
+        if len(pending) > PENDING_MAX:
+            block["pending_overflow"] = block.get("pending_overflow", 0) + len(pending) - PENDING_MAX
+            pending = pending[-PENDING_MAX:]
+        block["pending"] = pending
+
+    def _pending_drop(self, state: dict[str, Any], knowledge_id: str) -> None:
+        block = knowledge_state(state)
+        block["pending"] = [p for p in block["pending"] if p["id"] != knowledge_id]
+
+    # ------------------------------------------------------------------ capture (K1 case + receipt)
+
+    def knowledge_case(self, *, token: str, expect_rev: int, record: dict[str, Any], hold: bool = False,
+                       job_revision: int | None = None, job_index: int = 0,
+                       extractor: dict[str, str] | None = None) -> dict[str, Any]:
+        """Admit (or hold) one observed Case from a submitted record, with its initial disposition and the capture
+        receipt, in one transaction. The engine owns ``schema``, ``id``, ``version``, ``record_kind``,
+        ``authority_class``, ``visibility_scope`` and ``created_at``; a submission carrying them is refused."""
+        owned = sorted({"schema", "id", "version", "record_kind", "authority_class", "visibility_scope",
+                        "created_at"} & set(record))
+        if owned:
+            raise ValidationFailed("these fields are assigned by the engine and may not be supplied", fields=owned)
+        with self.k.lead_txn(token, expect_rev, "knowledge.capture") as ctx:
+            state = ctx.state
+            self._require_v2(state)
+            counters = state["counters"]
+            counters["knowledge"] = counters.get("knowledge", 0) + 1
+            counters["disposition"] = counters.get("disposition", 0) + 1
+            counters["receipt"] = counters.get("receipt", 0) + 1
+            kid = format_id("K", counters["knowledge"])
+            did = format_id("KD", counters["disposition"])
+            rid = format_id("KR", counters["receipt"])
+            at = utc_now()
+            case = {**record, "schema": CASE_SCHEMA, "id": kid, "version": 1, "record_kind": "case",
+                    "authority_class": "advisory", "visibility_scope": "project", "created_at": at}
+            validate("knowledge-case", case, source=kid)
+            source = source_of(case)
+            serving = "case_recall" if source == "engine" else "explicit_investigation_only"
+            rel = "held_active" if hold else "admitted"
+            disposition = {"schema": DISPOSITION_SCHEMA, "id": did, "subject": {"id": kid, "version": 1}, "rel": rel,
+                           "object": None, "disposition_seq": 1, "policy_version": (extractor or {}).get("policy"),
+                           "serving_eligibility": None if hold else serving, "decision": None,
+                           "actor": {"kind": "lead", "generation": state["lead"]["generation"], "identity": None},
+                           "note": None, "at": at}
+            validate("knowledge-disposition", disposition, source=did)
+            receipt = {"schema": RECEIPT_SCHEMA, "id": rid,
+                       "job": {"project": state["project_id"], "revision": expect_rev if job_revision is None
+                               else job_revision, "revision_from": None, "event_index": job_index},
+                       "status": "COMPLETE", "produced": [kid], "held": [kid] if hold else [], "no_candidate": False,
+                       "extractor": dict(extractor or {}), "input_sha256": None,
+                       "actor": {"kind": "lead", "generation": state["lead"]["generation"]}, "at": at}
+            validate("knowledge-receipt", receipt, source=rid)
+            # Records first (staged in the redo record), then their entries, appended by the finalizer in this order.
+            entries = []
+            for kind, obj, rel_path, extra in (
+                    ("case", case, knowledge_rel("case", kid, 1),
+                     {"version": 1, "links": {k: v for k, v in {
+                         "derived_from": sorted({b["evidence_id"] for b in case["root_evidence_bindings"]}),
+                         "subject": list(case["subject_refs"]), "job": [rid]}.items() if v}}),
+                    ("disposition", disposition, disposition_rel(kid, 1),
+                     {"subject": kid, "rel": rel, "links": {rel: [f"{kid}@v1"]}}),
+                    ("receipt", receipt, receipt_rel(rid),
+                     {"links": {"produced": [kid], "outbox": [f"rev:{receipt['job']['revision']}"],
+                                "subject": list(case["subject_refs"])}})):
+                text = dump_yaml(obj)
+                sha = History.write_record(ctx.session, rel_path, text)
+                entries.append({"kind": kind, "id": obj["id"], "path": rel_path, "sha256": sha, "at": at,
+                                "source": source if kind == "case" else "engine", **extra})
+            ctx.entries.extend(entries)
+            block = knowledge_state(state)
+            block["capture"] = {"last_receipt": rid, "through_revision": receipt["job"]["revision"]}
+            if hold:
+                self._pending_add(state, {"id": kid, "version": 1, "kind": "case", "class": "K1", "since": at})
+            ctx.refs += [knowledge_rel("case", kid, 1), receipt_rel(rid)]
+            ctx.summary = f"knowledge: {kid} {'held' if hold else 'admitted'} ({receipt['job']['revision']} -> {rid})"
+        return {"ok": True, "id": kid, "version": 1, "disposition": did, "receipt": rid, "source": source,
+                "serving_eligibility": None if hold else serving, "revision": ctx.session.committed_revision}
+
+    # ------------------------------------------------------------------ dispositions
+
+    def knowledge_dispose(self, *, token: str, expect_rev: int, knowledge_id: str, rel: str, obj: str | None = None,
+                          decision: str | None = None, note: str | None = None, policy_version: str | None = None,
+                          serving_eligibility: str | None = None) -> dict[str, Any]:
+        """Record a later fact about a knowledge record: one immutable disposition and its entry. The content version
+        is never rewritten."""
+        if rel not in RELS:
+            raise UsageError(f"--rel must be one of {', '.join(sorted(RELS))}")
