{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/checks/v1",
  "title": "Project build/test check policy",
  "description": "Project-defined deterministic checks. A check with configured=false blocks gates that require it instead of guessing a command (KC §19).",
  "type": "object",
  "required": ["schema", "checks"],
  "properties": {
    "schema": {"x-aew-class": "operational", "const": "aew/checks/v1"},
    "checks": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "object",
        "required": ["configured"],
        "properties": {
          "configured": {"x-aew-class": "legality_affecting", "type": "boolean"},
          "command": {"x-aew-class": "legality_affecting", "type": ["array", "null"], "items": {"type": "string"}},
          "cwd": {"x-aew-class": "legality_affecting", "type": "string"},
          "timeout_s": {"x-aew-class": "legality_affecting", "type": "number", "exclusiveMinimum": 0},
          "network": {"x-aew-class": "legality_affecting", "enum": ["isolated", "shared"], "description": "The network the check runs with in a contained run (F28 §3.8): isolated (the default) has none; shared asks for the host's, and gets it only when the run itself has the host's network (containment.network.mode: shared in the execution policy)."},
          "description": {"x-aew-class": "operational", "type": "string"}
        }
      }
    },
    "baseline_failures": {"x-aew-class": "legality_affecting", "type": "array", "items": {"type": "string"}},
    "coverage": {
      "x-aew-class": "operational",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ci_tools": {
          "x-aew-class": "operational",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "covered_by"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "covered_by": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "affected_tests": {
          "x-aew-class": "operational",
          "type": "object",
          "additionalProperties": false,
          "required": ["selector", "unit"],
          "properties": {
            "unit": {"type": "string", "minLength": 1},
            "selector": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command"],
              "properties": {
                "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "cwd": {"type": "string", "default": "."},
                "timeout_s": {"type": "number", "exclusiveMinimum": 0},
                "network": {"enum": ["isolated", "shared"], "default": "isolated"},
                "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "may_select_none": {"type": "boolean", "default": false}
              }
            }
          }
        }
      }
    }
  }
}
