{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/control/v2",
  "title": "AEW authoritative control state",
  "description": "Single atomic commit point for Lead-owned control state (WC §5, §8.2; KC §12.3). v2 (ADR-0011) adds the hot root of cold history and the bounded facts kept hot about archived work; a v1 document is still read.",
  "type": "object",
  "required": [
    "schema",
    "project_id",
    "spec_set",
    "revision",
    "manifest_sha256",
    "lead",
    "tokens",
    "counters",
    "work",
    "invocations",
    "last_transition"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "enum": ["aew/control/v1", "aew/control/v2"]
    },
    "project_id": {
      "$ref": "#/$defs/slug"
    },
    "spec_set": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "lead": {
      "type": "object",
      "required": [
        "schema",
        "status",
        "generation"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "aew/lead/v1"
        },
        "status": {
          "enum": [
            "vacant",
            "active",
            "handoff_pending"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "session_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "token_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "acquired_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "handoff": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "offer_token_id",
            "offered_at",
            "record",
            "carry_invocations"
          ],
          "properties": {
            "offer_token_id": {
              "type": "string"
            },
            "offered_at": {
              "type": "string"
            },
            "record": {
              "type": "string"
            },
            "carry_invocations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "verifier",
          "scope",
          "issued_at",
          "issued_by_generation"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "lead",
              "invocation",
              "handoff_offer"
            ]
          },
          "verifier": {
            "$ref": "#/$defs/sha256"
          },
          "scope": {
            "type": "object"
          },
          "issued_at": {
            "type": "string"
          },
          "issued_by_generation": {
            "type": "integer"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "revoke_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "latest_handoff": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "work": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/work_unit"
      }
    },
    "invocations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "role",
          "work_unit",
          "status",
          "token_id",
          "created_at",
          "generation"
        ],
        "properties": {
          "role": {
            "enum": [
              "implementer",
              "reviewer",
              "verifier",
              "planner",
              "investigator",
              "researcher"
            ]
          },
          "work_unit": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "completed",
              "cancelled",
              "interrupted",
              "revoked",
              "superseded"
            ]
          },
          "token_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "generation": {
            "type": "integer"
          },
          "scope": {
            "enum": [
              "ticket",
              "integration",
              "observation",
              "parent"
            ]
          },
          "specialty": {
            "type": [
              "string",
              "null"
            ]
          },
          "workspace": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot": {
            "type": [
              "object",
              "null"
            ]
          },
          "pack": {
            "type": [
              "object",
              "null"
            ]
          },
          "card": {
            "type": [
              "object",
              "null"
            ]
          },
          "execution_profile": {
            "description": "harness/provider/model/effort pinned at dispatch (ADR-0010); null = none selected",
            "type": [
              "object",
              "null"
            ],
            "required": [
              "harness",
              "provider",
              "model",
              "selected_by"
            ],
            "properties": {
              "profile": {"type": ["string", "null"]},
              "harness": {"type": "string"},
              "provider": {"type": "string"},
              "model": {"type": "string"},
              "effort": {"type": ["string", "null"]},
              "max_steps": {"type": ["integer", "null"]},
              "deadline_s": {"type": ["number", "null"]},
              "selected_by": {"enum": ["policy", "lead"]},
              "rule": {"type": "string"},
              "policy_sha256": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "last_transition": {
      "type": "object",
      "required": [
        "revision",
        "at",
        "actor",
        "op"
      ],
      "properties": {
        "revision": {
          "type": "integer"
        },
        "at": {
          "type": "string"
        },
        "actor": {
          "type": "object"
        },
        "op": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array"
        },
        "txn": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "cold": {
      "description": "ADR-0011: the root that pins the cold history (implementation plan R1).",
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": {"$ref": "#/$defs/history_root"}
      }
    },
    "recent": {
      "description": "The most recently archived units, newest last (bounded): what views show besides counts.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "kind", "state", "title", "at"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["ticket", "story", "epic"]},
          "state": {"enum": ["DONE", "CANCELLED"]},
          "title": {"type": "string"},
          "at": {"type": "string"},
          "parent": {"type": ["string", "null"]}
        }
      }
    },
    "archived_refs": {
      "description": "Facts about archived units that hot dependency edges still need (plan R4), counted by those edges.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "state", "refs", "bundle_sha256"],
        "properties": {
          "kind": {"enum": ["ticket", "story", "epic"]},
          "mutating": {"type": ["boolean", "null"]},
          "state": {"enum": ["DONE", "CANCELLED"]},
          "refs": {"type": "integer", "minimum": 0},
          "bundle_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "retained_workspaces": {
      "description": "Workspaces of archived Tickets retained after integration, until their directory is gone (plan R7).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work_id", "id", "path", "status"],
        "properties": {
          "work_id": {"type": "string"},
          "id": {"type": "string"},
          "path": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema": {"const": "aew/control/v1"}}},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["cold"]},
            {"required": ["recent"]},
            {"required": ["archived_refs"]},
            {"required": ["retained_workspaces"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"schema": {"const": "aew/control/v2"}}},
      "then": {"required": ["cold"]}
    }
  ],
  "$defs": {
    "history_root": {
      "type": "object",
      "required": ["count", "head_h", "sealed_head"],
      "additionalProperties": false,
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "head_h": {"$ref": "#/$defs/sha256"},
        "sealed_head": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["seq", "sha256"],
              "additionalProperties": false,
              "properties": {"seq": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
            }
          ]
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "work_unit": {
      "type": "object",
      "required": [
        "kind",
        "title",
        "record",
        "record_sha256",
        "state",
        "risk_class",
        "mutating",
        "depends_on"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ticket",
            "story",
            "epic"
          ]
        },
        "title": {
          "type": "string"
        },
        "record": {
          "type": "string"
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "BLOCKED",
            "READY",
            "ASSIGNED",
            "RUNNING",
            "REVIEW_PENDING",
            "REVIEW_FAILED",
            "REVIEW_PASSED",
            "VERIFY_PENDING",
            "VERIFICATION_FAILED",
            "VERIFICATION_INCONCLUSIVE",
            "VERIFIED",
            "COMMIT_READY",
            "DONE",
            "INTERRUPTED",
            "REPLAN_REQUIRED",
            "ESCALATED",
            "CANCELLED",
            "OPEN",
            "PLANNING",
            "IN_PROGRESS",
            "ACCEPTANCE_PENDING"
          ]
        },
        "risk_class": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "mutating": {
          "type": "boolean"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "mutating",
                  "evidence"
                ]
              }
            }
          }
        }
      }
    }
  }
}
