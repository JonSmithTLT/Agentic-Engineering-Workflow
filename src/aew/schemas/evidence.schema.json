{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/evidence/v1",
  "title": "Engineering evidence record",
  "description": "Immutable, attributable evidence (WC §9.7-9.9, KC §11): what / who / when / against / how / result / evidence. Producer, snapshot and plan binding are engine-owned and never taken from the submitter.",
  "type": "object",
  "required": ["schema", "id", "kind", "work_unit", "producer", "created_at", "evaluated_snapshot", "method", "claim", "result"],
  "properties": {
    "schema": {"const": "aew/evidence/v1"},
    "id": {"type": "string"},
    "kind": {"enum": ["implementation_report", "review", "verification", "check_result",
                      "discovery_record", "research_record", "plan_proposal"]},
    "work_unit": {"type": "string"},
    "producer": {
      "type": "object",
      "required": ["role", "invocation"],
      "properties": {
        "role": {"type": "string"},
        "invocation": {"type": "string"},
        "model": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]},
        "harness": {"type": ["string", "null"]}
      }
    },
    "created_at": {"type": "string"},
    "plan_revision": {
      "type": ["object", "null"],
      "properties": {"revision": {"type": "integer"}, "sha256": {"type": "string"}}
    },
    "evaluated_snapshot": {"$ref": "#/$defs/snapshot"},
    "method": {"type": "object"},
    "claim": {"type": "string"},
    "result": {"enum": ["pass", "fail", "inconclusive", "blocked"]},
    "evidence": {
      "type": "array",
      "items": {"type": "object", "required": ["path", "sha256"]}
    },
    "implementation": {
      "type": "object",
      "properties": {
        "files_changed": {"type": "array", "items": {"type": "string"}},
        "checks_run": {"type": "array", "items": {"type": "string"}},
        "deviations": {"type": "array", "items": {"type": "string"}},
        "unexpected_findings": {"type": "array", "items": {"type": "string"}},
        "self_review": {
          "type": "object",
          "required": ["completed"],
          "properties": {"completed": {"type": "boolean"}, "notes": {"type": ["string", "null"]}}
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["independence", "disposition", "findings"],
      "properties": {
        "independence": {"enum": ["R0", "R1", "R2", "R3"]},
        "specialty": {"type": ["string", "null"]},
        "disposition": {"enum": ["pass", "changes_required"]},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "summary", "required"],
            "properties": {
              "id": {"type": "string"},
              "severity": {"enum": ["blocker", "major", "minor", "observation"]},
              "summary": {"type": "string"},
              "location": {"type": ["string", "null"]},
              "required": {"type": "boolean"}
            }
          }
        },
        "resolved_findings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "required": ["scope", "claims"],
      "properties": {
        "scope": {"enum": ["ticket", "integration", "parent"]},
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "claim", "result"],
            "properties": {
              "type": {"enum": ["goal_backwards", "contract"]},
              "claim": {"type": "string"},
              "result": {"enum": ["pass", "fail", "inconclusive", "blocked"]},
              "checks": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "suspected_cause": {"type": ["string", "null"]}
      }
    },
    "attempt": {"type": "integer", "minimum": 1,
                "description": "engine-bound: the non-mutating Ticket attempt this record belongs to (ADR-0008)"},
    "subject": {
      "type": "object",
      "description": "engine-bound: the execute record a review/verification of a non-mutating Ticket evaluated",
      "required": ["id", "sha256"],
      "properties": {"id": {"type": "string"}, "sha256": {"type": "string"}}
    },
    "discovery": {
      "type": "object",
      "description": "Discovery Record (WC §9.3): observed facts with evidence, separated from hypotheses",
      "required": ["facts", "hypotheses", "unresolved_questions"],
      "properties": {
        "question": {"type": ["string", "null"]},
        "facts": {"type": "array", "items": {"type": "object", "required": ["statement", "evidence"],
                  "properties": {"statement": {"type": "string", "minLength": 1},
                                 "evidence": {"type": "array", "items": {"type": "string"}}}}},
        "hypotheses": {"type": "array", "items": {"type": "object", "required": ["statement"],
                       "properties": {"statement": {"type": "string", "minLength": 1},
                                      "confirm_by": {"type": ["string", "null"]}}}},
        "unresolved_questions": {"type": "array", "items": {"type": "string"}},
        "observed_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "research": {
      "type": "object",
      "description": "Research Record (WC §9.4): external conclusions with versions/sources and uncertainties",
      "required": ["conclusions", "subjects", "uncertainties"],
      "properties": {
        "question": {"type": ["string", "null"]},
        "conclusions": {"type": "array", "items": {"type": "string"}},
        "subjects": {"type": "array", "items": {"type": "object", "required": ["name", "source"],
                     "properties": {"name": {"type": "string"}, "version": {"type": ["string", "null"]},
                                    "source": {"type": "string"}}}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "uncertainties": {"type": "array", "items": {"type": "string"}}
      }
    },
    "proposal": {
      "type": "object",
      "description": "Plan proposal (WC §4.1 plan contract); the Markdown body is the proposed plan text",
      "required": ["objective", "approach"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "approach": {"type": "string", "minLength": 1},
        "governing_constraints": {"type": "array", "items": {"type": "string"}},
        "affected_components": {"type": "array", "items": {"type": "string"}},
        "ordered_tasks": {"type": "array", "items": {"type": "string"}},
        "required_tests": {"type": "array", "items": {"type": "string"}},
        "required_verification": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}},
        "rejected_alternatives": {"type": "array", "items": {"type": "string"}},
        "affected_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "check": {
      "type": "object",
      "required": ["check_id", "exit_code"],
      "properties": {
        "check_id": {"type": "string"},
        "exit_code": {"type": ["integer", "null"]},
        "duration_s": {"type": "number"},
        "mutated_inputs": {"type": "boolean"},
        "violations": {"type": "array"},
        "triggered_gates": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["base_revision", "workspace_id", "relevant_inputs_fingerprint"],
      "properties": {
        "base_revision": {"type": ["string", "null"]},
        "workspace_id": {"type": "string"},
        "relevant_inputs_fingerprint": {"type": "string"},
        "artifact_digests": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
