{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/evidence/v1",
  "title": "Engineering evidence record",
  "description": "Immutable, attributable evidence (WC §9.7-9.9, KC §11): what / who / when / against / how / result / evidence. Producer, snapshot and plan binding are engine-owned and never taken from the submitter.",
  "type": "object",
  "required": ["schema", "id", "kind", "work_unit", "producer", "created_at", "evaluated_snapshot", "method", "claim", "result"],
  "properties": {
    "schema": {"const": "aew/evidence/v1"},
    "id": {"type": "string"},
    "kind": {"enum": ["implementation_report", "review", "verification", "check_result",
                      "discovery_record", "research_record", "plan_proposal", "plan_assessment"]},
    "work_unit": {"type": "string"},
    "producer": {
      "type": "object",
      "required": ["invocation"],
      "properties": {
        "kind": {"enum": ["role_invocation", "engine"],
                 "description": "M4-D5: who produced the record. Absent means role_invocation (every earlier record). `engine` is AEW's own deterministic check machinery under a custody invocation (an integration_attempt): only on check_result, never with a role, and always naming its validation run"},
        "validation_run": {"type": "string", "description": "M4-D5: the validation run (IV-...) that produced an engine check_result"},
        "role": {"type": "string"},
        "invocation": {"type": "string"},
        "role_card": {"type": ["object", "null"]},
        "model": {"type": ["string", "null"], "description": "declared by the submitter (not verified)"},
        "provider": {"type": ["string", "null"], "description": "declared by the submitter (not verified)"},
        "harness": {"type": ["string", "null"], "description": "declared by the submitter (not verified)"},
        "execution_profile": {"type": ["object", "null"], "description": "engine-owned: the execution profile pinned at dispatch (ADR-0010)"},
        "run": {"type": ["string", "null"], "description": "engine-owned: the harness run holding the presenting credential"},
        "credential": {"type": ["string", "null"], "description": "engine-owned: id of the presenting credential"}
      }
    },
    "created_at": {"type": "string"},
    "plan_revision": {
      "type": ["object", "null"],
      "properties": {"revision": {"type": "integer"}, "sha256": {"type": "string"}}
    },
    "evaluated_snapshot": {"$ref": "#/$defs/snapshot"},
    "method": {"type": "object"},
    "claim": {"type": "string"},
    "result": {"enum": ["pass", "fail", "inconclusive", "blocked"]},
    "coverage": {"$ref": "#/$defs/coverage", "description": "Engine-computed disclosure, not a gate or an authored claim. Optional on legacy records."},
    "evidence": {
      "type": "array",
      "items": {"type": "object", "required": ["path", "sha256"]}
    },
    "implementation": {
      "type": "object",
      "properties": {
        "files_changed": {"type": "array", "items": {"type": "string"}},
        "checks_run": {"type": "array", "items": {"type": "string"}},
        "deviations": {"type": "array", "items": {"type": "string"}},
        "unexpected_findings": {"type": "array", "items": {"type": "string"}},
        "self_review": {
          "type": "object",
          "required": ["completed"],
          "properties": {"completed": {"type": "boolean"}, "notes": {"type": ["string", "null"]}}
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["independence", "disposition", "findings"],
      "properties": {
        "independence": {"enum": ["R0", "R1", "R2", "R3"]},
        "specialty": {"type": ["string", "null"]},
        "disposition": {"enum": ["pass", "changes_required"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "resolved_findings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "required": ["scope", "claims"],
      "properties": {
        "scope": {"enum": ["ticket", "integration", "parent"]},
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "claim", "result"],
            "properties": {
              "type": {"enum": ["goal_backwards", "contract"]},
              "claim": {"type": "string"},
              "result": {"enum": ["pass", "fail", "inconclusive", "blocked"]},
              "checks": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "suspected_cause": {"type": ["string", "null"]}
      }
    },
    "attempt": {"type": "integer", "minimum": 1,
                "description": "engine-bound: the non-mutating Ticket attempt this record belongs to (ADR-0008)"},
    "subject": {
      "type": "object",
      "description": "engine-bound: the execute record a review/verification of a non-mutating Ticket evaluated",
      "required": ["id", "sha256"],
      "properties": {"id": {"type": "string"}, "sha256": {"type": "string"}}
    },
    "discovery": {
      "type": "object",
      "description": "Discovery Record (WC §9.3): observed facts with evidence, separated from hypotheses",
      "required": ["facts", "hypotheses", "unresolved_questions"],
      "properties": {
        "question": {"type": ["string", "null"]},
        "facts": {"type": "array", "items": {"type": "object", "required": ["statement", "evidence"],
                  "properties": {"statement": {"type": "string", "minLength": 1},
                                 "evidence": {"type": "array", "items": {"type": "string"}}}}},
        "hypotheses": {"type": "array", "items": {"type": "object", "required": ["statement"],
                       "properties": {"statement": {"type": "string", "minLength": 1},
                                      "confirm_by": {"type": ["string", "null"]}}}},
        "unresolved_questions": {"type": "array", "items": {"type": "string"}},
        "observed_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "research": {
      "type": "object",
      "description": "Research Record (WC §9.4): external conclusions with versions/sources and uncertainties",
      "required": ["conclusions", "subjects", "uncertainties"],
      "properties": {
        "question": {"type": ["string", "null"]},
        "conclusions": {"type": "array", "items": {"type": "string"}},
        "subjects": {"type": "array", "items": {"type": "object", "required": ["name", "source"],
                     "properties": {"name": {"type": "string"}, "version": {"type": ["string", "null"]},
                                    "source": {"type": "string"}}}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "uncertainties": {"type": "array", "items": {"type": "string"}}
      }
    },
    "proposal": {
      "type": "object",
      "description": "Plan proposal (WC §4.1 plan contract); the Markdown body is the proposed plan text",
      "required": ["objective", "approach"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "approach": {"type": "string", "minLength": 1},
        "governing_constraints": {"type": "array", "items": {"type": "string"}},
        "affected_components": {"type": "array", "items": {"type": "string"}},
        "ordered_tasks": {"type": "array", "items": {"type": "string"}},
        "required_tests": {"type": "array", "items": {"type": "string"}},
        "required_verification": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}},
        "rejected_alternatives": {"type": "array", "items": {"type": "string"}},
        "affected_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "assessment": {
      "type": "object",
      "description": "E160: a plan assessment (the reviewer archetype's challenge of an accepted plan revision): the requirements traced to the plan, the premises challenged, and findings. A gap in the trace, or a premise that fails, cites a finding of the same assessment (checked at submission)",
      "required": ["requirement_trace", "premises_challenged", "findings"],
      "additionalProperties": false,
      "properties": {
        "requirement_trace": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["requirement", "status"], "additionalProperties": false,
            "properties": {
              "requirement": {"type": "string", "minLength": 1, "description": "the requirement, by its id where it has one"},
              "status": {"enum": ["covered", "partial", "missing"], "description": "how far the plan meets it"},
              "plan_reference": {"type": ["string", "null"], "description": "where in the plan it is met"},
              "finding": {"type": ["string", "null"], "description": "the finding that records a partial or missing requirement"}
            }
          }
        },
        "premises_challenged": {
          "type": "array",
          "items": {
            "type": "object", "required": ["premise", "source", "challenge", "outcome"], "additionalProperties": false,
            "properties": {
              "premise": {"type": "string", "minLength": 1},
              "source": {"enum": ["plan", "request"], "description": "where it is relied on: the plan, or a factual premise stated in the request (EW-U04.i, with the U3 note on E160)"},
              "challenge": {"type": "string", "minLength": 1, "description": "how it was tested"},
              "outcome": {"enum": ["holds", "fails", "unverified"]},
              "evidence": {"type": "array", "items": {"type": "string"}},
              "finding": {"type": ["string", "null"], "description": "the finding that records a premise that fails"}
            }
          }
        },
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "check": {
      "type": "object",
      "required": ["check_id", "exit_code"],
      "properties": {
        "check_id": {"type": "string"},
        "exit_code": {"type": ["integer", "null"]},
        "outcome": {"enum": ["ran", "spawn_failed", "timeout"]},
        "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration_s": {"type": "number"},
        "mutated_inputs": {"type": "boolean"},
        "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$",
                              "description": "digest of the check definition that ran (command, cwd, timeout; for guardrails, its policy): a result proves only that definition"},
        "violations": {"type": "array"},
        "triggered_gates": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"producer": {"required": ["kind"], "properties": {"kind": {"const": "engine"}}}}},
      "then": {"properties": {"kind": {"const": "check_result"},
                              "producer": {"required": ["validation_run"], "not": {"required": ["role"]}}}},
      "else": {"properties": {"producer": {"required": ["role"]}}}
    },
    {
      "description": "E160: a plan assessment is the reviewer archetype's, carries its assessment, and is bound to the accepted plan revision and its sha256",
      "if": {"properties": {"kind": {"const": "plan_assessment"}}},
      "then": {"required": ["assessment", "plan_revision"],
               "properties": {"producer": {"properties": {"role": {"const": "reviewer"}}},
                              "plan_revision": {"type": "object", "required": ["revision", "sha256"],
                                                "properties": {"sha256": {"pattern": "^[0-9a-f]{64}$"}}}}}
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "description": "A finding of a review or a plan assessment (E160): one shape for both",
      "required": ["id", "severity", "summary", "required"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"enum": ["blocker", "major", "minor", "observation"]},
        "summary": {"type": "string"},
        "location": {"type": ["string", "null"]},
        "required": {"type": "boolean"}
      }
    },
    "coverage_inventory": {
      "oneOf": [
        {"type": "object", "required": ["known", "reason"], "additionalProperties": false,
         "properties": {"known": {"const": false}, "reason": {"type": "string", "minLength": 1}}},
        {"type": "object", "required": ["known", "source", "items"], "additionalProperties": false,
         "properties": {"known": {"const": true}, "source": {"type": "string", "minLength": 1},
                        "unit": {"type": "string", "minLength": 1},
                        "omitted": {"type": "integer", "minimum": 0},
                        "completed_by": {"type": "array", "uniqueItems": true,
                                         "items": {"type": "string", "minLength": 1}},
                        "observation_limit": {"type": "string", "minLength": 1},
                        "items": {"type": "array", "items": {
                          "type": "object", "required": ["name", "ran", "reasons"], "additionalProperties": false,
                          "properties": {"name": {"type": "string"}, "ran": {"type": "boolean"},
                                         "reasons": {"type": "array", "uniqueItems": true,
                                           "items": {"enum": ["not_configured", "not_run_in_this_validation",
                                                              "could_not_start", "not_completed"]}}},
                          "if": {"properties": {"ran": {"const": true}}},
                          "then": {"properties": {"reasons": {"maxItems": 0}}},
                          "else": {"properties": {"reasons": {"minItems": 1}}}
                        }}}}
      ]
    },
    "coverage": {
      "type": "object", "required": ["summary"],
      "description": "Scope is recorded execution (argv/cwd/definition/snapshot), never inferred semantic test coverage. A legacy disclosure may have only its summary.",
      "properties": {
        "schema": {"const": "aew/validation-coverage/v1"},
        "subject": {"type": "object"},
        "checks": {"type": "array", "items": {"type": "object",
          "required": ["check_id", "command", "cwd", "definition_sha256", "evaluated_snapshot", "result"],
          "properties": {"check_id": {"type": "string"}, "command": {"type": ["array", "null"], "items": {"type": "string"}},
                         "cwd": {"type": ["string", "null"]}, "definition_sha256": {"type": ["string", "null"]},
                         "evaluated_snapshot": {"type": ["object", "null"]}, "result": {"type": "string"}}}},
        "configured_not_run": {"type": "array", "items": {"type": "object",
          "required": ["check_id", "definition_sha256", "reason"]}},
        "changed_files": {"type": "object", "required": ["known"], "properties": {"known": {"type": "boolean"}}},
        "run_capabilities": {"type": "object", "additionalProperties": {"type": "object",
          "required": ["recorded", "tools_recorded", "skills_recorded", "missing_tools", "missing_skills"],
          "properties": {"recorded": {"type": "boolean"}, "tools_recorded": {"type": "boolean"},
                         "skills_recorded": {"type": "boolean"}, "missing_tools": {"type": "array"},
                         "missing_skills": {"type": "array"}}}},
        "affected_tests": {"$ref": "#/$defs/coverage_inventory"},
        "selection": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
                      "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}}},
        "ci_tools": {"$ref": "#/$defs/coverage_inventory"},
        "observation_limits": {"type": "array", "items": {"type": "string"}},
        "result": {"type": "string"},
        "summary": {"type": "object", "required": ["headline", "verdict", "known_gaps", "lines"],
          "properties": {"headline": {"type": "string"}, "verdict": {"type": "string"},
                         "known_gaps": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
                         "lines": {"type": "array", "items": {"type": "string"}}}}
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["base_revision", "workspace_id", "relevant_inputs_fingerprint"],
      "properties": {
        "base_revision": {"type": ["string", "null"]},
        "workspace_id": {"type": "string"},
        "relevant_inputs_fingerprint": {"type": "string"}
      }
    }
  }
}
