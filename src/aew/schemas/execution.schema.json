{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/execution/v1",
  "title": "Execution policy: which harness, provider, model and effort run an invocation",
  "description": "Model routing is policy, not architecture (WC §18). Resolved once at dispatch and pinned on the invocation (ADR-0010). With configured=false no invocation receives a policy-selected execution and harness launch is refused; there is no built-in provider or model. Only environment variable NAMES appear here, never values.",
  "type": "object",
  "required": ["schema", "configured", "profiles", "routing"],
  "additionalProperties": false,
  "properties": {
    "schema": {"x-aew-class": "operational", "const": "aew/execution/v1"},
    "configured": {"x-aew-class": "legality_affecting", "type": "boolean"},
    "harness": {"x-aew-class": "legality_affecting", "type": "string", "minLength": 1},
    "profiles": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/profile"}
    },
    "routing": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": false,
      "properties": {
        "default": {"x-aew-class": "legality_affecting", "oneOf": [{"$ref": "#/$defs/name"}, {"type": "null"}]},
        "archetypes": {"x-aew-class": "legality_affecting", "$ref": "#/$defs/route_map"},
        "classes": {
          "x-aew-class": "legality_affecting",
          "type": "object",
          "propertyNames": {"enum": ["0", "1", "2", "3", "4"]},
          "additionalProperties": {"$ref": "#/$defs/name"}
        },
        "cards": {"x-aew-class": "legality_affecting", "$ref": "#/$defs/route_map"}
      }
    },
    "provider_env": {
      "x-aew-class": "legality_affecting",
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "uniqueItems": true
    },
    "containment": {
      "type": "object",
      "description": "OS filesystem containment of harness runs (F2, Linux; ADR-0009 amendment). mode required (the default) refuses a launch whose sandbox cannot be established or fails its self-test; allow_weaker launches it labelled workdir_separation_only. writable adds existing directories every contained run may write (recorded on each run's label); a root that equals, contains or lies under what containment protects (the project's .aew, its git directories, the runs directory, /tmp, the Python environment, a masked secret) is refused at launch. hide masks further secret files or directories. trusted_git_drivers names the git filter, diff and merge drivers AEW's own git may run (an installed program agents cannot modify, such as git-lfs); every other configured driver, hook and fsmonitor is switched off, and a dispatch whose base assigns an untrusted filter is refused.",
      "additionalProperties": false,
      "properties": {
        "mode": {"x-aew-class": "legality_affecting", "enum": ["required", "allow_weaker"]},
        "writable": {"x-aew-class": "legality_affecting", "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "hide": {"x-aew-class": "legality_affecting", "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "trusted_git_drivers": {"x-aew-class": "legality_affecting", "type": "array", "items": {"type": "string", "pattern": "^[^\\s=]+$"}, "uniqueItems": true}
      }
    },
    "description": {"x-aew-class": "operational", "type": "string"}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "route_map": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/name"}
    },
    "profile": {
      "type": "object",
      "required": ["provider", "model"],
      "additionalProperties": false,
      "properties": {
        "harness": {"x-aew-class": "legality_affecting", "type": "string", "minLength": 1},
        "provider": {"x-aew-class": "legality_affecting", "type": "string", "minLength": 1, "pattern": "^[^/\\s]+$"},
        "model": {"x-aew-class": "legality_affecting", "type": "string", "minLength": 1, "pattern": "^\\S+$"},
        "effort": {"x-aew-class": "legality_affecting", "type": ["string", "null"], "pattern": "^[A-Za-z0-9._-]+$"},
        "max_steps": {"x-aew-class": "legality_affecting", "type": "integer", "minimum": 1},
        "deadline_s": {"x-aew-class": "operational", "type": "number", "exclusiveMinimum": 0},
        "description": {"x-aew-class": "operational", "type": "string"}
      }
    }
  }
}
