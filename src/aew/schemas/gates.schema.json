{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/gates/v1",
  "title": "Gate policy",
  "description": "Risk-class gate paths and integration policy (WC §7.5, §13). Gate names: accepted_plan, local_checks, self_review, review_r1, verification_goal_backwards, verification_contract, review_<trigger>. M2 adds execute_record (non-mutating) and children_complete (parents); see ADR-0007/0008.",
  "type": "object",
  "required": [
    "schema",
    "risk_paths",
    "local_checks",
    "post_integration"
  ],
  "properties": {
    "schema": {
      "const": "aew/gates/v1"
    },
    "mutating_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "local_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_paths": {
      "type": "object",
      "required": [
        "0",
        "1",
        "2",
        "3",
        "4"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "post_integration": {
      "type": "object",
      "required": [
        "verification",
        "checks"
      ],
      "properties": {
        "verification": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "waivable_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "waivable_finding_severities": {
      "type": "array",
      "items": {
        "enum": [
          "blocker",
          "major",
          "minor",
          "observation"
        ]
      }
    },
    "non_mutating_paths": {
      "type": "object",
      "required": [
        "0",
        "1",
        "2",
        "3",
        "4"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "gate paths for non-mutating Tickets (ADR-0008)"
    },
    "parent_paths": {
      "type": "object",
      "required": [
        "0",
        "1",
        "2",
        "3",
        "4"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "gate paths for Story/Epic closeout (ADR-0007)"
    },
    "history_audit": {
      "description": "ADR-0011 audit thresholds (implementation plan section 4): status reports the history audit's backlog against them. Each is optional; built-in defaults apply.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_unverified_entries": {"type": "integer", "minimum": 0},
        "max_unverified_age_hours": {"type": "number", "minimum": 0},
        "max_full_age_days": {"type": "number", "minimum": 0}
      }
    },
    "class0": {
      "description": "Class 0's bounded subject (M4-A amendment section 2): a scope is unbounded when a glob's first segment is `**`, or when it matches more than max_scope_files tracked files or (in a tree of at least fraction_min_tree_files tracked files) more than max_scope_fraction of them. Built-in defaults: 50 files, 0.25, 40.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_scope_files": {"type": "integer", "minimum": 1},
        "max_scope_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "fraction_min_tree_files": {"type": "integer", "minimum": 0}
      }
    },
    "non_mutating_concurrency": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "max_publish_paths": {
      "description": "The most paths one integration candidate may change (register E34). A publish syncs every changed path into the authoritative checkout while it holds the control lock, at a few milliseconds a path, so a larger change is refused at prepare, before anything is published. Default 2000.",
      "type": ["integer", "null"],
      "minimum": 1
    }
  }
}
