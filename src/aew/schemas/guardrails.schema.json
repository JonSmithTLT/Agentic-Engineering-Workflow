{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/guardrails/v1",
  "title": "Project guardrails",
  "description": "Human-readable, machine-queryable engineering guardrails (WC \u00a716.15, KC \u00a78.11). The AEW knowledge root is always protected regardless of this file.",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "x-aew-class": "legality_affecting",
      "const": "aew/guardrails/v1"
    },
    "protected_paths": {
      "x-aew-class": "legality_affecting",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_paths": {
      "x-aew-class": "legality_affecting",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ticket_scope_enforcement": {
      "x-aew-class": "legality_affecting",
      "type": "boolean"
    },
    "review_triggers": {
      "x-aew-class": "legality_affecting",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "paths"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "card": {
            "type": "string",
            "description": "Role card required when the trigger fires (policy-selected)"
          }
        }
      }
    },
    "dependency_rules": {
      "x-aew-class": "legality_affecting",
      "type": "array",
      "description": "Representable in M1; deterministic enforcement is Designed.",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "x-aew-class": "legality_affecting",
      "type": [
        "string",
        "null"
      ]
    }
  }
}
