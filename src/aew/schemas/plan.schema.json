{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/plan/v1",
  "title": "Plan revision frontmatter",
  "description": "Plan revisions are immutable once accepted (WC §9.6, KC §12.1). Acceptance status lives in control state, never in the file.",
  "type": "object",
  "required": ["schema", "work_unit", "revision", "created_at", "author"],
  "properties": {
    "schema": {"const": "aew/plan/v1"},
    "work_unit": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes": {"type": ["integer", "null"]},
    "reason": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "author": {"type": "object", "required": ["role"]},
    "affected_paths": {"type": "array", "items": {"type": "string"}}
  }
}
