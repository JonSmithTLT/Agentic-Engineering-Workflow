{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/report/v1",
  "title": "Lead report",
  "description": "A Lead-authored explanation, plan, or answer held apart from workflow evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "id", "title", "body", "generation", "created_at"],
  "properties": {
    "schema": {"const": "aew/report/v1"},
    "kind": {"const": "lead_report"},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "body": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
