{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/surface/v1",
  "title": "The typed Lead surface's result contract: StageResult, ActionProjection and the adapter input error",
  "description": "typed-lead-surface-design-v0.2 §3.3, with A3's policy binding (F15.1). Every object is closed. A StageResult always means the runner observed AEW state: revision and generation are never null. An adapter input error is never a StageResult.",
  "$ref": "#/$defs/stage_result",
  "$defs": {
    "operation_class": {"enum": ["MECHANICAL", "POLICY_RESOLVED", "JUDGMENT_BEARING"]},
    "availability": {"enum": ["AVAILABLE", "BLOCKED", "UNKNOWN"]},
    "kind": {"enum": ["query", "wait", "stage", "decision", "primitive"]},
    "argv": {"type": "array", "items": {"type": "string"}},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "details": {"type": "object"}
      }
    },
    "policy_binding": {
      "description": "A3: the digests a staged action is bound to. Null until F15.4 computes them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["legality_digest", "operational_digest", "authorization_digest"],
      "properties": {
        "legality_digest": {"$ref": "#/$defs/digest"},
        "operational_digest": {"$ref": "#/$defs/digest"},
        "authorization_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "operation_class", "revision", "summary", "refs"],
      "properties": {
        "primitive": {"type": "string", "minLength": 1},
        "operation_class": {"$ref": "#/$defs/operation_class"},
        "revision": {"type": ["integer", "null"], "minimum": 0},
        "summary": {"type": "string"},
        "refs": {"type": "array", "items": {"type": "string"}},
        "retried_after_stale_revision": {"type": "boolean"}
      }
    },
    "stopped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "boundary", "error"],
      "properties": {
        "at": {"type": "string", "minLength": 1},
        "boundary": {"enum": ["refused", "stale_revision", "stale_authority", "stale_policy", "permission",
                              "launch_failed", "not_found", "judgment_required", "unavailable", "error"]},
        "error": {"$ref": "#/$defs/error"}
      }
    },
    "action": {
      "description": "availability is legality only; callable is presentation (built and exposed on the caller's profile); auto_runnable means eligible for the stage runner to advance without judgment, never a query or a wait.",
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "kind", "arguments", "operation_class", "availability", "callable", "auto_runnable",
                   "reason_codes", "cli_fallback"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/kind"},
        "arguments": {"type": "object"},
        "operation_class": {"$ref": "#/$defs/operation_class"},
        "availability": {"$ref": "#/$defs/availability"},
        "callable": {"type": "boolean"},
        "auto_runnable": {"type": "boolean"},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "cli_fallback": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/argv"}]},
        "woken": {"const": true, "description": "On a wait: a broker posts wakes, so the readable next step is the turn's end."}
      },
      "allOf": [
        {"if": {"properties": {"auto_runnable": {"const": true}}, "required": ["auto_runnable"]},
         "then": {"properties": {"availability": {"const": "AVAILABLE"},
                                 "kind": {"enum": ["stage", "decision"]},
                                 "operation_class": {"enum": ["MECHANICAL", "POLICY_RESOLVED"]}}}}
      ]
    },
    "kept_stop": {
      "description": "Historical pre-E329 revision stop retained for reading older stage records.",
      "type": "object", "additionalProperties": false,
      "required": ["n", "boundary", "rev", "error"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "boundary": {"const": "stale_revision"},
        "rev": {"type": "integer", "minimum": 1},
        "error": {
          "type": "object", "additionalProperties": false, "required": ["code", "reason"],
          "properties": {"code": {"const": "STALE_REVISION"}, "reason": {"const": "resolve_stage"}}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "subject", "owner", "evidence", "tool", "arguments", "availability", "default",
                   "cli_fallback"],
      "properties": {
        "decision": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "owner": {"enum": ["lead", "operator"],
                  "description": "Whose decision it is (register E335): one owner per decision kind, from the table of primitive owners; one it does not state is the operator's."},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "tool": {"type": ["string", "null"]},
        "arguments": {"type": ["object", "null"]},
        "availability": {"$ref": "#/$defs/availability"},
        "default": {"const": "NONE"},
        "cli_fallback": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/argv"}]},
        "approval_options": {
          "description": "Arguments for the selected replacement, including the digest shown for that choice.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["subject", "choice", "replacement", "approval_digest"],
            "additionalProperties": false,
            "properties": {
              "subject": {"type": "string"},
              "choice": {"const": "replace_gate"},
              "replacement": {"type": "string"},
              "approval_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "stopped": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/kept_stop"}]},
        "judgment_inputs": {
          "description": "What the decision's call takes from its owner's judgment (register E388): each field the tool's schema requires that the arguments leave out: `resolve`'s choice with its options, and its rationale as its schema, for the decider to write. Filled in, the call has every field the schema requires; a choice can need more (follow_up its Ticket), which its refusal names. Absent when the arguments are whole.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "choice": {"type": "object", "required": ["options"], "additionalProperties": false,
                       "properties": {"options": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
            "rationale": {"description": "The tool's own schema of the field, for the decider to write.",
                          "type": "object", "required": ["type"], "additionalProperties": false,
                          "properties": {"type": {"const": "string"}, "description": {"type": "string"}}}
          }
        },
        "ask_operator": {"type": "string", "minLength": 1,
                         "description": "The operator's confirmation command, run at their own terminal, which a Lead session's call of the decision waits for (register E351)."}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "details": {"type": "object"}
      }
    },
    "run": {
      "description": "local run telemetry, never authority",
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "invocation", "work_unit", "role", "status", "reason", "evidence", "source",
                   "observed_at"],
      "properties": {
        "run": {"type": "string"},
        "invocation": {"type": "string"},
        "work_unit": {"type": "string"},
        "role": {"type": "string"},
        "status": {"type": "string"},
        "reason": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "source": {"const": "local_telemetry"},
        "observed_at": {"type": "string"}
      }
    },
    "coordination_attention": {
      "description": "Verified coordination data, never authority; local delivery receipts do not prune this view.",
      "type": "object", "additionalProperties": false,
      "required": ["awaiting_lead", "awaiting_worker", "omitted", "omitted_revs", "recovery", "integrity_errors"],
      "properties": {
        "awaiting_lead": {"type": "array", "maxItems": 20, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "sender", "kind", "in_reply_to", "refs", "created_at", "author",
                       "invocation", "work_unit", "run", "seq", "rendered"],
          "properties": {
            "id": {"type": "string"}, "sender": {"type": "string"}, "kind": {"type": "string"},
            "in_reply_to": {"type": ["string", "null"]},
            "refs": {"type": "array", "items": {"type": "string"}}, "created_at": {"type": "string"},
            "author": {"type": "string"},
            "invocation": {"type": "string"}, "work_unit": {"type": "string"},
            "run": {"type": ["string", "null"]}, "seq": {"type": "integer", "minimum": 1},
            "rendered": {"type": "string"}, "seal": {"type": "string"}
          }
        }},
        "awaiting_worker": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "invocation", "work_unit"],
          "properties": {"id": {"type": "string"}, "invocation": {"type": "string"},
                         "work_unit": {"type": "string"}}
        }},
        "omitted": {"type": "integer", "minimum": 0},
        "omitted_revs": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 2, "maxItems": 2,
                          "items": {"type": "integer", "minimum": 0}}]},
        "recovery": {"const": "aew message unseen"},
        "integrity_errors": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["invocation", "code"],
          "properties": {"invocation": {"type": "string"}, "code": {"type": "string"}}
        }}
      }
    },
    "action_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "generation", "subject", "state", "actions", "decisions_required", "blockers",
                   "anomalies", "hints", "runs"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "generation": {"type": "integer", "minimum": 0},
        "subject": {"type": "string", "minLength": 1},
        "state": {"type": ["string", "null"]},
        "unit": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {"parent": {"type": "string"}, "queue_state": {"type": "string"},
                         "scope_added": {"description": "the test paths the Lead added to the Ticket's scope on the record, each with its correction",
                                         "type": "array", "minItems": 1, "items": {"type": "string"}}}
        },
        "cli_fallback": {"type": "object", "additionalProperties": {"$ref": "#/$defs/argv"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "decisions_required": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
        "anomalies": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
        "hints": {"description": "reader-only prose; never parsed", "type": "array", "items": {"type": "string"}},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
        "coordination": {"$ref": "#/$defs/coordination_attention"},
        "reports": {
          "type": "object", "additionalProperties": false, "required": ["label", "items"],
          "properties": {
            "label": {"type": "string"},
            "items": {"type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "title"],
              "properties": {"id": {"type": "string"}, "title": {"type": "string"}}
            }}
          }
        }
      }
    },
    "stage_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "surface", "tool", "base_operation_class", "effective_operation_class", "revision",
                   "generation", "stage_intent_id", "policy_binding", "completed_steps", "stopped", "result",
                   "projection"],
      "properties": {
        "ok": {"type": "boolean"},
        "surface": {"const": "aew/surface/v1"},
        "tool": {"type": "string", "minLength": 1},
        "base_operation_class": {"$ref": "#/$defs/operation_class"},
        "effective_operation_class": {"$ref": "#/$defs/operation_class"},
        "revision": {"type": "integer", "minimum": 0},
        "generation": {"type": "integer", "minimum": 0},
        "stage_intent_id": {"type": ["string", "null"]},
        "policy_binding": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/policy_binding"}]},
        "completed_steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "stopped": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stopped"}]},
        "result": {"description": "the tool's own payload, as the engine returned it (scrubbed)",
                   "type": ["object", "null"]},
        "projection": {"$ref": "#/$defs/action_projection"}
      },
      "allOf": [
        {"if": {"properties": {"ok": {"const": true}}, "required": ["ok"]},
         "then": {"properties": {"stopped": {"type": "null"}}}},
        {"if": {"properties": {"ok": {"const": false}}, "required": ["ok"]},
         "then": {"properties": {"stopped": {"$ref": "#/$defs/stopped"}}}}
      ]
    },
    "adapter_input_error": {
      "description": "A transport-level input error: the call never reached the runner (or the broker could not be reached) and nothing committed. Never a StageResult.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": {"enum": ["INVALID_ARGUMENTS", "UNKNOWN_TOOL", "TOOL_NOT_BUILT", "TOOL_NOT_EXPOSED",
                          "BROKER_UNREACHABLE"]},
        "message": {"type": "string"},
        "details": {"type": "object"}
      }
    }
  }
}
