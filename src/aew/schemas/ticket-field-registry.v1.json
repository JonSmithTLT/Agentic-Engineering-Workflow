{
  "schema": "aew/ticket-field-registry/v1",
  "version": 1,
  "predecessor": null,
  "digest_prefix": "aew/tfg/v1",
  "canonicalization": "aew/tfg-canon/v1",
  "groups": {
    "acceptance": {"material": true, "description": "The objective and its acceptance: goal-backwards and contract statements, the record's free-text body and external references, and every unclassified input (fail closed, E19-B §2.3)"},
    "check_definition": {"material": true, "description": "The acceptance checks a Ticket names and the inputs they read"},
    "scope": {"material": true, "description": "The declared scope paths"},
    "gate_set": {"material": true, "description": "The class and gate obligations: the current and initial class, Class 0 assertions, and the effective class, floor and inherited mandatory gates derived from the ancestors"},
    "dependencies": {"material": true, "description": "The effective dependency edges, own and inherited (m4): only own edges are revisable"},
    "kind": {"material": true, "description": "The unit's kind and whether it mutates; never revised (a change of kind is a replacement)"},
    "parent": {"material": false, "description": "Where the unit sits in the hierarchy; never changed by a revision (plan §3.12). Its effect on obligations is hashed in gate_set and dependencies"},
    "card": {"material": false, "description": "Presentation metadata: the title (E19-B §2.3, §4.3)"},
    "staffing": {"material": false, "description": "The engine-defined role plan, changed only by work staff (ADR-0006)"}
  },
  "unassigned": "acceptance",
  "record": [
    {"field": "acceptance.goal_backwards", "group": "acceptance", "rule": "text_list"},
    {"field": "acceptance.contract", "group": "acceptance", "rule": "text_list"},
    {"field": "body", "group": "acceptance", "rule": "text", "note": "free text, so acceptance-bearing (fail closed)"},
    {"field": "external_refs", "group": "acceptance", "rule": "text_list", "note": "free text, so acceptance-bearing (fail closed)"},
    {"field": "acceptance.checks", "group": "check_definition", "rule": "exact", "note": "check ids"},
    {"field": "acceptance.inputs", "group": "check_definition", "rule": "exact", "note": "paths and globs"},
    {"field": "scope.paths", "group": "scope", "rule": "exact", "note": "paths and globs"},
    {"field": "class0_assertions", "group": "gate_set", "rule": "sorted_set", "note": "Class 0 eligibility is rechecked when they change"},
    {"field": "initial_risk_class", "group": "gate_set", "rule": "exact"},
    {"field": "policy", "group": "gate_set", "rule": "exact", "note": "a Story's or Epic's own obligations on its descendants; a Ticket's record has none"},
    {"field": "kind", "group": "kind", "rule": "exact"},
    {"field": "mutating", "group": "kind", "rule": "exact"},
    {"field": "parent", "group": "parent", "rule": "exact"},
    {"field": "promoted_from", "group": "parent", "rule": "exact"},
    {"field": "title", "group": "card", "rule": "text"}
  ],
  "control": [
    {"field": "risk_class", "group": "gate_set", "rule": "exact", "note": "raised only by work reclassify"},
    {"field": "policy", "group": "gate_set", "rule": "exact", "note": "a Story's or Epic's own obligations on its descendants; null on a Ticket"},
    {"field": "depends_on", "group": "dependencies", "rule": "via", "via": ["effective_edges"], "note": "the own edges, hashed with the inherited ones as one edge set"},
    {"field": "carried_obligations", "group": "gate_set", "also": ["dependencies"], "rule": "via", "via": ["effective_class", "class_floor", "inherited_mandatory_gates", "effective_edges"], "note": "plan §3.3 (V5): revision-governed, read only through the inherited-obligations accessor; written from S2b.2"},
    {"field": "kind", "group": "kind", "rule": "exact"},
    {"field": "mutating", "group": "kind", "rule": "exact"},
    {"field": "parent", "group": "parent", "rule": "exact"},
    {"field": "promoted_from", "group": "parent", "rule": "exact"},
    {"field": "title", "group": "card", "rule": "text"},
    {"field": "role_plan", "group": "staffing", "rule": "exact"}
  ],
  "derived": [
    {"field": "effective_class", "group": "gate_set", "rule": "exact"},
    {"field": "class_floor", "group": "gate_set", "rule": "exact"},
    {"field": "inherited_mandatory_gates", "group": "gate_set", "rule": "sorted_set"},
    {"field": "effective_edges", "group": "dependencies", "rule": "edge_set"}
  ],
  "provenance": ["schema", "id", "created_at", "created_by"],
