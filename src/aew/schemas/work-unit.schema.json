{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aew/work-unit/v1",
  "title": "Epic/Story/Ticket record frontmatter",
  "description": "Descriptive record (KC §9). Mutable control fields (state, current risk class, plan pointer) live in control state.",
  "type": "object",
  "required": ["schema", "id", "kind", "title", "created_at", "initial_risk_class", "mutating"],
  "properties": {
    "schema": {"const": "aew/work-unit/v1"},
    "id": {"type": "string", "pattern": "^[TSE]-[0-9]{4,}$"},
    "kind": {"enum": ["ticket", "story", "epic"]},
    "title": {"type": "string", "minLength": 1},
    "parent": {"type": ["string", "null"]},
    "promoted_from": {"type": ["string", "null"], "pattern": "^[TSE]-[0-9]{4,}$",
                      "description": "the unit this one was promoted from (KC §9.4); its identity and evidence are preserved"},
    "external_refs": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"},
    "created_by": {"type": "object"},
    "initial_risk_class": {"type": "integer", "minimum": 0, "maximum": 4},
    "mutating": {"type": "boolean"},
    "scope": {
      "type": "object",
      "properties": {"paths": {"type": "array", "items": {"type": "string"}}}
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "goal_backwards": {"type": "array", "items": {"type": "string"}},
        "contract": {"type": "array", "items": {"type": "string"}},
        "checks": {"type": "array", "items": {"type": "string"},
                   "description": "Project checks (policy/checks.yaml ids, or the builtin guardrails) that decide acceptance (M4-A)"},
        "inputs": {"type": "array", "items": {"type": "string"},
                   "description": "Paths or globs the acceptance checks read: fixtures, expected outputs, data (M4-A; plan assurance v0.4 §10)"}
      }
    },
    "class0_assertions": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["transformation_clear", "inputs_complete", "no_consequential_boundary"]},
      "description": "The Lead's recorded semantic assertions for Class 0 eligibility (WC amendment 2026-10-01)"
    },
    "policy": {
      "type": "object",
      "properties": {
        "mandatory_gates": {"type": "array", "items": {"type": "string"}},
        "min_descendant_class": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "rationale": {"type": ["string", "null"]}
      }
    }
  }
}
