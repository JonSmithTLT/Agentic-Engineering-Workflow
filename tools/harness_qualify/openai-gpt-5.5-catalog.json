{
  "openai": {
    "id": "openai",
    "name": "OpenAI",
    "env": [
      "OPENAI_API_KEY"
    ],
    "models": {
      "gpt-5.5": {
        "id": "gpt-5.5",
        "type": "chat",
        "name": "GPT-5.5",
        "description": "Default frontier GPT for coding, computer use, research, and knowledge work",
        "family": "gpt",
        "open_weights": false,
        "knowledge": "2025-12-01",
        "release_date": "2026-04-23",
        "last_updated": "2026-04-23",
        "modalities": {
          "input": [
            "text",
            "image/jpeg",
            "image/png",
            "image/gif",
            "image/webp",
            "application/pdf"
          ],
          "output": [
            "text"
          ]
        },
        "capabilities": {
          "tools": {
            "supported": true
          },
          "reasoning": {
            "supported": true,
            "effort": [
              "none",
              "low",
              "medium",
              "high",
              "xhigh"
            ]
          },
          "cache": {
            "implicit": {
              "ttl": [
                "24h"
              ],
              "min_tokens": 1024
            }
          },
          "structured_output": true,
          "temperature": true,
          "top_p": true,
          "top_k": false,
          "system_updates": true,
          "effort_updates": false,
          "store": true,
          "prompt_cache_key": true,
          "service_tier": [
            "flex",
            "priority"
          ]
        },
        "limit": {
          "context": 1050000,
          "input": 922000,
          "output": 128000
        },
        "cost": {
          "text": {
            "input": {
              "price": 5,
              "cache": {
                "read": 0.5
              },
              "overrides": [
                {
                  "when": {
                    "context": {
                      "gt": 272000
                    }
                  },
                  "price": 10,
                  "cache": {
                    "read": 1
                  }
                }
              ]
            },
            "output": {
              "price": 30,
              "overrides": [
                {
                  "when": {
                    "context": {
                      "gt": 272000
                    }
                  },
                  "price": 45
                }
              ]
            }
          },
          "web_search": {
            "price": 10
          },
          "multipliers": [
            {
              "when": {
                "service_tier": {
                  "equals": "priority"
                }
              },
              "factor": {
                "text": 2.5
              }
            },
            {
              "when": {
                "service_tier": {
                  "equals": "flex"
                }
              },
              "factor": {
                "text": 0.5
              }
            },
            {
              "when": {
                "not": {
                  "region": {
                    "equals": "global"
                  }
                }
              },
              "factor": {
                "text": 1.1
              }
            }
          ]
        },
        "api": {
          "responses": {
            "base_url": "https://api.openai.com/v1",
            "sdk": {
              "aisdk": "@ai-sdk/openai",
              "opencodeai": "@opencode/ai/providers/openai/responses"
            },
            "capabilities": {
              "tools": {
                "strict": true,
                "choice": [
                  "auto",
                  "none",
                  "required",
                  "tool"
                ],
                "search": true,
                "freeform": [
                  "text",
                  "lark",
                  "regex"
                ],
                "updates": true
              }
            }
          },
          "chat-completions": {
            "base_url": "https://api.openai.com/v1",
            "sdk": {
              "aisdk": "@ai-sdk/openai",
              "opencodeai": "@opencode/ai/providers/openai/chat"
            },
            "capabilities": {
              "tools": {
                "strict": true,
                "choice": [
                  "auto",
                  "none",
                  "required",
                  "tool"
                ],
                "freeform": [
                  "text",
                  "lark",
                  "regex"
                ],
                "updates": false
              }
            }
          }
        },
        "experimental": {
          "modes": {
            "fast": {
              "service_tier": "priority",
              "body": {
                "service_tier": "priority"
              }
            }
          }
        }
      }
    }
  }
}
