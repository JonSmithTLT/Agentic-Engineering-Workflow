                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "visibility_scope": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                }
              },
              "required": [
                "contract",
                "case",
                "record_id",
                "item_id",
                "kind",
                "role",
                "evidence_id",
                "source_id",
                "snapshot_id",
                "visibility_scope"
              ],
              "additionalProperties": false
            },
            "source_ids": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              }
            },
            "complete": {
              "type": "boolean"
            }
          },
          "required": [
            "reference_id",
            "origin",
            "source_ids",
            "complete"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "control_revision",
        "generated_at",
        "data"
      ],
      "additionalProperties": false
    },
