{
  "id": "journal-preview",
  "version": "0.1.0",
  "disposition": "PROVISIONAL",
  "routes": {
    "base": "/api/preview/journal/v0.1",
    "methods": [
      "GET",
      "HEAD"
    ],
    "collection": "/entries?limit=50",
    "detail": "/entries/{id}",
    "filters": [
      "component",
      "component_missing=1",
      "kind",
      "cursor",
      "case"
    ]
  },
  "ordering": [
    "published_at DESC",
    "id ASC",
    "null published_at: final Undated group, id ASC"
  ],
  "rules": [
    "Component identity and publication time are supplied; other timestamps never substitute.",
    "supporting_evidence and opposing_evidence define source roles only.",
    "Prompt metadata only; raw prompts are not supported.",
    "No retention explanation supplied when no explanation is supplied.",
    "Canonical decisions remain references to their authoritative records. “Included in context” references do not establish delivery, use, or benefit."
  ],
