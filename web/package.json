{
  "name": "@aew/read-only-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "generate:types": "openapi-typescript ../docs/design/dashboard-api-v1-provisional.yaml -o src/api/types.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build && node scripts/check-production.mjs",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "7.14.2",
    "@tanstack/react-query": "5.100.8",
    "zod": "4.4.2",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "25.6.0",
    "@vitejs/plugin-react": "6.0.1",
    "vite": "8.0.10",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "eslint": "9.39.4",
    "@eslint/js": "9.39.4",
    "typescript-eslint": "8.59.1",
    "vitest": "4.1.5",
    "jsdom": "29.1.1",
    "@testing-library/react": "16.3.2",
    "openapi-typescript": "7.13.0",
    "yaml": "2.8.3",
    "ajv": "6.15.0",
    "msw": "2.14.2",
    "playwright": "1.59.1",
    "@tailwindcss/vite": "4.2.4"
  }
}
