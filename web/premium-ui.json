{
  "profile": "product-admin",
  "sourceRoots": [
    "src"
  ],
  "locale": "en",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": [
    "Table Selection",
    "Select/Listbox",
    "Scrollbar",
    "Form",
    "Date"
  ],
  "ownership": {
    "Select/Listbox": "native",
    "Date": "typed"
  },
  "requiredCommands": [
    "typecheck",
    "lint",
    "unit",
    "build",
    "journalArtifacts",
    "evidenceArtifacts",
    "executionArtifacts"
  ],
  "commands": {
    "typecheck": "npm run typecheck",
    "lint": "npm run lint",
    "unit": "npm test",
    "build": "npm run build",
    "journalArtifacts": "node --experimental-strip-types scripts/journal-artifact.mjs",
    "evidenceArtifacts": "node --experimental-strip-types scripts/evidence-artifact.mjs",
    "executionArtifacts": "node --experimental-strip-types scripts/execution-artifact.mjs"
  },
  "evidence": {
    "failurePaths": "tests/evidence.test.ts",
    "keyboardAndResponsive": "scripts/browser-w05.mjs",
    "historySearchLifecycle": "tests/history-search.test.ts",
    "historySearchForm": "tests/history-search-page.test.tsx",
    "mapsReadPolicy": "tests/maps-page.test.tsx",
    "mapsPresentation": "tests/maps.test.ts"
  }
}
